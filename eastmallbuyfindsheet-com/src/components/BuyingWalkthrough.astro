---
import {buyingSteps, officialOrder} from '../lib/buying-help.mjs';
const {home = false} = Astro.props;
---
<section class:list={['buying-walkthrough', {'wrap home-section walkthrough-phones': home}]} aria-labelledby="walkthrough-heading">
  {home ? <h2 id="walkthrough-heading">How to buy on EastMallBuy</h2> : <h2 id="walkthrough-heading">From listing to shipment</h2>}
  <p class="walkthrough-lead">Follow the purchasing process using examples from our store and the official EastMallBuy shipping calculator.</p>
  <ol class="walkthrough-grid">
    {buyingSteps.map(({title, text, image, width, height, caption, arrows, label, href}, index) => (
      <li class="walkthrough-step">
        <figure>
          <a class="walkthrough-screen" href={href} target={href.startsWith('https:') ? '_blank' : undefined} rel={href.startsWith('https:') ? 'noopener' : undefined} aria-label={label}>
            <img src={image} alt={caption} loading="lazy" width={width} height={height} />
            <svg class="walkthrough-arrows" viewBox={`0 0 ${width} ${height}`} aria-hidden="true">
              <defs>
                <marker id={'guide-arrow-' + index} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="3.5" markerHeight="3.5" orient="auto">
                  <path d="M 0 0 L 10 5 L 0 10 Z" fill="#0b63d1" stroke="white" stroke-width=".6" />
                </marker>
              </defs>
              {arrows.map(([x1, y1, x2, y2]) => (
                <>
                  <line x1={x1} y1={y1} x2={x2} y2={y2} stroke="white" stroke-width="15" stroke-linecap="round" />
                  <line x1={x1} y1={y1} x2={x2} y2={y2} stroke="#0b63d1" stroke-width="9" stroke-linecap="round" marker-end={`url(#guide-arrow-${index})`} />
                </>
              ))}
            </svg>
          </a>
          {!home && <figcaption>{caption}</figcaption>}
        </figure>
        <div class="walkthrough-step-copy">
          <h3>{title}</h3>
          <p>{text}</p>
          <a class="section-link" href={href} target={href.startsWith('https:') ? '_blank' : undefined} rel={href.startsWith('https:') ? 'noopener' : undefined}>{label}</a>
        </div>
      </li>
    ))}
  </ol>
  <div class="actions">
    {home && <a class="button dark" href="/guides/how-to-buy/">Open the full buying guide</a>}
    <a class="button outline" href={officialOrder} target="_blank" rel="noopener">Official EastMallBuy ordering guide</a>
  </div>
</section>

<style>
  .walkthrough-phones .walkthrough-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: stretch;
    gap: clamp(8px, 1.7vw, 20px);
  }

  .walkthrough-phones .walkthrough-step {
    position: relative;
    padding: 30px 9px 10px;
    border: 5px solid var(--deep);
    border-radius: 24px;
  }

  .walkthrough-phones .walkthrough-step::before {
    position: absolute;
    inset: 7px auto auto 50%;
    width: 35px;
    height: 5px;
    transform: translateX(-50%);
    border-radius: 8px;
    background: var(--deep);
    content: '';
  }

  .walkthrough-step figure { margin: 0; }
  .walkthrough-screen { position: relative; display: block; background: var(--tint); }
  .walkthrough-screen img { display: block; width: 100%; height: auto; aspect-ratio: auto; }
  .walkthrough-arrows { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .walkthrough-phones figure { border: 1px solid var(--edge); border-radius: 8px; overflow: hidden; }
  .walkthrough-phones .walkthrough-screen { align-content: center; }

  .walkthrough-phones .walkthrough-step-copy { padding: 11px 4px 5px; }

  @media (max-width: 760px) {
    .walkthrough-phones .walkthrough-grid {
      grid-template-columns: repeat(4, 190px);
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-snap-type: inline proximity;
      scrollbar-width: thin;
      padding-block: 3px 8px;
    }

    .walkthrough-phones .walkthrough-step {
      padding: 18px 6px 6px;
      border-width: 3px;
      border-radius: 17px;
      scroll-snap-align: start;
    }

    .walkthrough-phones .walkthrough-step::before { inset-block-start: 5px; height: 4px; }
    .walkthrough-phones .walkthrough-step-copy { padding: 8px 2px 3px; }
    .walkthrough-phones .walkthrough-step h3 { font-size: .88rem; }
    .walkthrough-phones .walkthrough-step p { font-size: .81rem; line-height: 1.35; }
    .walkthrough-phones .walkthrough-step .section-link { font-size: .78rem; }
  }
  @media (max-width: 335px) {
    .walkthrough-phones .walkthrough-grid { grid-template-columns: repeat(4, 250px); }
  }
</style>
