---
import {languages} from '../lib/languages.mjs';
---
<details class="language-picker" id="site-language">
  <summary aria-label="Website language">
    <span aria-hidden="true">◎</span>
    <span data-current-language translate="no">English</span>
    <span class="language-chevron" aria-hidden="true"></span>
  </summary>
  <div class="language-options" role="group" aria-label="Choose a language">
    {languages.map(([code, label]) => (
      <button type="button" data-language={code} aria-pressed={code === 'en'} lang={code} translate="no">{label}</button>
    ))}
  </div>
</details>
<p id="language-status" class="visually-hidden" role="status"></p>
<script>
  import {languages} from '../lib/languages.mjs';
  import {navigationLabels} from '../lib/language-labels.mjs';

  const picker = document.querySelector<HTMLDetailsElement>('#site-language')!;
  const toggle = picker.querySelector('summary')!;
  const currentLabel = picker.querySelector('[data-current-language]')!;
  const buttons = [...picker.querySelectorAll<HTMLButtonElement>('[data-language]')];
  const status = document.querySelector('#language-status')!;
  const attributes = ['placeholder', 'aria-label', 'alt', 'title'];
  const ignored = 'script, style, noscript, [translate="no"], [data-reference-price]';
  const textOriginals = new WeakMap<Text, string>();
  const knownCodes = new Set(languages.map(([code]) => code));
  const storageKey = 'eastmallbuy-language';
  type Dictionary = Record<string, string>;
  let dictionary: Dictionary = {};
  let active = 'en';
  let requestId = 0;

  function translated(source: string) {
    const exact = dictionary[source] ?? (source === 'Upload image' ? dictionary['Choose a reference image'] : undefined);
    if (exact) return exact;
    if (source.startsWith('Buy on ') && dictionary['Buy on ZZ1ZZ']) {
      return dictionary['Buy on ZZ1ZZ'].replace('ZZ1ZZ', source.slice(7));
    }
    const parts: string[] = [];
    const template = source.replace(/\d+(?:,\d{3})*/g, (part) => {
      parts.push(part);
      return 'ZZ' + parts.length + 'ZZ';
    });
    if (!parts.length || !dictionary[template]) return source;
    return dictionary[template].replace(/ZZ(\d+)ZZ/g, (_, i) => parts[Number(i) - 1] ?? '');
  }

  function apply(root: Node) {
    if (root instanceof Element) {
      if (root.closest(ignored)) return;
      for (const name of attributes) {
        const value = root.getAttribute(name);
        if (!value?.trim()) continue;
        // Remember the visible English label alongside the translated attribute.
        const originalName = 'data-source-' + name;
        const original = root.getAttribute(originalName) ?? value;
        const replacement = translated(original.trim());
        if (replacement !== value) {
          root.setAttribute(originalName, original);
          root.setAttribute(name, replacement);
        }
      }
    }
    if (root instanceof Text) {
      if (root.parentElement?.closest(ignored)) return;
      const original = textOriginals.get(root) ?? root.data;
      if (!original.trim()) return;
      const next = original.replace(/\S(?:[\s\S]*\S)?/, (trimmed) => translated(trimmed.replace(/\s+/g, ' ')));
      if (next !== root.data) {
        textOriginals.set(root, original);
        root.data = next;
      }
    }
    for (const child of root.childNodes) apply(child);
  }

  async function setLanguage(code: string) {
    const id = ++requestId;
    try {
      let next = {};
      if (code !== 'en') {
        const response = await fetch('/data/languages/' + encodeURIComponent(code) + '.json');
        if (!response.ok) throw new Error('Translation unavailable');
        next = await response.json();
      }
      if (id !== requestId) return;
      dictionary = {...next, ...navigationLabels(code)};
      active = code;
      document.documentElement.lang = code;
      document.documentElement.dir = code === 'ar' ? 'rtl' : 'ltr';
      for (const button of buttons) {
        const selected = button.dataset.language === code;
        button.setAttribute('aria-pressed', String(selected));
        if (selected) currentLabel.textContent = button.textContent;
      }
      status.textContent = '';
      apply(document.querySelector('title')!);
      apply(document.body);
      try { localStorage.setItem(storageKey, code); } catch {}
    } catch {
      if (id === requestId) {
        status.textContent = 'Could not load that language. Please try again.';
      }
    }
  }

  new MutationObserver((changes) => {
    if (active === 'en') return;
    for (const change of changes) {
      for (const node of change.addedNodes) apply(node);
    }
  }).observe(document.body, {childList: true, subtree: true});

  for (const button of buttons) {
    button.addEventListener('click', () => {
      picker.open = false;
      toggle.focus();
      void setLanguage(button.dataset.language!);
    });
  }
  picker.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !picker.open) return;
    picker.open = false;
    toggle.focus();
  });
  document.addEventListener('click', (event) => {
    if (event.target instanceof Node && !picker.contains(event.target)) picker.open = false;
  });
  try {
    const stored = localStorage.getItem(storageKey);
    if (stored && knownCodes.has(stored) && stored !== 'en') void setLanguage(stored);
  } catch {}
</script>
<style>
  .language-picker { position: relative; z-index: 10; }
  summary {
    display: flex;
    align-items: center;
    gap: .42rem;
    min-height: 42px;
    padding: 5px 10px;
    border: 1px solid var(--control-border);
    border-radius: 8px;
    color: var(--ink);
    background: var(--surface);
    font-size: .84rem;
    font-weight: 720;
    list-style: none;
    white-space: nowrap;
    cursor: pointer;
  }
  summary::-webkit-details-marker { display: none; }
  .language-chevron {
    width: .42rem;
    height: .42rem;
    border: solid currentColor;
    border-width: 0 1px 1px 0;
    transform: translateY(-2px) rotate(45deg);
  }
  [open] .language-chevron { transform: translateY(1px) rotate(225deg); }
  .language-options {
    position: absolute;
    inset-block-start: calc(100% + 7px);
    inset-inline-end: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px;
    width: min(18.5rem, calc(100vw - 28px));
    max-height: min(22rem, 65dvh);
    overflow-y: auto;
    scrollbar-gutter: stable;
    padding: 7px;
    border: 1px solid var(--edge);
    border-radius: 11px;
    background: var(--surface);
    box-shadow: 0 10px 26px rgb(55 15 30 / 14%);
  }
  .language-options button {
    border: 0;
    border-radius: 6px;
    min-height: 42px;
    padding: 6px 10px;
    text-align: start;
    color: var(--ink);
    background: transparent;
    font-size: .84rem;
  }
  .language-options button:hover,
  .language-options button[aria-pressed="true"] {
    color: var(--brand);
    background: var(--tint);
  }
  @media (max-width: 720px) {
    summary { min-height: 34px; padding-inline: 7px; font-size: .74rem; }
    .language-options { width: min(15rem, calc(100vw - 28px)); }
  }
</style>
