---
import Layout from '../components/Layout.astro';
import QcFinder from '../components/QcFinder.astro';
---
<Layout title="EastMallBuy Image Search & QC Finder" page="image">
  <section class="wrap page">
    <p class="eyebrow">VISUAL PRODUCT SEARCH</p><h1>Image Search &amp; QC Finder</h1>
    <p class="lead">Pick a product photo to find visually similar listings in the saved Findspreadsheet image index. The search runs in your browser and keeps the photo on your device.</p>
    <a class="tool-jump" href="#qc-finder">Look up warehouse QC by link or item ID</a>
    <div class="upload">
      <label class="visually-hidden" for="image-file">Choose a reference image</label><input id="image-file" type="file" accept="image/*" />
      <button class="button outline" type="button" id="image-example">Try a sample photo</button>
      <img id="image-preview" alt="Search reference photo" hidden />
    </div>
    <p class="result-status" id="image-status" role="status">Choose an image to start.</p>
    <div class="product-grid" id="image-results"></div>
    <QcFinder />
  </section>
</Layout>
<script>
  import '../lib/image-search.mjs';
</script>
