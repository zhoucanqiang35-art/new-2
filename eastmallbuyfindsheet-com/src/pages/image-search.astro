---
import Layout from '../components/Layout.astro';
---
<Layout title="EastMallBuy Image Search" page="image">
  <section class="wrap page">
    <p class="eyebrow">VISUAL PRODUCT SEARCH</p><h1>Image Search</h1>
    <p class="lead">Pick a product photo to find visually similar listings in the saved Findspreadsheet image index. The search runs in your browser and keeps the photo on your device.</p>
    <div class="upload" id="image-upload">
      <label class="image-upload-control" for="image-file">
        <span class="upload-mark" aria-hidden="true">↑</span>
        <strong class="upload-title" id="upload-title">Upload image</strong>
        <span class="upload-hint" id="upload-hint">Click to choose a photo or drop one here.</span>
        <input id="image-file" type="file" accept="image/*" aria-labelledby="upload-title" aria-describedby="upload-hint" />
      </label>
      <button class="button outline" type="button" id="image-example">Try a sample photo</button>
      <img id="image-preview" alt="Search reference photo" hidden />
    </div>
    <p class="result-status" id="image-status" role="status">Choose an image to start.</p>
    <p id="image-download-progress" class="result-status" aria-hidden="true"></p>
    <div class="product-grid" id="image-results"></div>
  </section>
</Layout>
<script>
  if (location.hash === '#qc-finder' || new URLSearchParams(location.search).has('id')) {
    location.replace('/qc/' + location.search + '#qc-finder');
  } else {
    import('../lib/image-search.mjs');
  }
</script>
