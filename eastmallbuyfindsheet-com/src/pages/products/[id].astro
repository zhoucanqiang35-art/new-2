---
import {readFileSync} from 'node:fs';
import Layout from '../../components/Layout.astro';
import {storeCatalog as catalog} from '../../lib/store-catalog.mjs';
import {categoryLabel, productImage, purchaseUrl, sourceOrigin} from '../../lib/catalog.mjs';
import {categoryFinds, categoryLanding, indexedProductIds} from '../../lib/landing-paths.mjs';
import {priceFor} from '../../lib/shopping.mjs';

export function getStaticPaths() {
  const byId = new Map(catalog.map((product) => [product.weidianId, product]));
  const galleries = new Map();
  return indexedProductIds.map((id) => {
    const product = byId.get(id);
    if (!product) throw new Error('Missing indexed listing: ' + id);
    const prefix = id.slice(0, 4);
    if (!galleries.has(prefix)) {
      try {
        galleries.set(prefix, JSON.parse(readFileSync('public/data/gallery-' + prefix + '.json', 'utf8')));
      } catch (error) {
        if (error.code !== 'ENOENT') throw error;
        galleries.set(prefix, {});
      }
    }
    const photos = galleries.get(prefix)[id] ?? [];
    return {params: {id}, props: {product, photos}};
  });
}
const {product, photos} = Astro.props;
const id = product.weidianId;
const category = categoryLabel(product.category);
const categoryUrl = categoryLanding(product.category) || categoryFinds(product.category);
const price = priceFor(product.price);
const catalogPhotos = [...new Set([productImage(product), ...photos])];
const sourceUrl = new URL(product.sourcePath, sourceOrigin).href;
const description = product.name + ' on the EastMallBuy spreadsheet. Compare seller photos, reference price and ordering options for Weidian item ' + id + '.';
---
<Layout title={product.name + ' | EastMallBuy Spreadsheet'} description={description}>
  <section class="wrap page">
    <a href={categoryUrl}>Browse {category}</a>
    <div id="product-detail" data-item={id} data-listing={JSON.stringify({product, photos})}>
      <div class="detail-grid">
        <img src={productImage(product)} alt={product.name} class="detail-image" fetchpriority="high" />
        <div class="detail-copy">
          <p class="eyebrow">{category}</p>
          <h1 translate="no">{product.name}</h1>
          <p>Weidian item {id}</p>
          {price && <p class="detail-estimate"><strong class="reference-price" data-reference-price={product.price}>{price}</strong> estimated item price</p>}
          <div class="detail-buy">
            <a class="button dark" href={purchaseUrl(id)} rel="sponsored noopener" target="_blank">Buy on EastMallBuy</a>
          </div>
          <section class="detail-options" aria-labelledby="listing-photo-options">
            <div class="media-heading">
              <h2 id="listing-photo-options">Catalog photos</h2>
              <span class="detail-photo-count">{catalogPhotos.length} {catalogPhotos.length === 1 ? 'photo' : 'photos'}</span>
            </div>
            <div class="detail-photo-options" tabindex="0" role="group" aria-labelledby="listing-photo-options">
              {catalogPhotos.map((photo, index) => (
                <a href={photo} aria-label={'View catalog photo ' + (index + 1)} target="_blank" rel="noopener">
                  <img src={photo} width="74" height="74" alt="" loading="lazy" />
                </a>
              ))}
            </div>
          </section>
          <div class="detail-listing-links">
            <a href={sourceUrl}>View on Findspreadsheet</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
<script>
  import '../../lib/detail.mjs';
</script>
