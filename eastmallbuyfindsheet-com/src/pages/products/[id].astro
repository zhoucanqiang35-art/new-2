---
import {readFileSync} from 'node:fs';
import Layout from '../../components/Layout.astro';
import Card from '../../components/Card.astro';
import catalog from '../../../public/data/catalog.json';
import qc from '../../../public/data/qc-featured.json';
import {categoryLabel, originalUrl, productImage, sourceOrigin} from '../../lib/catalog.mjs';
import {categoryFinds, categoryLanding, indexedProductIds} from '../../lib/landing-paths.mjs';
import {categoryGuides} from '../../lib/category-guides.mjs';
import {priceFor, purchaseFor} from '../../lib/shopping.mjs';

export function getStaticPaths() {
  return indexedProductIds.map((id) => {
    const product = catalog.find((item) => item.weidianId === id);
    if (!product) throw new Error('Missing indexed listing: ' + id);
    const related = catalog.filter((item) => item.category === product.category && item.weidianId !== id && /^\d+$/.test(item.weidianId)).slice(0, 4);
    let photos = [];
    try {
      const url = 'public/data/gallery-' + id.slice(0, 4) + '.json';
      photos = JSON.parse(readFileSync(url, 'utf8'))[id] ?? [];
    } catch (error) {
      if (error.code !== 'ENOENT') throw error;
    }
    return {params: {id}, props: {product, related, photos}};
  });
}
const {product, related, photos} = Astro.props;
const id = product.weidianId;
const category = categoryLabel(product.category);
const categoryUrl = categoryLanding(product.category) || categoryFinds(product.category);
const price = priceFor(product.price);
const destination = purchaseFor('eastmallbuy', id, product.sourcePath);
const hasQc = qc[id]?.status === 'available';
const qcUrl = '/image-search/?id=' + id + '#qc-finder';
const sourceUrl = new URL(product.sourcePath, sourceOrigin).href;
const description = product.name + ' on the EastMallBuy spreadsheet. Compare seller photos, reference price and ordering options for Weidian item ' + id + '.';
---
<Layout title={product.name + ' | EastMallBuy Spreadsheet'} description={description}>
  <section class="wrap page">
    <a href={categoryUrl}>Browse {category}</a>
    <div id="product-detail" data-item={id} data-listing={JSON.stringify({product, related, photos})}>
      <div class="detail-grid">
        <img src={productImage(product)} alt={product.name} class="detail-image" fetchpriority="high" />
        <div class="detail-copy">
          <p class="eyebrow">{category}</p>
          <h1 translate="no">{product.name}</h1>
          <p>Weidian item {id}</p>
          {price && <p class="detail-estimate"><strong class="reference-price" data-reference-price={product.price}>{price}</strong> estimated item price</p>}
          <p><strong>Size check.</strong> Confirm the seller’s current size chart and selected variant.</p>
          <p><strong>QC status.</strong> <a href={qcUrl}>{hasQc ? 'Historical QC available' : 'Check for warehouse QC'}</a></p>
          <div class="actions">
            <a class="button dark" href={destination.url} rel={destination.sponsored ? 'sponsored noopener' : 'noopener'} target="_blank">{destination.name}</a>
            <a class="button outline" href={originalUrl(id)} target="_blank" rel="noopener">Original Weidian listing</a>
          </div>
          <p><a href={sourceUrl}>View on Findspreadsheet</a></p>
        </div>
      </div>
      {categoryGuides[product.category] && <section class="subsection"><h2>Size and measurements</h2><p>{categoryGuides[product.category].fit}</p></section>}
      <section class="subsection">
        <div class="section-title"><h2>More in {category}</h2><a href={categoryUrl}>Browse category</a></div>
        <div class="product-grid">{related.map((item) => <Card product={item} />)}</div>
      </section>
    </div>
  </section>
</Layout>
<script>
  import '../../lib/detail.mjs';
</script>
