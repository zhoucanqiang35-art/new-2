---
import Layout from '../components/Layout.astro';
import ProductSearch from '../components/ProductSearch.astro';
import {categories} from '../lib/catalog.mjs';
---
<Layout title="EastMallBuy Product Spreadsheet | Browse and Search" page="sheet">
  <section class="wrap page">
    <p class="eyebrow">PRODUCT DIRECTORY</p><h1>EastMallBuy Spreadsheet</h1>
    <p class="lead">Browse products from our Weidian store. Search by name or paste a Weidian item link. The directory shows estimated item prices. Confirm the current price and availability with your selected agent.</p>
    <form id="filters" class="filter-bar" action="/spreadsheet/">
      <ProductSearch id="query" />
      <label class="visually-hidden" for="category">Category</label><select id="category" name="category"><option value="">All categories</option>{Object.entries(categories).map(([key, label]) => <option value={key}>{label}</option>)}</select>
      <label class="visually-hidden" for="sort">Sort</label><select id="sort" name="sort"><option value="latest">Latest in snapshot</option><option value="oldest">Oldest in snapshot</option><option value="price-low">Price low to high</option><option value="price-high">Price high to low</option></select>
      <button class="button dark" type="submit">Search</button>
    </form>
    <p class="result-status" id="catalog-status" role="status">Loading the saved directory…</p>
    <div id="catalog-results" class="product-grid"></div>
    <nav class="pagination" aria-label="Product pages" id="pagination" hidden>
      <button type="button" id="prev" class="button outline">Previous</button><span id="page-label"></span><button type="button" id="next" class="button outline">Next</button>
    </nav>
  </section>
</Layout>
<script>
  import '../lib/directory.mjs';
</script>
<style>[hidden]{display:none}</style>
