---
import { categoryKeys } from "../lib/locale-controls.js";
const entries = [
  ['shoes', 'Shoes', 'M3 15c3 0 4-4 5-7l4 1 2 4 6 2c1 .3 2 1 2 3v1H3a1 1 0 0 1-1-1v-1c0-1 .4-2 1-2Zm0 2h18'],
  ['hoodies-sweaters', 'Hoodies & knits', 'M8 7c0-3 2-5 4-5s4 2 4 5l5 4-2 5-3-2v8H8v-8l-3 2-2-5 5-4Zm0 0 4 3 4-3M9 18h6'],
  ['t-shirts', 'T-shirts', 'm8 4-5 3 2 5 3-1v9h8v-9l3 1 2-5-5-3c0 2-2 3-4 3S8 6 8 4Z'],
  ['jackets', 'Jackets', 'm9 3-4 3-3 12 4 2 2-7v8h8v-8l2 7 4-2-3-12-4-3H9Zm3 2v15M9 3l3 5 3-5'],
  ['pants-shorts', 'Pants & shorts', 'M6 3h12l2 18h-6l-2-10-2 10H4L6 3Zm0 4h12'],
  ['headwear', 'Headwear', 'M4 14a8 8 0 0 1 16 0v2H4v-2Zm16 2 2 2-2 2H4l-2-2 2-2m8-10v8'],
  ['accessories', 'Accessories', 'M4 9h16l1 12H3L4 9Zm5 2V6a3 3 0 1 1 6 0v5'],
  ['jersey', 'Jerseys', 'm8 4-5 3 2 5 3-1v9h8v-9l3 1 2-5-5-3-4 3-4-3Zm3 7h2l-2 5'],
  ['ShortSets', 'Short sets', 'M4 4h16l1 15h-6l-3-6-3 6H3L4 4Zm0 4h16'],
  ['electronics', 'Electronics', 'M3 5h18v12H3zM9 21h6m-3-4v4M6 8h3'],
  ['other-stuff', 'Other finds', 'M3 7h18v14H3zM2 3h20v4H2zM9 11h6'],
  ['', 'All finds', 'M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z']
];
---
<div class="category-grid">
  {entries.map(([slug,label,shape]) => (
    <a href={slug ? '/spreadsheet/?category=' + slug : '/spreadsheet/'} class="category-tile">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={shape}/></svg>
      <span data-t={categoryKeys[slug]}>{label}</span>
    </a>
  ))}
</div>
