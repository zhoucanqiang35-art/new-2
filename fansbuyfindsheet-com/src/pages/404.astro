---
import Site from '../layouts/Site.astro';
---
<Site noindex title="Page Not Found | Fansbuy Findsheet" description="Return to the Fansbuy spreadsheet to browse or search product listings.">
  <section class="shell section">
    <h1>Page not found</h1>
    <p>Browse the spreadsheet or upload a photo to find a product.</p>
    <div class="actions">
      <a class="button" href="/spreadsheet/">Open the spreadsheet</a>
      <a class="button secondary" href="/image-search/">Image Search</a>
    </div>
  </section>
</Site>
