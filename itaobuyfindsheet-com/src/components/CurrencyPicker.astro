---
import { asOf, rates, source } from '../lib/currency.js';

const names = new Intl.DisplayNames('en', { type: 'currency' });
const options = Object.keys(rates).map((code) => [code, names.of(code)]);
const date = new Intl.DateTimeFormat('en', { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(asOf + 'T00:00:00Z'));
---
<details class="currency-picker" data-currency-picker>
  <summary class="button currency-toggle" aria-label="Price currency" data-i18n-aria="priceCurrency">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M15 8.5h-4.3a2 2 0 0 0 0 4H13a2 2 0 0 1 0 4H9m3-10v12"/></svg>
    <span data-currency-indicator>USD</span>
  </summary>
  <div class="currency-panel" dir="ltr">
    <p class="currency-heading" data-i18n="priceCurrency">Price currency</p>
    <div class="currency-grid" role="group" tabindex="0" aria-label="Price currency" data-i18n-aria="priceCurrency">
      {options.map(([code, name]) => <button type="button" data-currency-option={code} aria-pressed={code === 'USD' ? 'true' : 'false'} aria-label={name} title={name}>{code}</button>)}
    </div>
    <p class="currency-note"><a href={source} target="_blank" rel="noopener">ECB rates</a> · <time datetime={asOf}>{date}</time><br /><span>USD estimated from iTaoBuy prices. See checkout for the final amount.</span></p>
  </div>
</details>
<script>
  import { formatMoney, rates } from '../lib/currency.js';

  const picker = document.querySelector<HTMLDetailsElement>('[data-currency-picker]')!;
  const trigger = picker.querySelector('summary')!;
  const indicator = picker.querySelector<HTMLElement>('[data-currency-indicator]')!;
  const options = picker.querySelectorAll<HTMLButtonElement>('[data-currency-option]');

  function changeCurrency(code: string) {
    document.documentElement.dataset.currency = code;
    indicator.textContent = code;
    for (const item of document.querySelectorAll<HTMLElement>('[data-cny-price]')) {
      item.textContent = formatMoney(Number(item.dataset.cnyPrice), code);
    }
    for (const unit of document.querySelectorAll('[data-price-unit]')) unit.textContent = code;
    for (const button of options) button.setAttribute('aria-pressed', String(button.dataset.currencyOption === code));
  }

  let initial = 'USD';
  try {
    const stored = localStorage.getItem('itaobuy-display-currency');
    if (stored && Object.hasOwn(rates, stored)) initial = stored;
  } catch {}
  changeCurrency(initial);

  for (const button of options) button.addEventListener('click', () => {
    const code = button.dataset.currencyOption!;
    try { localStorage.setItem('itaobuy-display-currency', code); } catch {}
    changeCurrency(code);
    picker.open = false;
    trigger.focus();
  });
  document.addEventListener('click', (event) => {
    if (picker.open && !picker.contains(event.target as Node)) picker.open = false;
  });
  picker.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !picker.open) return;
    picker.open = false;
    trigger.focus();
  });
</script>
