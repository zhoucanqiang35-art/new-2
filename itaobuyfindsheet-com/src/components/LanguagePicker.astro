---
import { languages } from '../lib/languages.js';
---
<details class="language-picker" data-language-picker>
  <summary class="button language-toggle" aria-label="Language" data-i18n-aria="language">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18Z"/></svg>
    <span data-current-language>EN</span>
  </summary>
  <div class="language-panel" dir="ltr">
    <p data-i18n="language">Language</p>
    <div class="language-grid" tabindex="0" data-i18n-aria="language" aria-label="Language">
      {languages.map(([code, , native]) => <button type="button" data-language={code} lang={code} aria-label={native} title={native} aria-pressed={code === 'en' ? 'true' : 'false'}>{native}</button>)}
    </div>
  </div>
</details>
<script>
  import { languages, setLanguage, readLanguage } from '../lib/languages.js';

  const picker = document.querySelector<HTMLDetailsElement>('[data-language-picker]')!;
  const indicator = picker.querySelector<HTMLElement>('[data-current-language]')!;
  const buttons = picker.querySelectorAll<HTMLButtonElement>('[data-language]');
  const toggle = picker.querySelector('summary')!;

  function update(code: string) {
    setLanguage(code);
    indicator.textContent = languages.find(([locale]) => locale === code)?.[1] ?? 'EN';
    for (const button of buttons) button.setAttribute('aria-pressed', String(button.dataset.language === code));
  }

  update(readLanguage());
  for (const button of buttons) button.addEventListener('click', () => {
    update(button.dataset.language!);
    picker.open = false;
    toggle.focus();
  });
  document.addEventListener('click', (event) => {
    if (picker.open && !picker.contains(event.target as Node)) picker.open = false;
  });
  picker.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !picker.open) return;
    picker.open = false;
    toggle.focus();
  });
</script>
