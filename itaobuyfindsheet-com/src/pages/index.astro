---
import Shell from '../components/Shell.astro';
import Icon from '../components/Icon.astro';
import ProductCard from '../components/ProductCard.astro';
import SearchExamples from '../components/SearchExamples.astro';
import { faqSections } from '../lib/faq.js';
import homeMerchandise from '../data/home-merchandise.json';
import { categories, number, total, qcCount } from '../lib/catalog.js';

const selected = categories.filter((category) => category.feature);
const questions = [
  faqSections[0].questions[0],
  faqSections[0].questions[3],
  faqSections[1].questions[0],
  faqSections[2].questions[2],
  faqSections[3].questions[0],
  faqSections[4].questions[0],
];
---
<Shell title="iTaoBuy Spreadsheet | Weidian Finds, Product Links & QC Photos" description="Browse iTaoBuy finds on the Findspreadsheet catalog. Search Weidian product links or photos, compare seller images and available QC, and learn how to buy through iTaoBuy.">
  <section class="wrap hero">
    <div class="hero-content">
      <p class="eyebrow"><span></span> Independent Findspreadsheet directory</p>
      <h1>iTaoBuy<br /><em data-i18n="sheet">Spreadsheet</em></h1>
      <p class="hero-copy" data-i18n="heroCopy">Find products across Weidian, look through seller photos and available warehouse QC, then open the matching listing on iTaoBuy.</p>
      <form class="hero-search" action="/spreadsheet/" role="search">
        <label class="visually-hidden" for="home-query">Product name or Weidian ID</label>
        <Icon name="search" />
        <input id="home-query" name="q" type="search" list="product-search-examples" placeholder="Try sneakers or a Weidian item ID" data-i18n-placeholder="homeSearchHint" />
        <button class="button button-primary" type="submit" data-i18n="search">Search</button>
      </form>
      <SearchExamples />
      <div class="hero-links">
        <a href="/image-search/"><Icon name="camera" size={18} /> <span data-i18n="imageSearch">Search by image</span></a>
        <a href="/qc/"><Icon name="check" size={18} /> <span data-i18n="findQc">Find QC photos</span></a>
      </div>
    </div>
    <div class="hero-stats">
      <span><Icon name="box" /> <strong>{number.format(total)}</strong> preview finds</span>
      <span><Icon name="tag" /> <strong>{categories.length}</strong> categories</span>
      <span><Icon name="check" /> <strong>{qcCount}</strong> sample listing with QC</span>
    </div>
  </section>

  <section class="wrap section">
    <div class="section-heading"><h2 data-i18n="browseCategory">Browse by category</h2><a class="text-link" href="/spreadsheet/" data-i18n="fullSheet">Full spreadsheet</a></div>
    <div class="category-grid">
      {selected.map((category) => <a class="category-card" href={'/categories/' + category.id + '/'}>
        <img src={homeMerchandise.categoryImages[category.id]} alt="" width="128" height="104" loading="lazy" />
        <strong>{category.label}</strong>
        <span>{number.format(category.count)} finds</span>
      </a>)}
    </div>
  </section>

  <section class="wrap section">
    <div class="section-heading"><h2 data-i18n="featured">Featured finds</h2><a class="text-link" href="/spreadsheet/" data-i18n="browseAll">Browse all finds</a></div>
    <div class="product-grid">
      {homeMerchandise.featured.map((product) => <ProductCard product={product} category={categories.find((category) => category.id === product.category)?.label} />)}
    </div>
  </section>

  <section class="wrap section">
    <div class="guide-panel">
      <div class="guide-icon"><Icon name="box" size={34} /></div>
      <div><h2 data-i18n="ordering">Ordering through iTaoBuy</h2><p>Check the seller listing, verify size and colour, and understand how warehouse QC and international shipping fit into your order.</p></div>
      <a class="button button-primary" href="/guides/how-to-buy/" data-i18n="guide">Read the buying guide</a>
    </div>
  </section>
  <section class="wrap section home-faq" aria-labelledby="home-faq-heading">
    <div class="section-heading">
      <h2 id="home-faq-heading">iTaoBuy Spreadsheet FAQ</h2>
      <a class="text-link" href="/faq/">View all 25 questions</a>
    </div>
    <dl>
      {questions.map(([question, answer]) => <div>
        <dt>{question}</dt>
        <dd>{answer}</dd>
      </div>)}
    </dl>
  </section>
</Shell>
