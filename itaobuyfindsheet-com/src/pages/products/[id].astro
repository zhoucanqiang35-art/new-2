---
import { existsSync } from 'node:fs';
import Shell from '../../components/Shell.astro';
import { buyUrl, categories, formatPrice, sourceUrl } from '../../lib/catalog.js';
import { sortVariantGroups, variantTitle } from '../../lib/variants.js';
import catalog from '../../../public/data/catalog.json';
import galleries from '../../data/galleries.json';
import sellerGalleries from '../../data/seller-galleries.json';
import variants from '../../data/variants.json';
import qc from '../../../public/data/qc.json';

export function getStaticPaths() {
  return catalog.map((product) => ({ params: { id: product.id }, props: { product } }));
}

const { product } = Astro.props;
const storedGallery = sellerGalleries[product.id];
const gallery = storedGallery ?? [product.image];
const coverFile = '/product-covers/' + product.id + '.webp';
const cover = !storedGallery && existsSync('public' + coverFile)
  ? coverFile
  : gallery[0];
const thumbnailUrl = (url) => /^\/(seller-gallery|sku)\//.test(url)
  ? '/product-thumbs' + url.replace(/\.gif$/, '.webp')
  : url;
const catalogPhotos = galleries[product.id] ?? [product.image];
const galleryDetails = [...new Set(catalogPhotos.slice(product.image.startsWith('/featured/') ? 2 : 1))];
const category = categories.find((item) => item.id === product.category);
const records = qc[product.id]?.items ?? [];
const original = sourceUrl(product);
const options = sortVariantGroups(variants[product.id] ?? []);
const findspreadsheet = 'https://findspreadsheet.com' + product.mainPath;

---
<Shell title={product.name + ' | iTaoBuy Spreadsheet'} description={'Compare the seller photos, Weidian listing and available warehouse QC for ' + product.name + '.'}>
  {!storedGallery && <link slot="head" rel="preconnect" href="https://findspreadsheet.com" />}
  <div class="wrap inner-page product-page" data-product={product.id}>
    <p class="breadcrumbs"><a href="/" data-i18n="home">Home</a> / <a href="/spreadsheet/" data-i18n="sheet">Spreadsheet</a>{category && <> / <a href={'/categories/' + category.id + '/'}>{category.label}</a></>}</p>
    <div class="detail-grid">
      <section class="gallery" aria-label="Product photos" data-gallery data-cached-gallery={storedGallery ? 'true' : undefined}>
        <a class="gallery-frame" data-current-link href={gallery[0]} target="_blank" rel="noopener">
          <img data-current src={cover} alt={product.name + ' seller photo 1'} width="620" height="620" fetchpriority="high" referrerpolicy="no-referrer" />
        </a>
        <div class="gallery-strip" data-gallery-strip role="group" aria-label="Choose a seller photo">
          {gallery.map((src, index) => <button type="button" data-gallery-photo={index === 0 ? cover : src} data-gallery-original={src} data-alt={product.name + ' seller photo ' + (index + 1)} aria-label={'Show photo ' + (index + 1)} aria-pressed={index === 0 ? 'true' : 'false'}><img src={storedGallery ? thumbnailUrl(src) : cover} alt="" width="92" height="92" loading="lazy" decoding="async" fetchpriority="low" referrerpolicy="no-referrer" /></button>)}
        </div>
      </section>

      <section class="detail-info">
        <h1>{product.name}</h1>
        <p class="item-id"><span data-i18n="itemId">Item ID</span> <bdi>{product.id}</bdi></p>
        {product.price !== null ? <div class="detail-price"><bdi data-cny-price={product.price}>{formatPrice(product.price)}</bdi><span data-price-unit>USD</span></div> : <p class="muted price-note">Check the current price on iTaoBuy.</p>}
        <a class="button button-primary buy" href={buyUrl(product)} target="_blank" rel="noopener" data-i18n="buy">Buy on iTaoBuy</a>

        <div class="purchase-actions">
          <div class="other-agents">
            <button class="button other-agents-toggle" type="button" aria-expanded="false" aria-controls="other-agent-panel">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 8h14l1 12H4L5 8Z"/><path d="M9 10V7a3 3 0 0 1 6 0v3"/></svg>
              <span data-i18n="otherAgents">Other purchasing platforms</span>
            </button>
            <div class="other-agent-panel" id="other-agent-panel" aria-labelledby="other-agent-heading" hidden>
              <p id="other-agent-heading" data-i18n="otherAgents">Other purchasing platforms</p>
              <ul class="other-agent-links"></ul>
            </div>
          </div>
          <button class="button" type="button" data-copy={original} data-i18n="copy">Copy product link</button>
        </div>
        <p class="copy-feedback" role="status" data-copy-status></p>
        <input type="text" readonly hidden data-copy-fallback aria-label="Original Weidian listing link" value={original} />

        <div class="sku-groups" data-sku-groups hidden={!options.length}>
          {options.map((group) => {
            const [title, key] = variantTitle(group.title);
            const imageOptions = group.options.some((option) => option.image);
            return <fieldset class="sku-group" data-sku-group>
              <legend data-i18n={key}>{title}</legend>
              <div class:list={['sku-options', { 'sku-photos': imageOptions }]}>
                {group.options.map((option) => <button type="button" data-option data-variant-image={option.image} data-alt={option.label} aria-pressed="false" aria-label={option.label} title={option.label}>
                  {option.image ? <img src={thumbnailUrl(option.image)} alt="" width="58" height="58" loading="lazy" decoding="async" fetchpriority="low" referrerpolicy="no-referrer" /> : option.label}
                </button>)}
              </div>
            </fieldset>;
          })}
        </div>
        <p class="muted sku-empty" data-sku-status role="status" hidden={options.length > 0}>Loading seller colors and sizes…</p>
        <noscript><p><a href={buyUrl(product)}>Check available options on iTaoBuy</a></p></noscript>
        <template data-sku-template>
          <fieldset class="sku-group" data-sku-group>
            <legend></legend>
            <div class="sku-options"></div>
          </fieldset>
        </template>

      </section>
    </div>

    {galleryDetails.length > 0 && <section class="detail-qc" aria-label="Detail photos">
      <div class="section-heading"><h2 data-i18n="detailPhotos">Detail photos</h2><span class="muted small" data-i18n="sellerPhotos">Seller photos</span></div>
      <div class="qc-grid">{galleryDetails.map((image, index) => <a href={image} target="_blank" rel="noopener"><img src={image} alt={'Seller detail photo ' + (index + 1)} width="230" height="230" loading="lazy" decoding="async" fetchpriority="low" /></a>)}</div>
    </section>}
    <section class="detail-qc">
      <div class="section-heading"><h2 data-i18n="warehousePhotos">Warehouse QC photos</h2><a class="text-link" href={'/qc/?item=' + product.id} data-i18n="openQc">Open QC finder</a></div>
      {records.length > 0 ? <>
        <p class="muted">Reference warehouse photos for this exact Weidian item, sourced through Findspreadsheet.</p>
        <div class="qc-grid">{records.map(({image}, i) => <a href={image} target="_blank" rel="noopener"><img src={image} alt={'Warehouse QC photo ' + (i + 1)} width="230" height="230" loading="lazy" decoding="async" fetchpriority="low" /></a>)}</div>
      </> : <p class="muted">{product.id === '7866625981' ? 'Findspreadsheet returned no warehouse QC photos for this item when checked.' : 'Warehouse QC for this item has not been checked in the preview. Visit the Findspreadsheet item page to check availability.'}</p>}
      <div class="product-sources">
        <a href={original} target="_blank" rel="noopener" data-i18n="originalWeidian">Original Weidian listing</a>
        <a href={findspreadsheet} target="_blank" rel="noopener" data-i18n="viewOnFindspreadsheet">View on Findspreadsheet</a>
      </div>
    </section>
  </div>
</Shell>
<script>
  import { alternativeAgents } from '../../lib/agents.js';
  import { translate } from '../../lib/languages.js';
  import { fetchSellerProduct, variantTitle } from '../../lib/variants.js';

  const page = document.querySelector<HTMLElement>('[data-product]')!;
  const gallery = page.querySelector<HTMLElement>('[data-gallery]')!;
  const strip = gallery.querySelector<HTMLElement>('[data-gallery-strip]')!;
  const image = gallery.querySelector<HTMLImageElement>('[data-current]')!;
  const link = gallery.querySelector<HTMLAnchorElement>('[data-current-link]')!;
  const productName = page.querySelector('h1')!.textContent!.trim();
  let variantSelected = false;
  let photoRequest = 0;

  async function showPhoto(url: string, alt: string, thumbnail: HTMLButtonElement | null, original = url, priority: 'high' | 'low' = 'high') {
    const request = ++photoRequest;
    if (url !== image.getAttribute('src')) {
      const preview = new Image();
      preview.referrerPolicy = 'no-referrer';
      preview.fetchPriority = priority;
      preview.src = url;
      try {
        await preview.decode();
      } catch {
        return;
      }
      if (request !== photoRequest) return;
    }
    image.src = url;
    image.alt = alt;
    link.href = original;
    for (const option of strip.querySelectorAll('[data-gallery-photo]')) {
      option.setAttribute('aria-pressed', String(option === thumbnail));
    }
  }

  strip.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const thumbnail = event.target.closest<HTMLButtonElement>('[data-gallery-photo]');
    if (!thumbnail) return;
    variantSelected = false;
    void showPhoto(thumbnail.dataset.galleryPhoto!, thumbnail.dataset.alt!, thumbnail, thumbnail.dataset.galleryOriginal);
  });

  strip.addEventListener('error', (event) => {
    if (!(event.target instanceof HTMLImageElement)) return;
    const thumbnail = event.target.closest<HTMLButtonElement>('[data-gallery-photo]');
    if (thumbnail) thumbnail.hidden = true;
  }, true);

  function renderSellerGallery(photos: string[]) {
    const buttons = photos.map((url, index) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.dataset.galleryPhoto = url;
      button.dataset.alt = productName + ' seller photo ' + (index + 1);
      button.setAttribute('aria-label', 'Show photo ' + (index + 1));
      button.setAttribute('aria-pressed', 'false');
      const thumbnail = document.createElement('img');
      thumbnail.alt = '';
      thumbnail.width = thumbnail.height = 92;
      thumbnail.loading = 'lazy';
      thumbnail.decoding = 'async';
      thumbnail.fetchPriority = 'low';
      thumbnail.referrerPolicy = 'no-referrer';
      thumbnail.src = url;
      button.append(thumbnail);
      return button;
    });
    strip.replaceChildren(...buttons);
    if (!variantSelected) void showPhoto(photos[0], buttons[0].dataset.alt!, buttons[0], photos[0], 'low');
  }

  const groups = page.querySelector<HTMLElement>('[data-sku-groups]')!;
  const skuStatus = page.querySelector<HTMLElement>('[data-sku-status]')!;
  const groupTemplate = page.querySelector<HTMLTemplateElement>('[data-sku-template]')!;
  groups.addEventListener('error', (event) => {
    if (!(event.target instanceof HTMLImageElement)) return;
    const option = event.target.closest<HTMLButtonElement>('[data-option]');
    if (option) option.textContent = option.title;
  }, true);
  groups.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest<HTMLButtonElement>('button[data-option]');
    if (!button) return;
    const group = button.closest('[data-sku-group]')!;
    for (const option of group.querySelectorAll('[data-option]')) {
      option.setAttribute('aria-pressed', String(option === button));
    }
    if (button.dataset.variantImage) {
      variantSelected = true;
      void showPhoto(button.dataset.variantImage, button.dataset.alt!, null);
    }
  });

  function showUnavailable() {
    skuStatus.dataset.i18n = 'variantsUnavailable';
    skuStatus.textContent = translate('variantsUnavailable');
  }

  function renderVariantGroup(group: {title: string, options: Array<{label: string, image?: string}>}) {
    const node = groupTemplate.content.cloneNode(true) as DocumentFragment;
    const [title, key] = variantTitle(group.title);
    const legend = node.querySelector('legend')!;
    legend.textContent = key ? translate(key) : title;
    if (key) legend.dataset.i18n = key;
    const choices = node.querySelector('.sku-options')!;
    choices.classList.toggle('sku-photos', group.options.some((option) => option.image));

    for (const option of group.options) {
      const button = document.createElement('button');
      button.type = 'button';
      button.dataset.option = '';
      button.title = option.label;
      button.setAttribute('aria-label', option.label);
      button.setAttribute('aria-pressed', 'false');
      if (option.image) {
        button.dataset.variantImage = option.image;
        button.dataset.alt = option.label;
        const thumbnail = document.createElement('img');
        thumbnail.src = option.image;
        thumbnail.alt = '';
        thumbnail.width = thumbnail.height = 58;
        thumbnail.loading = 'lazy';
        thumbnail.decoding = 'async';
        thumbnail.fetchPriority = 'low';
        thumbnail.referrerPolicy = 'no-referrer';
        button.append(thumbnail);
      } else {
        button.textContent = option.label;
      }
      choices.append(button);
    }
    return node;
  }

  const needsGallery = !gallery.dataset.cachedGallery;
  const needsOptions = !groups.childElementCount;
  if (needsGallery || needsOptions) {
    fetchSellerProduct(page.dataset.product!).then(({ images, options }) => {
      if (needsGallery && images.length) renderSellerGallery(images);
      if (!needsOptions) return;
      if (!options.length) {
        showUnavailable();
        return;
      }
      groups.append(...options.map(renderVariantGroup));
      groups.hidden = false;
      skuStatus.hidden = true;
    }).catch(() => {
      if (needsOptions) showUnavailable();
    });
  }

  const agentPicker = page.querySelector<HTMLElement>('.other-agents')!;
  const alternatives = agentPicker.querySelector<HTMLButtonElement>('button')!;
  const agentPanel = agentPicker.querySelector<HTMLElement>('#other-agent-panel')!;
  const agentLinks = agentPanel.querySelector<HTMLUListElement>('ul')!;

  function setAgentPanelOpen(open: boolean) {
    agentPanel.hidden = !open;
    alternatives.setAttribute('aria-expanded', String(open));
  }

  alternatives.addEventListener('click', () => {
    setAgentPanelOpen(agentPanel.hidden);
    if (agentPanel.hidden || agentLinks.childElementCount) return;
    for (const { name, url, logo } of alternativeAgents(page.dataset.product!)) {
      const item = document.createElement('li');
      const target = document.createElement('a');
      const mark = document.createElement('img');
      mark.src = logo;
      mark.width = mark.height = 18;
      mark.alt = '';
      mark.decoding = 'async';
      const label = document.createElement('span');
      label.textContent = name;
      target.append(mark, label);
      target.className = 'agent-link';
      target.href = url;
      target.target = '_blank';
      target.rel = 'sponsored noopener';
      item.append(target);
      agentLinks.append(item);
    }
  });
  document.addEventListener('click', (event) => {
    if (!agentPanel.hidden && !agentPicker.contains(event.target as Node)) setAgentPanelOpen(false);
  });
  agentPicker.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || agentPanel.hidden) return;
    setAgentPanelOpen(false);
    alternatives.focus();
  });

  const copy = page.querySelector<HTMLButtonElement>('[data-copy]')!;
  const status = page.querySelector<HTMLElement>('[data-copy-status]')!;
  const fallback = page.querySelector<HTMLInputElement>('[data-copy-fallback]')!;
  copy.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(copy.dataset.copy!);
      status.textContent = translate('copied');
      fallback.hidden = true;
    } catch {
      fallback.hidden = false;
      fallback.focus();
      fallback.select();
    }
  });
</script>
