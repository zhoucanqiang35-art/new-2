---
import languages from "../languages.json";
---
<div class="language-picker" data-i18n-ignore>
  <button id="open-language" class="button button-small language-button" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="language-dialog">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/></svg>
    <span id="current-language">English</span>
    <svg class="language-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m7 10 5 5 5-5"/></svg>
  </button>
  <div id="language-dialog" class="language-dialog" role="dialog" aria-labelledby="language-title" hidden>
    <div class="agent-dialog-header">
      <h2 id="language-title">Choose a language</h2>
      <button id="close-language" class="agent-close" type="button" aria-label="Close language picker">×</button>
    </div>
    <button type="button" class="language-default" data-language="en" lang="en" aria-pressed="true">English</button>
    <div class="language-options">
      {languages.filter(({code}) => code !== "en").map(({code, name, dir}) => <button type="button" data-language={code} dir={dir} lang={code} aria-pressed="false">{name}</button>)}
    </div>
    <p id="language-status" role="status" hidden></p>
  </div>
</div>
<script>
  import "../lib/language-picker";
</script>
