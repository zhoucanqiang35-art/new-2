---
import { readFileSync } from "node:fs";
import Layout from "../components/Layout.astro";
import { categoryLabel, detailsUrl, priceLabel, type Product } from "../lib/catalog";

const products: Product[] = JSON.parse(readFileSync("public/data/catalog.json", "utf8"));
const qc: Record<string, { images?: unknown[] }> = JSON.parse(readFileSync("public/data/qc-featured.json", "utf8"));
const sample = products.find(product => product.weidianId === "7405460467")!;
const galleries: Record<string, string[]> = JSON.parse(readFileSync("public/data/gallery-7405.json", "utf8"));
const sampleInfo = [
  ["Weidian item ID", sample.weidianId],
  ["Category", categoryLabel(sample.category)],
  ["USD reference price", priceLabel(sample.price)],
  ["Listing images", String(galleries[sample.weidianId]?.length || 1)],
  ["Saved warehouse QC photos", String(qc[sample.weidianId]?.images?.length ?? 0)],
];
const sections = [
  { id: "source", title: "Product identity and source", paragraphs: [
    "Each listing represents a Weidian product from the FindSpreadsheet catalog. Use the Weidian item ID to verify that the listing, image matches and purchasing links all refer to the same product.",
    "The product title and category help narrow your search. The original seller page is where you can confirm the current listing content, availability and seller-specific options.",
  ], points: ["Copy the item ID before comparing listings with similar names.", "Check whether the seller page still opens and whether the available version matches the preview."] },
  { id: "gallery", title: "Product gallery, color and style", paragraphs: [
    "The carousel shows images from the seller listing. Select a thumbnail or use the previous and next controls to inspect the available front, back, close-up and packaging views.",
    "A gallery can show several colors or versions in the same listing. Compare the image with the exact option name on Kakobuy before ordering.",
  ], points: ["Check the color, silhouette, materials described by the seller, and visible markings.", "Check whether pictured accessories are included in the selected option."] },
  { id: "pricing", title: "Price in USD and what you pay", paragraphs: [
    "The dollar amount is a reference estimate from the saved seller price in CNY. It helps compare listings, including when sorting the product directory by price.",
    "On Kakobuy, confirm the live price for the option you select. Domestic delivery, international freight, packing and optional services can add to the final total.",
  ], points: ["Compare prices for the same size, color and version.", "Use the agent checkout for the actual payable amount and billing currency."] },
  { id: "size", title: "Size, measurements and options", paragraphs: [
    "Use the seller’s own measurement chart and compare it with an item you already own. For tops, compare chest width, shoulder width, sleeve length and total length. For bottoms, compare waist, rise and inseam.",
    "For shoes, follow the seller’s size scale and compare foot length where measurements are provided. Check the version, quantity and color in the agent cart before paying.",
  ], points: ["Check whether the listing uses body or garment measurements.", "Confirm units and any size tolerance in the seller's chart."] },
  { id: "inspection", title: "Warehouse QC and photo fallback", paragraphs: [
    "Saved warehouse QC photos can show real units ordered by past buyers. Check the pictured version, tag, visible condition and accessories before treating a photo as evidence for your chosen option.",
    "If the preview has no warehouse photos, it shows the seller carousel images in the QC section and labels them as listing photos. After you order, use your own warehouse record to verify the specific item.",
  ], points: ["Compare labels, stitching, logos, colors and packaging where visible.", "If there is a discrepancy, use the order’s support channel while the item is still stored."] },
  { id: "agents", title: "Buy on Kakobuy or compare agents", paragraphs: [
    "Buy on Kakobuy opens the same Weidian item. The Other shopping agents menu lists the additional purchase routes used by FindSpreadsheet. The original listing link gives you another way to verify the item ID.",
    "Compare the experience on each agent using the same item and option. Availability, local shipment fees, warehouse services and international routes can vary.",
  ], points: ["Verify the item ID after the agent loads the listing.", "Select the exact variant and quantity in the agent cart."] },
  { id: "related", title: "Related products and image search", paragraphs: [
    "The related products area suggests listings from the same category. Use it to compare prices, seller imagery and available QC before choosing a product.",
    "If the title is unknown, upload a product photo on the independent image-search page. It compares the preview catalog’s covers, carousel images and available warehouse QC.",
  ], points: ["Use a clear photo with the item centered and crop away unrelated objects.", "Inspect the listing details on the strongest matches and compare their Weidian IDs."] },
  { id: "before-paying", title: "Before you place an order", paragraphs: [
    "Confirm the seller page, variant, measurements, quantity and payable total. Review any route restrictions and plan international shipping based on the expected packed parcel.",
    "Once the item reaches the warehouse, compare your own QC photos to the order. Submit the parcel after you have checked the goods and any required support request is resolved.",
  ], points: ["Keep the product ID and selected option for reference.", "Use the buying guide for ordering, warehouse inspection, parcel tracking and delivery."] },
];
---
<Layout title="Kakobuy Product Details | Gallery, USD Prices and QC" description="Understand product IDs, seller galleries, USD reference prices, sizing, warehouse QC photos, shopping agent links and related Kakobuy products.">
  <section class="shell section utility product-overview">
    <header class="content-heading">
      <h1>Kakobuy Product Details</h1>
      <p>See how to read a Weidian product page, review pictures and reference prices, check warehouse QC, and choose a shopping agent.</p>
    </header>
    <article class="overview-example" aria-labelledby="overview-example-title">
      <img src="/featured/7079.webp" alt={sample.name} data-product-photo={sample.weidianId} width="400" height="400" />
      <div>
        <h2 id="overview-example-title">Explore an example listing</h2>
        <h3 data-product-name={sample.weidianId}>{sample.name}</h3>
        <dl>{sampleInfo.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
        <div class="intro-actions"><a class="button" href={detailsUrl(sample.weidianId)}>Open example product ↗</a><a class="button button-outline" href={"/qc/?id=" + sample.weidianId}>View saved QC ↗</a></div>
      </div>
    </article>
    <nav class="overview-index" aria-label="On this product details page">
      <ul>{sections.map(({ id, title }) => <li><a href={"#" + id}>{title}</a></li>)}</ul>
    </nav>
    <div class="overview-sections">
      {sections.map(({ id, title, paragraphs, points }) => (
        <section id={id}>
          <h2>{title}</h2>
          {paragraphs.map(paragraph => <p>{paragraph}</p>)}
          <ul>{points.map(point => <li>{point}</li>)}</ul>
        </section>
      ))}
    </div>
    <div class="guide-actions"><a class="button" href="/browse/">Browse finds</a><a class="inline-arrow" href="/guide/how-to-buy/">Buying guide ↗</a><a class="inline-arrow" href="/qc/">QC Finder ↗</a><a class="inline-arrow" href="/image-search/">Image search ↗</a></div>
  </section>
</Layout>
