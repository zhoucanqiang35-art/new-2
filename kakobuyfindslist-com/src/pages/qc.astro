---
import Layout from "../components/Layout.astro";
import Icon from "../components/Icon.astro";
---
<Layout title="Kakobuy QC Finder | Search Warehouse Photos by Weidian ID" description="Look up saved warehouse QC photos with a Weidian item ID, Weidian listing link, or supported Kakobuy product link. See the source of any available photos.">
  <section class="shell section utility qc-page">
    <a class="inline-arrow" href="/browse/">← Back to finds</a>
    <div class="utility-heading">
      <p class="kicker"><span class="dot"></span> WEIDIAN QUALITY CHECK</p>
      <h1>Kakobuy <em>QC Finder.</em></h1>
      <p>Enter a Weidian item ID, paste a Weidian listing, or use a Kakobuy product link that points to Weidian. The finder checks saved warehouse photo records from FindSpreadsheet.</p>
    </div>
    <form id="qc-form" class="hero-search">
      <label class="visually-hidden" for="qc-id">Weidian product ID or link</label><Icon name="qc" />
      <input type="text" name="id" id="qc-id" placeholder="Paste a product link or Weidian ID" required />
      <button class="button" type="submit">Check QC <Icon name="arrow" size={17} /></button>
    </form>
    <div class="hero-links qc-examples"><span>Try a sample</span><button type="button" class="link-button" data-sample="7321418559">With photos</button><button type="button" class="link-button" data-sample="7854796979">No photos</button></div>
    <section id="qc-result" class="qc-panel" hidden aria-labelledby="qc-result-title">
      <h2 id="qc-result-title">Warehouse QC photos</h2><p id="qc-status" role="status"></p>
      <div id="qc-images" class="qc-photos"></div>
      <a id="qc-source" class="inline-arrow" hidden>Open item in the catalog →</a>
    </section>
    <section class="qc-panel" aria-labelledby="qc-help-title">
      <h2 id="qc-help-title">How to read the QC results</h2>
      <p>Warehouse photos show an item that reached a warehouse. Compare the color, size tag and selected option with your listing before using a saved photo as a reference.</p>
      <p>If the finder shows listing photos, those are the seller’s images. For an order you have already placed, use the inspection photos in your own Kakobuy account.</p>
      <p><a class="inline-arrow" href="/guide/how-to-buy/">Read the Kakobuy buying guide →</a></p>
    </section>
  </section>
</Layout>
<script>
  import {detailsUrl, galleryPhotos, getData, type Product} from "../lib/catalog";
  import {itemFromInput, showListingPhotos, showQc} from "../lib/qc";
  const form = document.querySelector<HTMLFormElement>("#qc-form")!;
  const input = document.querySelector<HTMLInputElement>("#qc-id")!;
  const result = document.querySelector<HTMLElement>("#qc-result")!;
  const status = document.querySelector<HTMLElement>("#qc-status")!;
  const gallery = document.querySelector<HTMLElement>("#qc-images")!;
  const link = document.querySelector<HTMLAnchorElement>("#qc-source")!;
  let revision = 0;
  async function check() {
    const current = ++revision;
    const id = itemFromInput(input.value);
    result.hidden = false;
    link.hidden = true;
    if (!id) {
      gallery.replaceChildren();
      status.textContent = "Enter a Weidian product ID or a supported product link.";
      return;
    }
    history.replaceState(null, "", "/qc/?id=" + id);
    const verifiedQc = showQc(id, status, gallery, () => current === revision);
    try {
      const catalog = await getData<Product[]>("catalog.json");
      const product = catalog.find(row => row.weidianId === id);
      if (current !== revision || !product) return;
      link.href = detailsUrl(id);
      link.hidden = false;
      if (!(await verifiedQc) && current === revision) {
        const photos = await galleryPhotos(product).catch(() => [product.image]);
        if (current === revision) showListingPhotos(status, gallery, photos);
      }
    } catch { /* The catalog link is optional when the catalog is unavailable. */ }
  }
  form.addEventListener("submit", event => { event.preventDefault(); void check(); });
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-sample]")) {
    button.onclick = () => { input.value = button.dataset.sample ?? ""; void check(); };
  }
  input.value = new URLSearchParams(location.search).get("id") ?? "";
  if (input.value) void check();
</script>
