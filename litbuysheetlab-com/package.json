{
  "name": "litbuysheetlab-preview",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "astro build",
    "dev": "astro dev",
    "i18n:audit": "node scripts/run-python.mjs scripts/translation-pipeline.py audit",
    "i18n:reuse": "node scripts/run-python.mjs scripts/translation-pipeline.py reuse",
    "i18n:translate": "node scripts/run-python.mjs scripts/translation-pipeline.py translate",
    "i18n:collect": "node scripts/run-python.mjs scripts/collect-translation-source.py",
    "preview": "node scripts/local-preview.mjs",
    "test": "node --test tests/*.test.mjs",
    "preview:check": "node scripts/local-preview.mjs --check",
    "i18n:check": "node scripts/run-python.mjs scripts/translation-pipeline.py audit --strict"
  },
  "dependencies": {
    "astro": "7.4.11"
  },
  "devDependencies": {
    "jsdom": "^31.0.1"
  }
}
