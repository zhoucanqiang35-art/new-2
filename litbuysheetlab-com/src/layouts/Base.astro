---
import '../styles/global.css';
const { title = 'Litbuy Spreadsheet | Sheet Lab', description = 'Browse Litbuy product finds, compare reference prices and listing photos, and learn how to check an item before ordering.', indexable, schema } = Astro.props;
const indexablePaths = new Set(['/', '/products/', '/categories/', '/guide/', '/faq/']);
const path = Astro.url.pathname;
const canonical = new URL(path, 'https://litbuysheetlab.com').href;
const robots = (indexable ?? (indexablePaths.has(path) || ['/about/', '/privacy/', '/contact/', '/disclosure/'].includes(path))) ? 'index,follow' : 'noindex,follow';
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content={robots}/><link rel="canonical" href={canonical}/><meta name="description" content={description}/><title>{title}</title><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/>{schema&&<script type="application/ld+json" is:inline set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}/> }<link rel="icon" href="/logo-litbuy.png" type="image/png"/><meta name="msvalidate.01" content="E34A6C20A8A058592D1DC4B20523F6CB" />
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-QXBPND9VPN"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-QXBPND9VPN');
</script></head><body><header class="header"><a class="brand" href="/" aria-label="Litbuy Sheet Lab home"><img src="/logo-litbuy.png" alt="Litbuy" class="litbuy-logo"/></a><button class="nav-toggle" aria-expanded="false" aria-controls="site-nav" data-home-i18n="menu_label">Menu</button><nav id="site-nav"><a href="/" data-home-i18n="home">Home</a><a href="/products/" data-home-i18n="finds">Featured finds</a><a href="/categories/" data-home-i18n="categories">Categories</a><a href="/guide/" data-home-i18n="guide">How it works</a><a href="/faq/" data-home-i18n="faq">FAQ</a></nav><div class="header-settings"><label for="language" class="sr-only">Language</label><select id="language" aria-label="Language"><option value="en">English</option><option value="zh">中文</option><option value="de">Deutsch</option><option value="fr">Français</option><option value="es">Español</option><option value="it">Italiano</option><option value="pt">Português</option><option value="nl">Nederlands</option><option value="pl">Polski</option><option value="sv">Svenska</option><option value="da">Dansk</option><option value="no">Norsk</option><option value="fi">Suomi</option><option value="cs">Čeština</option><option value="hu">Magyar</option><option value="ro">Română</option><option value="el">Ελληνικά</option><option value="tr">Türkçe</option><option value="uk">Українська</option><option value="ru">Русский</option><option value="ja">日本語</option><option value="ko">한국어</option><option value="ar">العربية</option><option value="id">Bahasa Indonesia</option></select><label for="currency" class="sr-only">Currency</label><select id="currency" aria-label="Currency"><option value="USD">USD $</option><option value="EUR">EUR €</option><option value="GBP">GBP £</option><option value="CAD">CAD $</option><option value="AUD">AUD $</option><option value="JPY">JPY ¥</option><option value="CNY">CNY ¥</option></select></div><a class="nav-cta" href="https://litbuy.com/register?inviteCode=E32JME4UQ" target="_blank" rel="noopener sponsored" data-home-i18n="register">Register on Litbuy ↗</a></header><slot/><footer><div class="footer-inner"><div><a class="brand footer-brand" href="/"><img src="/logo-litbuy.png" alt="Litbuy" class="litbuy-logo"/></a><p data-home-i18n="footer">Independent product discovery · FindSpreadsheet catalog</p></div><div><strong data-home-i18n="finds_eyebrow">Worth a closer look</strong><a href="/products/" data-home-i18n="finds">Featured finds</a><a href="/categories/" data-home-i18n="categories">Categories</a><a href="/guide/" data-home-i18n="guide">How it works</a></div><div><strong data-home-i18n="good_to_know">Good to know.</strong><a href="/faq/" data-home-i18n="faq">FAQ</a><a href="https://findspreadsheet.com/" target="_blank" rel="noopener">FindSpreadsheet ↗</a><a href="https://litbuy.com/register?inviteCode=E32JME4UQ" target="_blank" rel="noopener sponsored" data-home-i18n="register">Register on Litbuy ↗</a></div></div><nav class="footer-legal" aria-label="Site information"><a href="/about/" data-home-i18n="about_label">About this site</a><a href="/contact/" data-home-i18n="contact_label">Contact</a><a href="/privacy/" data-home-i18n="privacy_label">Privacy</a><a href="/disclosure/" data-home-i18n="disclosure_label">Referral disclosure</a></nav><div class="footer-end"><span>© 2026 Litbuy Sheet Lab</span><span data-home-i18n="a4">Independent product-discovery site. Litbuy operates purchasing, accounts, warehouse services and shipping.</span></div></footer><script src="/site.js" is:inline></script><script src="/language.js" is:inline></script><script src="/currency.js" is:inline></script><script src="/image-search.js" is:inline></script></body></html>
