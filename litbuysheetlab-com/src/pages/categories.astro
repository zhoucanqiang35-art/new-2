---
import Base from '../layouts/Base.astro';
const categoryIcons = {"shoes": "M3 16c3 0 4-2 5-5l4 3c2 2 4 3 8 3 1 0 1 3 0 3H4c-2 0-2-4-1-4Z", "hoodies-sweaters": "M9 5c0-4 6-4 6 0l3 2 3 5-3 2-2-3v9H8v-9l-2 3-3-2 3-5 3-2Z", "t-shirts": "M8 4 4 6l-2 4 3 2 2-2v10h10V10l2 2 3-2-2-4-4-2c-1 3-7 3-8 0Z", "jackets": "M9 4h6l4 3 2 6-3 1-1-3v9H7v-9l-1 3-3-1 2-6 4-3Zm3 0v16", "pants-shorts": "M7 4h10l1 16h-5l-1-10-1 10H6L7 4Z", "accessories": "M5 8h14l-1 12H6L5 8Zm4 0V6a3 3 0 0 1 6 0v2", "headwear": "M4 13a8 8 0 0 1 16 0H4Zm8-8v8m-8 0c0 3 5 3 9 3 3 0 6-.4 7-2", "electronics": "M8 3h8a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm2 15h4", "jersey": "M8 4 4 6l-2 4 3 2 2-2v10h10V10l2 2 3-2-2-4-4-2c-1 3-7 3-8 0Zm2 9 2-2v6m-2 0h4", "ShortSets": "M8 3 4 5 3 8l3 2 1-1v4h10V9l1 1 3-2-1-3-4-2c-1 2-7 2-8 0ZM7 15h10l1 6h-5l-1-3-1 3H6l1-6Z", "other-stuff": "M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z"};
const categories=[['Shoes','shoes','01'],['Hoodies','hoodies-sweaters','02'],['T-Shirts','t-shirts','03'],['Jackets','jackets','04'],['Pants & Shorts','pants-shorts','05'],['Accessories','accessories','06'],['Headwear','headwear','07'],['Electronics','electronics','08'],['Jersey','jersey','09'],['Short Sets','ShortSets','10'],['Other Finds','other-stuff','11']];

const descriptions = {"shoes": "Compare the seller’s upper and sole materials, construction, closure and size chart. Measure your foot and check whether the listing uses EU, US or another sizing system. Review available photos for the shape, seams and soles; shoe boxes and protective packaging can affect parcel volume.", "hoodies-sweaters": "Check the listed fibre content, fabric thickness, lining, hood or collar and garment measurements. Compare chest, shoulder, sleeve and length with clothing that fits you. Review prints, embroidery, stitching and care instructions; thicker fleece or knitwear may increase packed weight.", "t-shirts": "Compare the fabric composition, advertised weight, fit and size measurements. Inspect product photos for the print position, collar and seams, and check washing instructions. When buying multiple shirts, confirm each colour and size separately before ordering.", "jackets": "Review shell material, lining or fill, closures, pockets and measurements. Check whether the seller describes weather protection and whether a hood or accessories are included. Compare front, back and seam photos; bulky lining and packaging can affect the shipping estimate.", "pants-shorts": "Check fabric composition, stretch, rise, waist, hips and inseam rather than relying on the size letter alone. Confirm whether the listing is for trousers, shorts or underwear. Examine seams, pockets and closures, and check the seller’s measurement and care guidance.", "accessories": "Check the listed material, dimensions, colour, fastening and included components. Small product photos can hide details, so inspect the available images and seller description carefully. Confirm whether a box, pouch or extra piece is included and consider its effect on packaging.", "headwear": "Compare head circumference, depth, fabric and whether the cap is adjustable. Review the brim, stitching, embroidery and shape in the available images. If the shape matters, check the seller’s packaging and ask about protection before shipment.", "electronics": "Check model, specifications, charging connector, voltage, plug compatibility and included accessories. Verify whether the item contains a battery and ask the platform about destination and carrier restrictions. Confirm function, warranty and packaging with the seller; do not assume every route accepts electronics.", "jersey": "Review the size chart, cut, fabric, badges and printing or embroidery. Confirm whether the listing includes shorts or optional customization. Compare the available front and back images and ask the seller for clarification before ordering when sizing or print details are unclear.", "ShortSets": "Confirm exactly which pieces are included and whether the top and bottom share one size. Compare each piece’s measurements, materials and colour with the listing. Review graphics, seams and care guidance, and confirm quantities before placing the order.", "other-stuff": "This group contains varied products, so read each listing individually. Check the item’s material, dimensions, quantity, options and included accessories, then review the seller photos and any destination restrictions. Ask the platform for details when the listing does not provide enough information."};
---
<Base title="Litbuy Product Categories | Buying Checks & Listing Photos" description="Explore 11 Litbuy product categories with listing checks, size and material questions, shipping considerations and guidance on genuine warehouse QC." indexable={true}><main class="studio standalone"><section class="studio-section" id="categories"><div class="studio-section-heading"><div><p class="studio-eyebrow" data-home-i18n="cat_eyebrow">Find your way</p><h1 data-home-i18n="categories">Product categories</h1></div><p data-home-i18n="cat_desc">Start with a category you love.</p></div><div class="studio-category-grid">{categories.map(([label,slug,num])=><a href={'/categories/'+slug+'/'}><div class="category-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={categoryIcons[slug]} /></svg></div><div class="category-label"><span>{num}</span><strong data-home-category={slug}>{label}</strong><b>↗</b></div></a>)}</div><div class="category-explanations">{categories.map(([label,slug,num])=><article id={'detail-'+slug}><div class="category-number">{num}</div><div><h3 data-home-category={slug}>{label}</h3><p data-home-i18n={'cat_detail_'+slug}>{descriptions[slug]}</p><p data-home-i18n="all_intro">Browse all products in the FindSpreadsheet catalog snapshot.</p><a href={'/categories/'+slug+'/'} data-home-i18n="all_products">All products ↗</a></div></article>)}</div></section></main></Base>