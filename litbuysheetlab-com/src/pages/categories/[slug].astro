---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import {products,categoryNames,categoryDescriptions} from '../../lib/catalog.js';
export function getStaticPaths(){return Object.entries(categoryNames).map(([slug,name])=>({params:{slug},props:{slug,name}}));}
const {slug,name}=Astro.props;
const matches=products.filter(p=>p.category===slug);
---
<Base title={`${name} Finds for Litbuy | Photos, Prices & Buying Checks`} description={`Explore ${name.toLowerCase()} product finds, archived reference prices and source photos. Review sizes, materials, shipping and QC checks before using Litbuy.`} indexable={true}>
<main class="section category-landing"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/categories/" data-home-i18n="categories">Categories</a></nav><p class="eyebrow">LITBUY SHEET LAB</p><h1 data-home-category={slug}>{name}</h1><p class="category-description" data-home-i18n={'cat_detail_'+slug}>{categoryDescriptions[slug]}</p><div class="category-advice"><section><h2 data-home-i18n="shipping_checks">Shipping checks</h2><p data-home-i18n="shipping_checks_body">Confirm packed dimensions, weight, destination and carrier restrictions in Litbuy's shipping estimator. Reference item prices exclude delivery, platform fees and taxes.</p><a href="https://litbuy.com/shipping-estimate" target="_blank" rel="noopener" data-home-i18n="freight_estimator">Open freight estimator</a></section><section><h2 data-home-i18n="qc_checks">Finding genuine QC photos</h2><p data-home-i18n="qc_checks_body">Review inspection photos in your Litbuy warehouse account after arrival. Seller listing photos on this site are not verified QC. Match the item ID, selected option and measurements before requesting shipping.</p><a href="/guide/" data-home-i18n="guide">How it works</a></section></div><div class="catalog-title"><h2><span data-home-i18n="finds">Product finds</span> · {matches.length}</h2><a class="button-dark" href={'/products/?category='+slug} data-home-i18n="browse_filter">Browse and filter this category</a></div><p class="data-note" data-home-i18n="price_warning">Archived reference, not a live Litbuy quote. Excludes domestic delivery, service fees, international shipping and taxes. Litbuy may use a different conversion rate.</p><div class="products">{matches.slice(0,24).map(product=><ProductCard product={product}/>)}</div><a class="text-link" href={'/products/?category='+slug} data-home-i18n="browse_filter">Browse and filter this category</a></main>
</Base>
