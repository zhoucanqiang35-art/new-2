---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import {products,categoryNames} from '../lib/catalog.js';
const featured=Object.keys(categoryNames).map(c=>products.filter(p=>p.category===c&&p.image)[3]).filter(Boolean);
for(const p of products.slice(8)){if(featured.length>=12)break;if(p.image&&!featured.some(x=>x.id===p.id))featured.push(p);}
import { faqItems } from '../data/faq.js';
const categoryIcons = {"shoes": "M3 16c3 0 4-2 5-5l4 3c2 2 4 3 8 3 1 0 1 3 0 3H4c-2 0-2-4-1-4Z", "hoodies-sweaters": "M9 5c0-4 6-4 6 0l3 2 3 5-3 2-2-3v9H8v-9l-2 3-3-2 3-5 3-2Z", "t-shirts": "M8 4 4 6l-2 4 3 2 2-2v10h10V10l2 2 3-2-2-4-4-2c-1 3-7 3-8 0Z", "jackets": "M9 4h6l4 3 2 6-3 1-1-3v9H7v-9l-1 3-3-1 2-6 4-3Zm3 0v16", "pants-shorts": "M7 4h10l1 16h-5l-1-10-1 10H6L7 4Z", "accessories": "M5 8h14l-1 12H6L5 8Zm4 0V6a3 3 0 0 1 6 0v2", "headwear": "M4 13a8 8 0 0 1 16 0H4Zm8-8v8m-8 0c0 3 5 3 9 3 3 0 6-.4 7-2", "electronics": "M8 3h8a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm2 15h4", "jersey": "M8 4 4 6l-2 4 3 2 2-2v10h10V10l2 2 3-2-2-4-4-2c-1 3-7 3-8 0Zm2 9 2-2v6m-2 0h4", "ShortSets": "M8 3 4 5 3 8l3 2 1-1v4h10V9l1 1 3-2-1-3-4-2c-1 2-7 2-8 0ZM7 15h10l1 6h-5l-1-3-1 3H6l1-6Z", "other-stuff": "M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z"};
const categories=[['Shoes','shoes','01'],['Hoodies','hoodies-sweaters','02'],['T-Shirts','t-shirts','03'],['Jackets','jackets','04'],['Pants & Shorts','pants-shorts','05'],['Accessories','accessories','06'],['Headwear','headwear','07'],['Electronics','electronics','08'],['Jersey','jersey','09'],['Short Sets','ShortSets','10'],['Other Finds','other-stuff','11']];
---
<Base><main class="canvas-home">
  <section class="signal-hero"><div class="signal-frame"><div class="signal-top"><span>LITBUY SHEET LAB</span><span>FINDSPREADSHEET / 01</span></div><p class="signal-eyebrow" data-home-i18n="eyebrow">Your next great find starts here</p><h1><span>Litbuy</span><span data-home-i18n="hero_spreadsheet">Spreadsheet</span></h1><div class="signal-caption"><p data-home-i18n="hero_desc">Discover product finds, browse categories and prepare to shop. Your starting point, powered by FindSpreadsheet.</p><a href="/products/" data-home-i18n="all_products">All products ↗</a></div><form action="/products/" class="mast-search signal-search"><label class="sr-only" for="signal-query">Search products</label><span aria-hidden="true">⌕</span><input id="signal-query" type="search" name="q" placeholder="Search products, brands or styles..." aria-label="Search products"/><button type="submit" data-home-i18n="search">Search ↗</button></form></div></section>
  <section class="canvas-categories"><div class="canvas-heading"><div><p data-home-i18n="cat_eyebrow">Find your way</p><h2 data-home-i18n="cat_title">Explore by category.</h2></div><a href="/categories/" data-home-i18n="categories">Categories ↗</a></div><div class="canvas-category-list">{categories.map(([label,slug])=><a href={'/categories/'+slug+'/'}><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={categoryIcons[slug]} /></svg></span><strong data-home-category={slug}>{label}</strong></a>)}</div></section>
  <section class="canvas-finds"><div class="canvas-heading"><div><p data-home-i18n="finds_eyebrow">Worth a closer look</p><h2 data-home-i18n="finds_title">Featured finds.</h2></div><a class="canvas-all" href="/products/" data-home-i18n="all_products">All products ↗</a></div><p class="swipe-hint" data-home-i18n="swipe_finds">Swipe to browse all 12 featured finds</p><div class="products canvas-products" id="featured">{featured.map(product=><ProductCard product={product}/>)}</div><p class="data-note" data-home-i18n="all_intro">Browse all products in the FindSpreadsheet catalog snapshot.</p></section>
  <section class="canvas-guide"><div class="canvas-guide-header"><p data-home-i18n="guide">How it works</p><h2 data-home-i18n="guide_head">Find it. Check it. Make it yours.</h2><p data-home-i18n="guide_text">Browse an item, review its photos and details, then open the purchasing platform. Check the latest price, options and shipping terms before placing an order.</p><a href="/guide/" data-home-i18n="guide">How it works ↗</a></div><div class="canvas-steps"><article><span>01</span><h3 data-home-i18n="step1">Find a product</h3><p data-home-i18n="step1_desc">Browse categories or use the search box on the homepage.</p></article><article><span>02</span><h3 data-home-i18n="step2">Check the details</h3><p data-home-i18n="step2_desc">Open the source page to check photos, size, price and availability.</p></article><article><span>03</span><h3 data-home-i18n="step3">Continue to Litbuy</h3><p data-home-i18n="step3_desc">Register or sign in and check fees, shipping and options.</p></article></div></section>
  <section class="canvas-faq"><div class="canvas-heading"><div><p data-home-i18n="faq">FAQ</p><h2 data-home-i18n="good_to_know">Good to know.</h2></div><a href="/faq/" data-home-i18n="faq">FAQ ↗</a></div><div class="faq-list">{faqItems.map(([q,a],i)=><details><summary><span data-home-i18n={`faq_question_${i}`}>{q}</span><span>+</span></summary><p data-home-i18n={`faq_answer_${i}`}>{a}</p></details>)}</div></section>
</main><script src="/app.js" is:inline></script></Base>
