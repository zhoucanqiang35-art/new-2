---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import {products,categoryNames,snapshotDate} from '../lib/catalog.js';
---
<Base title="Litbuy Spreadsheet | Search Products, Prices & Listing Photos" description="Search all catalog products by name, category or seller item number. Filter archived CNY prices and available listing photos, and compare finds before using Litbuy." indexable={true}>
<main class="catalog-page section"><p class="eyebrow">LITBUY SHEET LAB</p><div class="catalog-title"><div><h1 data-home-i18n="catalog_heading">Search product finds</h1><p data-home-i18n="catalog_intro">Browse the full source catalog. Filter reference prices and listing photos before checking the current platform listing.</p></div><a href="/categories/" class="outline-button" data-home-i18n="categories">Categories</a></div>
<form id="catalog-form" action="/products/" class="search catalog-search"><label for="query" class="sr-only">Search products</label><span class="search-icon" aria-hidden="true">⌕</span><input name="q" id="query" placeholder="Name, category or seller item ID" aria-label="Search products"/><button type="submit" data-home-i18n="search">Search</button></form>
<div id="catalog-controls" class="catalog-controls"><label><span data-home-i18n="category_label">Category</span><select name="category" aria-label="Category"><option value="" data-home-i18n="all_finds">All finds</option>{Object.entries(categoryNames).map(([key,label])=><option value={key} data-home-category={key}>{label}</option>)}</select></label><label><span data-home-i18n="min_cny">Min price (CNY)</span><input type="number" name="min" min="0" step="0.01" inputmode="decimal" aria-label="Min price (CNY)"/></label><label><span data-home-i18n="max_cny">Max price (CNY)</span><input type="number" name="max" min="0" step="0.01" inputmode="decimal" aria-label="Max price (CNY)"/></label><label><span data-home-i18n="sort_label">Sort</span><select name="sort" aria-label="Sort"><option value="default" data-home-i18n="relevance">Default / image similarity</option><option value="price-asc" data-home-i18n="price_asc">Price: low to high</option><option value="price-desc" data-home-i18n="price_desc">Price: high to low</option><option value="name" data-home-i18n="name_sort">Product name</option><option value="id" data-home-i18n="catalog_order">Catalog ID: newest first</option></select></label><label><span data-home-i18n="photos_label">Photo availability</span><select name="photos" aria-label="Photo availability"><option value="all" data-home-i18n="all_photos">All products</option><option value="gallery" data-home-i18n="with_gallery">Source gallery available</option><option value="seller" data-home-i18n="with_seller_photos">Seller gallery available</option><option value="qc" data-home-i18n="verified_qc_only">Verified warehouse QC only</option></select></label><button type="button" id="clear-filters" data-home-i18n="clear_filters">Clear filters</button></div>
<p id="filter-error" class="filter-error" role="alert"></p><p id="search-notice" class="data-note" role="status"></p>
<div class="list-meta"><span id="result-count" aria-live="polite">{products.length} products</span><span><span data-home-i18n="catalog_date">Catalog snapshot</span>: {snapshotDate}</span></div>
<p class="catalog-price-note" data-home-i18n="price_warning">Archived reference, not a live Litbuy quote. Excludes domestic delivery, service fees, international shipping and taxes. Litbuy may use a different conversion rate.</p><p class="rate-status" aria-live="polite"></p>
<div class="products" id="catalog">{products.slice(0,24).map(product=><ProductCard product={product}/>)}</div><nav id="catalog-pagination" class="pagination" aria-label="Product pages"></nav>
</main><script src="/app.js" is:inline></script></Base>
