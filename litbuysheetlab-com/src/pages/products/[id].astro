---
import {asset} from '../../lib/assets.js';
import Base from '../../layouts/Base.astro';
import optionSnapshots from '../../data/options-snapshot.js';

import {products,categoryNames,listingImages,hasSeller,agentLinks,productUrl,snapshotDate} from '../../lib/catalog.js';
export function getStaticPaths(){return products.map(product=>({params:{id:String(product.id)},props:{product}}));}
const {product:p}=Astro.props;
const images=listingImages(p);

const sourceUrl='https://findspreadsheet.com'+p.sourcePath;
const description=`${p.name}: compare ${categoryNames[p.category].toLowerCase()} listing photos, the archived CNY reference price, seller options and product details before continuing to Litbuy.`;
const schema={'@context':'https://schema.org','@type':'WebPage',name:p.name,description,url:'https://litbuysheetlab.com'+productUrl(p),isPartOf:{'@type':'WebSite',name:'Litbuy Sheet Lab',url:'https://litbuysheetlab.com/'}};
---
<Base title={`${p.name} | Litbuy Sheet Lab`} description={description} indexable={true} schema={schema}>
<main class="section product-detail static-product">
 <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href={'/categories/'+p.category+'/'} data-home-category={p.category}>{categoryNames[p.category]}</a><span>/</span><span>#{p.id}</span></nav>
 <div class="detail-grid">
  <div class="product-visual"><div class="detail-image"><img id="slide-image" src={images[0]} alt={p.name} width="700" height="700" fetchpriority="high"/></div>
   <div class="source-carousel" aria-label="Product listing gallery"><button class="source-prev" aria-label="Previous product image">‹</button><div class="source-thumbs">{images.map((url,i)=><button data-source-slide={i} aria-label={`Show product image ${i+1}`} aria-pressed={i===0}><img src={url} alt="" loading="lazy"/></button>)}</div><button class="source-next" aria-label="Next product image">›</button></div>
   <p class="source-caption" data-home-i18n="listing_photos_notice">Listing photos from the source catalog or seller. Not verified warehouse QC.</p>
  </div>
  <div class="detail-copy"><p class="eyebrow" data-home-category={p.category}>{categoryNames[p.category]}</p><h1 data-product-title={p.id}>{p.name}</h1>
   <p class="detail-product-id"><span data-home-i18n="product_id_label">Product ID</span> {p.weidianId||'Unavailable'} · #{p.id}</p>
   <p class="price-label" data-home-i18n="reference_item_price">Reference item price</p><p class="detail-price"><span class="money" data-cny={p.price} data-usd={(Number(p.price)/7.26).toFixed(6)}>¥{Number(p.price).toFixed(2)} CNY</span></p>
   <details class="price-explainer"><summary>Reference only · shipping and fees excluded</summary>   <p class="original-price"><span data-home-i18n="original_cny">Original catalog price</span>: ¥{Number(p.price).toFixed(2)} CNY</p>
   <p class="price-warning" data-home-i18n="price_warning">Archived reference, not a live Litbuy quote. Excludes domestic delivery, service fees, international shipping and taxes. Litbuy may use a different conversion rate.</p>
   <p class="price-date"><span data-home-i18n="catalog_date">Catalog snapshot</span>: <time datetime={snapshotDate}>{snapshotDate}</time>. <span class="rate-status" aria-live="polite"></span></p>
</details>
   <div class="detail-actions">{hasSeller(p)?<a class="button-dark" href={'https://litbuy.com/product/weidian/'+p.weidianId} target="_blank" rel="noopener sponsored" data-home-i18n="buy_litbuy">Buy on Litbuy</a>:<a class="button-dark" href={sourceUrl} target="_blank" rel="noopener" data-home-i18n="open_source">Open source listing</a>}</div>
   {hasSeller(p)&&<div class="product-tools"><details class="agents"><summary><span data-home-i18n="other_agents">Other shopping agents</span><span>＋</span></summary><div class="agent-grid">{agentLinks(p).map(([name,url])=><a href={url} target="_blank" rel="noopener sponsored"><img src={"/agents/"+name.toLowerCase()+".webp"} alt={name+" logo"} width="28" height="28" loading="lazy"/><span>{name}</span></a>)}</div></details><button id="copy-weidian" data-url={'https://weidian.com/item.html?itemID='+p.weidianId} data-home-i18n="copy_source">Copy original product link</button><p class="copy-status" aria-live="polite"></p></div>}
   {optionSnapshots[p.weidianId]&&<script id="source-options" type="application/json" is:inline set:html={JSON.stringify(optionSnapshots[p.weidianId]).replace(/</g, "\\u003c")} />}<section class="style-panel seller-options" data-seller-id={hasSeller(p)?p.weidianId:''}><h2>Choose your options</h2><p class="options-status" role="status">{hasSeller(p)?'Loading seller colours, styles and sizes…':'Seller options are unavailable for this source listing.'}</p><div id="seller-option-groups"></div><button class="options-retry" type="button" hidden>Retry loading options</button><p class="style-notice">Preview the source seller's options here. Confirm the selected combination, current price and stock on Litbuy before ordering.</p></section>
   <p class="detail-notice" data-home-i18n="affiliate_short">Independent discovery site. Some outgoing links contain referral codes; platform prices and terms apply.</p>
  </div>
 </div>
 <section class="gallery-panel"><h2 data-home-i18n="listing_photos">Detail photos</h2><p data-home-i18n="listing_photos_notice">Listing photos from the source catalog or seller. Not verified warehouse QC.</p><div class="gallery-grid">{images.map((url,i)=><a href={url} target="_blank" rel="noopener"><img src={url} alt={`${p.name} listing photo ${i+1}`} loading="lazy" width="360" height="360"/></a>)}</div></section>


</main><script src={asset('/product-page.js')} is:inline></script><script type="module" src={asset('/product-options.js')} is:inline></script>
</Base>
