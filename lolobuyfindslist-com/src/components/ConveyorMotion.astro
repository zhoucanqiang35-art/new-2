<canvas class="cover-photo cover-conveyor" width="1600" height="900" aria-hidden="true"></canvas>

<script>
  // Coordinates follow the belts in the 1600 × 900 warehouse artwork.
  type Point = readonly [x: number, y: number, scale: number];
  const routes: {points: readonly Point[]; duration: number; offsets: number[]}[] = [
    {
      points: [[1625, 760, .87], [1465, 687, .8], [1306, 620, .72],
        [1198, 550, .62], [1176, 497, .56], [1216, 432, .48],
        [1282, 375, .38], [1336, 337, .3]],
      duration: 11400,
      offsets: [.22, .69],
    },
    {
      points: [[602, 551, .27], [716, 519, .35], [831, 490, .44], [908, 474, .53]],
      duration: 7600,
      offsets: [.46],
    },
  ];

  function interpolate(a: number, b: number, c: number, d: number, t: number) {
    return b + .5 * t * (c - a + t * (2 * a - 5 * b + 4 * c - d + t * (3 * (b - c) + d - a)));
  }

  function position(points: readonly Point[], progress: number) {
    const step = progress * (points.length - 1);
    const index = Math.floor(step);
    const fraction = step - index;
    const before = points[Math.max(index - 1, 0)];
    const current = points[index];
    const next = points[index + 1];
    const after = points[Math.min(index + 2, points.length - 1)];
    return {
      x: interpolate(before[0], current[0], next[0], after[0], fraction),
      y: interpolate(before[1], current[1], next[1], after[1], fraction),
      scale: current[2] + (next[2] - current[2]) * fraction,
    };
  }

  async function startConveyor() {
    const canvas = document.querySelector<HTMLCanvasElement>('.cover-conveyor')!;
    const hero = canvas.closest<HTMLElement>('.edit-cover')!;
    const photo = hero.querySelector<HTMLImageElement>('img.cover-photo')!;
    const toggle = hero.querySelector<HTMLInputElement>('.cover-motion-switch input')!;
    const context = canvas.getContext('2d');
    const sprite = document.createElement('canvas');
    sprite.width = 131;
    sprite.height = 115;
    const parcel = sprite.getContext('2d');
    if (!context || !parcel) return;
    await photo.decode().catch(() => {});
    if (!photo.naturalWidth) return;

    // Reuse the artwork's foreground parcel so the moving packages match it.
    parcel.beginPath();
    parcel.moveTo(1, 20);
    parcel.lineTo(64, 1);
    parcel.lineTo(129, 20);
    parcel.lineTo(128, 85);
    parcel.lineTo(63, 113);
    parcel.lineTo(1, 88);
    parcel.closePath();
    parcel.clip();
    parcel.drawImage(photo, 1017, 404, 131, 115, 0, 0, 131, 115);

    const preference = matchMedia('(prefers-reduced-motion: reduce)');
    let inView = false;
    let frame = 0;
    let elapsed = 0;
    let lastTime = 0;

    function draw(time: number) {
      context!.clearRect(0, 0, canvas.width, canvas.height);
      // Draw from farthest to nearest so foreground packages occlude distant ones.
      const parcels = routes.flatMap(({points, duration, offsets}) => offsets.map(offset => {
        const progress = (time / duration + offset) % 1;
        return {...position(points, progress), alpha: Math.min(progress * 12, (1 - progress) * 13, 1)};
      }));
      parcels.sort((a, b) => a.y - b.y);
      for (const {x, y, scale, alpha} of parcels) {
        context!.globalAlpha = alpha * .89;
        context!.drawImage(sprite, x - 65 * scale, y - 90 * scale, 131 * scale, 115 * scale);
      }
    }

    function animate(now: number) {
      if (!lastTime || now - lastTime >= 1000 / 30) {
        elapsed += lastTime ? Math.min(64, now - lastTime) : 0;
        lastTime = now;
        draw(elapsed);
      }
      frame = requestAnimationFrame(animate);
    }

    function updatePlayback() {
      if (toggle.checked && inView && !document.hidden && !preference.matches) {
        if (!frame) frame = requestAnimationFrame(animate);
      } else {
        cancelAnimationFrame(frame);
        frame = 0;
        lastTime = 0;
      }
    }

    draw(0);
    hero.dataset.conveyorReady = '';
    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      updatePlayback();
    }).observe(hero);
    toggle.addEventListener('change', updatePlayback);
    preference.addEventListener('change', updatePlayback);
    document.addEventListener('visibilitychange', updatePlayback);
  }

  void startConveyor();
</script>
