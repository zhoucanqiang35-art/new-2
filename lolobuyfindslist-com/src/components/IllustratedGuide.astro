---
import {illustratedSteps} from '../lib/buying-help.mjs';
import GuideShot from './GuideShot.astro';
const {home = false} = Astro.props;
const markers = [
  [94, 13, 145, 1249, 560],
  [60, 96, 48, 1240, 676],
  [13, 73, 135, 845, 268],
  [42, 23, -45, 700, 525],
  [53, 94, 50, 1062, 231],
  [54, 79, 148, 1240, 223],
  [17, 14, -10, 917, 411],
  [42, 16, -150, 917, 228],
  [67, 45, 155, 917, 85],
];
---
<section class:list={['illustrated-guide', {'wrap edit-section home-guide': home}]} aria-labelledby="illustrated-heading">
  <div class="section-title">
    <h2 id="illustrated-heading">{home ? 'How to buy with LoloBuy' : 'From a Weidian link to your parcel'}</h2>
    {home && <a href="/guides/how-to-buy/">Full buying guide</a>}
  </div>
  <ol aria-labelledby="illustrated-heading">
    {illustratedSteps.map(({title, text, image, caption, source, href, label}, index) => {
      const src = image?.startsWith('/') ? image : '/assets/guide/' + image;
      const marker = markers[index];
      const Step = home ? 'details' : 'div';
      return (
        <li>
          <Step class="guide-step">
            {home && <summary>
              {image && <GuideShot src={src} caption={caption} marker={marker} compact />}
              <strong><span aria-hidden="true">{index + 1}. </span>{title}</strong>
            </summary>}
            <div class="guide-text">
              {!home && <h3><span aria-hidden="true">{index + 1}.</span> {title}</h3>}
              <p>{text}</p>
              <div class="guide-links">
                <a href={href}>{label}</a>
                {!image && source && source !== href && <a href={source}>Official page</a>}
              </div>
            </div>
            {image && <figure>
              <a class="guide-image-link" href={src} target="_blank" rel="noopener">
                <GuideShot src={src} caption={caption} marker={marker} />
              </a>
              <figcaption>{caption} {source && <a href={source}>Official page</a>}</figcaption>
            </figure>}
          </Step>
        </li>
      );
    })}
  </ol>
</section>
