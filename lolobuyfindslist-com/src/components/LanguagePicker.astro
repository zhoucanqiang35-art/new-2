---
import {languages} from '../lib/languages.mjs';
import {currencies, rateDate} from '../lib/shopping.mjs';
---
<div class="locale-controls">
  <details class="choice-menu" id="language-menu">
    <summary aria-label="Website language"><span id="current-language" lang="en" translate="no">English</span></summary>
    <div class="choice-panel">
      <div class="choice-grid" aria-label="Website language">
        {languages.map(([code, label]) => <button class="choice-tile" type="button" data-language={code} lang={code} translate="no" aria-pressed={code === 'en' ? 'true' : 'false'}>{label}</button>)}
      </div>
    </div>
  </details>
  <details class="choice-menu" id="currency-menu">
    <summary aria-label="Currency"><span id="current-currency" translate="no">USD</span></summary>
    <div class="choice-panel">
      <div class="choice-grid" aria-label="Currency">
        {currencies.map(code => <button class="choice-tile" type="button" data-currency={code} translate="no" aria-pressed={code === 'USD' ? 'true' : 'false'}>{code}</button>)}
      </div>
      <p class="currency-credit"><a href="https://www.exchangerate-api.com/">Rates by ExchangeRate-API</a> · <time datetime={rateDate}>{rateDate}</time></p>
    </div>
  </details>
</div>
<p id="language-status" class="visually-hidden" role="status"></p>
<script>
  import {languages} from '../lib/languages.mjs';
  import {navigationLabels} from '../lib/language-labels.mjs';

  import {shoppingOptions, updateShopping} from '../lib/shopping.mjs';
  import {currencyForLanguage} from '../lib/locale-currency.mjs';
  import {newLabels} from '../lib/new-labels.mjs';

  const languageMenu = document.querySelector<HTMLDetailsElement>('#language-menu')!;
  const currencyMenu = document.querySelector<HTMLDetailsElement>('#currency-menu')!;
  const languageLabel = document.querySelector<HTMLElement>('#current-language')!;
  const currencyLabel = document.querySelector<HTMLElement>('#current-currency')!;
  const languageButtons = [...languageMenu.querySelectorAll<HTMLButtonElement>('[data-language]')];
  const currencyButtons = [...currencyMenu.querySelectorAll<HTMLButtonElement>('[data-currency]')];
  const status = document.querySelector('#language-status')!;
  const attributes = ['placeholder', 'aria-label', 'alt', 'title'];
  const ignored = 'script, style, noscript, [translate="no"], [data-reference-price]';
  const textOriginals = new WeakMap<Text, string>();
  const knownCodes = new Set(languages.map(([code]) => code));
  const storageKey = 'lolobuy-edit-language';
  type Dictionary = Record<string, string>;
  let dictionary: Dictionary = {};
  let active = 'en';
  let requestId = 0;

  function translated(source: string) {
    const exact = Object.hasOwn(dictionary, source) ? dictionary[source] : undefined;
    if (exact) return exact;
    if (source.startsWith('Buy on ') && dictionary['Buy on ZZ1ZZ']) {
      return dictionary['Buy on ZZ1ZZ'].replace('ZZ1ZZ', source.slice(7));
    }
    const parts: string[] = [];
    const template = source.replace(/\d+(?:,\d{3})*/g, (part) => {
      parts.push(part);
      return 'ZZ' + parts.length + 'ZZ';
    });
    if (!parts.length || !dictionary[template]) return source;
    return dictionary[template].replace(/ZZ(\d+)ZZ/g, (_, i) => parts[Number(i) - 1] ?? '');
  }

  function apply(root: Node) {
    if (root instanceof Element) {
      if (root.closest(ignored)) return;
      for (const name of attributes) {
        const value = root.getAttribute(name);
        if (!value?.trim()) continue;
        // Remember the visible English label alongside the translated attribute.
        const originalName = 'data-source-' + name;
        const original = root.getAttribute(originalName) ?? value;
        const replacement = translated(original.trim());
        if (replacement !== value) {
          root.setAttribute(originalName, original);
          root.setAttribute(name, replacement);
        }
      }
    }
    if (root instanceof Text) {
      if (root.parentElement?.closest(ignored)) return;
      const original = textOriginals.get(root) ?? root.data;
      if (!original.trim()) return;
      const next = original.replace(/\S(?:[\s\S]*\S)?/, (trimmed) => translated(trimmed.replace(/\s+/g, ' ')));
      if (next !== root.data) {
        textOriginals.set(root, original);
        root.data = next;
      }
    }
    for (const child of root.childNodes) apply(child);
  }

  async function setLanguage(code: string, changeCurrency = false) {
    const id = ++requestId;
    try {
      let next = {};
      if (code !== 'en') {
        const response = await fetch('/data/languages/' + encodeURIComponent(code) + '.json');
        if (!response.ok) throw new Error('Translation unavailable');
        next = await response.json();
      }
      if (id !== requestId) return;
      dictionary = {...next, ...navigationLabels(code), ...newLabels(code)};
      active = code;
      document.documentElement.lang = code;
      document.documentElement.dir = code === 'ar' ? 'rtl' : 'ltr';
      languageLabel.lang = code;
      languageLabel.textContent = languages.find(([key]) => key === code)?.[1] ?? code;
      for (const button of languageButtons) button.setAttribute('aria-pressed', String(button.dataset.language === code));
      if (changeCurrency) updateShopping({currency: currencyForLanguage[code as keyof typeof currencyForLanguage]});
      status.textContent = '';
      apply(document.querySelector('title')!);
      apply(document.body);
      try { localStorage.setItem(storageKey, code); } catch {}
    } catch {
      if (id === requestId) {
        status.textContent = 'Could not load that language. Please try again.';
      }
    }
  }

  const observer = new MutationObserver((changes) => {
    if (active === 'en') return;
    for (const change of changes) {
      for (const node of change.addedNodes) apply(node);
    }
  });
  observer.observe(document.body, {childList: true, subtree: true});
  observer.observe(document.querySelector('title')!, {childList: true});

  function showCurrency() {
    const {currency} = shoppingOptions();
    currencyLabel.textContent = currency;
    for (const button of currencyButtons) button.setAttribute('aria-pressed', String(button.dataset.currency === currency));
  }

  languageMenu.addEventListener('click', (event) => {
    const choice = (event.target as Element).closest<HTMLButtonElement>('[data-language]');
    if (choice?.dataset.language && knownCodes.has(choice.dataset.language)) {
      languageMenu.open = false;
      languageMenu.querySelector('summary')?.focus();
      void setLanguage(choice.dataset.language, true);
    }
  });
  currencyMenu.addEventListener('click', (event) => {
    const choice = (event.target as Element).closest<HTMLButtonElement>('[data-currency]');
    if (!choice?.dataset.currency) return;
    updateShopping({currency: choice.dataset.currency});
    currencyMenu.open = false;
    currencyMenu.querySelector('summary')?.focus();
  });
  window.addEventListener('shopping-change', showCurrency);
  window.addEventListener('pageshow', showCurrency);
  showCurrency();
  try {
    const stored = localStorage.getItem(storageKey);
    if (stored === 'zh-Hant') void setLanguage('zh-Hans');
    else if (stored && knownCodes.has(stored) && stored !== 'en') void setLanguage(stored);
  } catch {}
</script>
