---
import '../styles.css';
import '../workspace.css';
import LanguagePicker from './LanguagePicker.astro';
import ShoppingMenu from './ShoppingMenu.astro';
import {registrationUrl} from '../lib/catalog.mjs';
import {indexablePaths, productionBuild, publicOrigin} from '../lib/production-seo.mjs';
const {title, description = 'Browse Weidian listings for LoloBuy and check available warehouse QC photos.', page = ''} = Astro.props;
const links = [
  ['/spreadsheet/', 'Spreadsheet', 'sheet'], ['/categories/', 'Categories', 'categories'],
  ['/image-search/', 'Photo search', 'image'],
  ['/guides/how-to-buy/', 'Buying guide', 'guide'], ['/faq/', 'FAQ', 'faq'],
];
const indexable = productionBuild && indexablePaths.includes(Astro.url.pathname);
const analyticsId = 'G-FZ8D1KV9T3';
const analyticsHost = new URL(publicOrigin).hostname;
---
<!doctype html>
<html lang="en">
<head>
  {productionBuild && (
    <>
      <meta name="msvalidate.01" content="E34A6C20A8A058592D1DC4B20523F6CB" />
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`}></script>
      <script is:inline define:vars={{analyticsId, analyticsHost}}>
        if (location.hostname === analyticsHost) {
          window.dataLayer = window.dataLayer || [];
          function gtag() { window.dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', analyticsId);
        }
      </script>
    </>
  )}
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {indexable ? <link rel="canonical" href={new URL(Astro.url.pathname, publicOrigin).href} /> : <meta name="robots" content="noindex, follow" />}
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.png" />
  <title>{title}</title>
</head>
<body data-page={page}>
  <a class="skip" href="#main">Skip to content</a>
  <header class="edit-header">
    <div class="wrap edit-head">
      <a class="edit-brand" href="/" aria-label="LoloBuy Findslist home"><img src="/assets/lolobuy-official.svg" width="116" height="28" alt="LoloBuy" /><span>Findslist</span></a>
      <nav aria-label="Main navigation">{links.map(([href, label, key]) => <a href={href} aria-current={key === page ? 'page' : undefined}>{label}</a>)}</nav>
      <div class="edit-head-actions"><LanguagePicker /><a class="button dark edit-join" href={registrationUrl} rel="sponsored noopener" target="_blank">Join LoloBuy</a></div>
    </div>
  </header>
  {page === 'sheet' && <div class="wrap edit-settings"><ShoppingMenu /></div>}
  <main id="main"><slot /></main>
  <footer class="edit-footer">
    <div class="wrap footer-inner">
      <div><a class="footer-brand" href="/">LoloBuy Findslist</a><p>An independent directory by FindSpreadsheet. Orders, payment and shipping are handled on LoloBuy. Some links contain referral codes.</p></div>
      <nav aria-label="Footer" class="footer-links"><a href="/saved/">Saved finds</a><a href="/guides/how-to-buy/">Buying guide</a><a href="/faq/">FAQ</a><a href="https://findspreadsheet.com/">FindSpreadsheet</a></nav>
    </div>
  </footer>
  <script>
    import {priceFor, shoppingOptions} from '../lib/shopping.mjs';
    import '../lib/choice-menu.mjs';
    function updateDisplayedPrices() {
      const {currency} = shoppingOptions();
      for (const node of document.querySelectorAll<HTMLElement>('[data-reference-price]')) {
        node.textContent = priceFor(node.dataset.referencePrice, currency);
      }
    }
    window.addEventListener('shopping-change', updateDisplayedPrices);
    window.addEventListener('pageshow', updateDisplayedPrices);
    updateDisplayedPrices();
  </script>
</body>
</html>
