---
import Layout from '../components/Layout.astro';
---
<Layout title="LoloBuy Image Search" page="image">
  <section class="wrap page visual-search-page">
    <p class="eyebrow">VISUAL PRODUCT SEARCH</p><h1>Image Search</h1>
    <p class="lead">Pick a product photo to find visually similar listings in the saved Findspreadsheet image index. The search runs in your browser and keeps the photo on your device.</p>
    <section class="photo-input" aria-labelledby="photo-input-title">
      <h2 id="photo-input-title" class="visually-hidden">Reference photo</h2>
      <div class="image-dropzone" id="image-dropzone">
        <label for="image-file" class="image-upload-label">
          <svg viewBox="0 0 32 32" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 21v5h20v-5M16 22V6m-6 6 6-6 6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <strong>Upload image</strong>
          <span>Drop an image here</span>
          <input id="image-file" class="visually-hidden" type="file" accept="image/*" aria-label="Upload image" disabled />
        </label>
      </div>
      <div class="photo-tools">
        <button class="button outline" type="button" id="image-example" disabled>Try a sample photo</button>
        <p class="result-status" id="image-status" role="status">Loading image search…</p>
      </div>
      <img id="image-preview" alt="Search reference photo" hidden />
    </section>
    <div class="product-grid" id="image-results"></div>
  </section>
</Layout>
<script>
  import '../lib/image-search.mjs';
</script>
