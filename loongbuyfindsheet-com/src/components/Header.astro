---
import languages from '../languages.json';
---
<header><a href="/" class="brand" aria-label="LoongBuy Findsheet home" data-i18n-ignore><img src="/assets/official-logo-header.svg" alt="LoongBuy"/><span>FINDSHEET</span></a><nav aria-label="Main navigation"><a href="/">Home</a><a href="/spreadsheet/">Spreadsheet</a><a href="/image-search/">Image Search</a><a href="/articles/">Articles</a><a href="/guides/">Guides</a><a href="/faq/">FAQ</a></nav><div class="header-actions"><details class="language-picker" id="language-picker" data-i18n-ignore><summary id="language-toggle" aria-label="Language" aria-controls="language-panel"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c5 5 5 13 0 18-5-5-5-13 0-18Z"/></svg><span id="current-language">English</span><span class="language-count">23</span><span class="language-chevron">⌄</span></summary><div class="language-panel" id="language-panel"><div class="language-panel-heading"><strong id="language-panel-label">Language</strong><span>23</span></div><div class="language-options">{languages.map(l=><button type="button" data-language={l.code} data-direction={l.dir} data-translation-note={l.note} aria-label={l.name+' — '+l.english} aria-pressed={l.code==='en'} lang={l.code}><span>{l.name}</span><small>{l.english}</small><i aria-hidden="true">✓</i></button>)}</div><p class="language-note" id="language-note" dir="auto">Choose your reading language.</p><p id="language-status" role="status" aria-live="polite"></p></div></details><a class="button small" href="https://loongbuy.com/register?code=BH6480" target="_blank" rel="noopener noreferrer">Buy It Now <svg class="arrow-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a></div></header><script src="/i18n.js?v=compact-reference-v3" is:inline defer></script>
