---
import { isIndexableSite, productionOrigin } from '../lib/seo.js';

const enabled = isIndexableSite(Astro.site);
const host = new URL(productionOrigin).hostname;
const measurementId = 'G-2PRPEFSYRH';
---
{enabled && Astro.url.pathname === '/' && (
  <meta name="msvalidate.01" content="E34A6C20A8A058592D1DC4B20523F6CB" />
)}
{enabled && (
  <script define:vars={{ host, measurementId }}>
    if (location.hostname === host || location.hostname === 'www.' + host) {
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', measurementId);

      const tag = document.createElement('script');
      tag.async = true;
      tag.src = 'https://www.googletagmanager.com/gtag/js?id=' + measurementId;
      document.head.append(tag);
      const itemData = () => {
        const root = document.getElementById('product-detail');
        if (!root?.dataset.weidianId) return null;
        return { item_id: root.dataset.weidianId, item_name: root.dataset.productName,
          price: Number(root.dataset.productPrice), quantity: 1 };
      };
      const trackProduct = () => {
        const item = itemData();
        if (item) window.gtag('event', 'view_item', { currency: 'USD', value: item.price, items: [item] });
      };
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', trackProduct, { once: true });
      else trackProduct();
      document.addEventListener('click', event => {
        const link = event.target.closest?.('a[href]');
        if (!link) return;
        const target = new URL(link.href, location.href);
        if (target.hostname === 'loongbuy.com' && target.pathname === '/product-details') {
          const original = target.searchParams.get('url');
          const itemId = original ? new URL(original).searchParams.get('itemID') : null;
          window.gtag('event', 'purchase_click', { item_id: itemId, agent: 'LoongBuy', link_url: target.href });
        } else if (link.closest('#platform-list')) {
          window.gtag('event', 'agent_click', { item_id: itemData()?.item_id, agent: link.textContent.trim(), link_url: target.href });
        }
      }, { capture: true });
      document.addEventListener('submit', event => {
        if (event.target.id !== 'hero-search') return;
        const query = new FormData(event.target).get('q');
        if (typeof query === 'string' && query.trim()) window.gtag('event', 'search', { search_term: query.trim().slice(0, 200) });
      }, { capture: true });

    }
  </script>
)}
