---
import Indexing from '../../components/Indexing.astro';
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import articles from '../../articles.json';
export function getStaticPaths(){return articles.map(article=>({params:{slug:article.slug},props:{article}}));}
const {article}=Astro.props;
const headings=[...article.body.matchAll(/<h2>(.*?)<\/h2>/g)].map((m,i)=>({label:m[1],id:'section-'+(i+1)}));let counter=0;const body=article.body.replace(/<h2>/g,()=>'<h2 id="section-'+(++counter)+'">');
const related=articles.filter(a=>a.slug!==article.slug).sort((a,b)=>Number(b.category===article.category)-Number(a.category===article.category)).slice(0,3);
const canonical = new URL('/articles/' + article.slug + '/', Astro.site).href;
const schema={'@context':'https://schema.org','@type':'Article',headline:article.title,description:article.description,datePublished:'2026-11-16',dateModified:'2026-11-16',keywords:article.keywords.join(', '),mainEntityOfPage:canonical,author:{'@type':'Organization',name:'LoongBuy Findsheet'},publisher:{'@type':'Organization',name:'LoongBuy Findsheet'}};
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{article.title} | LoongBuy Findsheet</title><meta name="description" content={article.description}/><Indexing /><meta property="og:title" content={article.title}/><meta property="og:description" content={article.description}/><meta property="og:type" content="article"/><link rel="icon" href="/assets/favicon.ico"/><script type="application/ld+json" set:html={JSON.stringify(schema)}/></head><body><Header/><main><section class="page-intro"><p class="eyebrow">{article.tag}</p><h1>{article.title}</h1><p>{article.description}</p><p class="article-meta">Reviewed November 16, 2026 · {article.read} · LoongBuy Findsheet</p></section><div class="reading-layout"><aside class="toc"><a href="/articles/">← All articles</a><p>ON THIS PAGE</p>{headings.map(h=><a href={'#'+h.id}>{h.label}</a>)}<a class="toc-next" href="/guides/how-to-buy/">Illustrated buying guide ↗</a></aside><article class="article-body"><Fragment set:html={body}/>{article.sources.length>0&&<section class="article-sources"><h2>Official references</h2><p>Read the current official information for the process or service discussed here.</p><ul>{article.sources.map(s=><li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label} ↗</a></li>)}</ul></section>}<div class="article-note"><strong>About this guide</strong><p>Independent editorial guidance. Platform options, prices and policies can change. This preview uses historical product data and has no access to private LoongBuy orders.</p></div><a class="button" href="/#spreadsheet">Explore the spreadsheet ↗</a></article></div><section class="section"><div class="section-heading"><h2>Keep exploring.</h2><a href="/articles/">All articles ↗</a></div><div class="article-grid">{related.map(a=><a class="article-card" href={'/articles/'+a.slug+'/'}><span>{a.tag}</span><h3>{a.title}</h3><p>{a.description}</p><b>Read next ↗</b></a>)}</div></section></main><Footer/></body></html>
