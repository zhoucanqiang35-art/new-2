---
import Indexing from '../../components/Indexing.astro';
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import articles from '../../articles.json';
const groups=[...new Set(articles.map(a=>a.category))];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>LoongBuy Articles — Spreadsheet, Shipping & QC Guides</title><meta name="description" content="Read LoongBuy spreadsheet guides on first orders, image search, QC, shipping costs, country checklists, warehouse tracking and agent comparisons."/><Indexing /><link rel="icon" href="/assets/favicon.ico"/></head><body><Header/><main><section class="page-intro"><p class="eyebrow">THE FINDSHEET FIELD NOTES</p><h1>LoongBuy articles.<br/><span class="gradient-text">Better-informed choices.</span></h1><p>From your first product search to your next parcel. Practical reading for every stage, with clear next steps.</p><div class="intro-pills"><span>12 in-depth articles</span><span>Illustrated buying guide</span><span>40 questions answered</span></div></section><section class="section"><div class="content-controls"><label class="content-search">Search articles<input id="article-search" type="search" placeholder="Try shipping, QC or first order…"/></label><div class="content-tabs" aria-label="Article categories"><button class="active" data-filter="all">All topics</button>{groups.map(g=><button data-filter={g}>{g}</button>)}</div></div><p id="article-count" class="filter-count">12 articles to explore</p><div class="article-grid">{articles.map((a,i)=><a class="article-card" data-article data-group={a.category} data-search={[a.title,a.description,...a.keywords].join(' ').toLowerCase()} href={'/articles/'+a.slug+'/'}><div class="article-art"><span>{String(i+1).padStart(2,'0')}</span><b>{a.tag}</b></div><span>{a.tag} · {a.read.toUpperCase()}</span><h3>{a.title}</h3><p>{a.description}</p><b>Read the article ↗</b></a>)}</div><p id="article-empty" hidden>No articles match. Try another topic or clear your search.</p></section><section class="section learning-banner"><div><p class="eyebrow">PREFER TO FOLLOW ALONG?</p><h2>Start with the illustrated guide.</h2><p>Actual Findsheet and official LoongBuy screens, one step at a time.</p></div><a class="button" href="/guides/how-to-buy/">Open the walkthrough ↗</a></section></main><Footer/><script is:inline>
(()=>{let group='all';const input=document.querySelector('#article-search'),cards=[...document.querySelectorAll('[data-article]')];function apply(){let n=0;const q=input.value.trim().toLowerCase();cards.forEach(c=>{c.hidden=!((group==='all'||c.dataset.group===group)&&(c.dataset.search+' '+c.textContent.toLowerCase()).includes(q));if(!c.hidden)n++;});document.querySelector('#article-count').textContent=n+(n===1?' article to explore':' articles to explore');document.querySelector('#article-empty').hidden=n!==0;document.querySelectorAll('[data-filter]').forEach(b=>{b.classList.toggle('active',b.dataset.filter===group);b.setAttribute('aria-pressed',String(b.dataset.filter===group));});}input.addEventListener('input',apply);document.addEventListener('site-language-changed',apply);document.querySelectorAll('[data-filter]').forEach(b=>b.addEventListener('click',()=>{group=b.dataset.filter;apply();}));})();
</script></body></html>
