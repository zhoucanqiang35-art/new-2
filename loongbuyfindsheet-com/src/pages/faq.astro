---
import Indexing from '../components/Indexing.astro';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import faqs from '../faqs.json';
const groups=[...new Set(faqs.map(f=>f.group))];
const schema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))};
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>LoongBuy FAQ — Buying, USD Prices, QC, Shipping & Tracking</title><meta name="description" content="Answers to 40 LoongBuy spreadsheet questions about product discovery, ordering, USD prices, image search, QC photos, shipping and warehouse tracking."/><Indexing /><link rel="icon" href="/assets/favicon.ico"/><script type="application/ld+json" set:html={JSON.stringify(schema)}/></head><body><Header/><main><section class="page-intro"><p class="eyebrow">A LITTLE CLARITY GOES A LONG WAY</p><h1>LoongBuy FAQ.<br/><span class="gradient-text">Useful answers.</span></h1><p>40 answers across the spreadsheet, buying process, image search, QC and shipping. Start with a topic or search a question.</p></section><section class="section faq-center"><label class="content-search">Search frequently asked questions<input id="faq-query" type="search" placeholder="Try USD, QC, shipping or product ID…"/></label><div class="content-tabs"><button class="active" data-faq-filter="all">All questions</button>{groups.map(g=><button data-faq-filter={g}>{g}</button>)}</div><p id="faq-count" class="filter-count">40 questions</p>{groups.map(group=><section data-faq-section class="faq-group"><h2>{group}</h2><div class="faq-list">{faqs.filter(f=>f.group===group).map(f=><details data-faq data-group={group} data-search={(f.q+' '+f.a).toLowerCase()}><summary>{f.q}<span>+</span></summary><p>{f.a}</p><a class="faq-readmore" href={'/articles/'+f.article+'/'}>Read the detailed guide ↗</a></details>)}</div></section>)}<p id="faq-empty" hidden>No matching question. Try another term or browse all topics.</p><div class="article-note"><strong>Need help with a private order?</strong><p>Use the official LoongBuy support flow and your order or parcel reference. This independent site cannot access your account or process refunds.</p><a href="https://www.loongbuy.com/m/help" target="_blank" rel="noopener">Official LoongBuy help ↗</a></div></section></main><Footer/><script is:inline>
(()=>{let group='all';const input=document.querySelector('#faq-query'),items=[...document.querySelectorAll('[data-faq]')];function apply(){let n=0;const q=input.value.trim().toLowerCase();items.forEach(d=>{d.hidden=!((group==='all'||d.dataset.group===group)&&(d.dataset.search+' '+d.textContent.toLowerCase()).includes(q));if(!d.hidden)n++;});document.querySelectorAll('[data-faq-section]').forEach(s=>s.hidden=![...s.querySelectorAll('[data-faq]')].some(d=>!d.hidden));document.querySelector('#faq-count').textContent=n+(n===1?' question':' questions');document.querySelector('#faq-empty').hidden=n!==0;document.querySelectorAll('[data-faq-filter]').forEach(b=>{b.classList.toggle('active',b.dataset.faqFilter===group);b.setAttribute('aria-pressed',String(b.dataset.faqFilter===group));});}input.addEventListener('input',apply);document.addEventListener('site-language-changed',apply);document.querySelectorAll('[data-faq-filter]').forEach(b=>b.addEventListener('click',()=>{group=b.dataset.faqFilter;apply();}));})();
</script></body></html>
