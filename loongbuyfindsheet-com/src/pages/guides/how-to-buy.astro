---
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const steps=[
{id:'find',n:'01',title:'Find a product on LoongBuy Findsheet',place:'ON THIS WEBSITE',body:'On the Findsheet homepage, enter 7872202082 in the search box and press Search. Open the matching item from the results. You can also start with a category, a product name or an image.',check:'Match the product ID rather than relying only on a shortened title.',image:'/assets/guide/guide-findsheet-search.jpg',alt:'Actual Findsheet search results for Weidian item ID 7872202082',caption:'Actual Findsheet preview capture · searched by the example product ID.'},
{id:'detail',n:'02',title:'Open the product and continue to LoongBuy',place:'ON THIS WEBSITE',body:'On the Findsheet product page, use the arrows or thumbnails to inspect the listing photos. Confirm the Weidian item ID, then choose Buy on LoongBuy. The button opens that same item on the official platform.',check:'The USD price is a historical reference conversion. It is not the final LoongBuy total.',image:'/assets/guide/guide-findsheet-detail.jpg',alt:'Findsheet product detail with photo 2 selected and the Buy on LoongBuy button',caption:'Findsheet product detail after switching to the second photo. Use the purchase button beside the gallery to continue.'},
{id:'variant',n:'03',title:'Check the current listing and choose specifications',place:'ON LOONGBUY.COM',body:'On the official product page, select a style under Shape, then select a size and check the quantity. The screenshot shows the first gray style in size M with quantity one. Verify the selected variant and current price before continuing.',check:'Review the terms and current order information yourself before proceeding with Add to Cart or Buy Now.',image:'/assets/guide/guide-official-specs.jpg',alt:'Actual official LoongBuy product page showing styles, sizes, quantity and purchase buttons',caption:'Official product page after selecting the gray style and size M. The displayed price is for this example selection.'},
{id:'login',n:'04',title:'Sign in on the official platform',place:'ON LOONGBUY.COM',body:'If you are not signed in, use the official Log In page. Existing users can use an available sign-in method; new users can use the registration option shown there. Complete account steps on LoongBuy, then return to the product selection when needed.',check:'Findsheet never asks for your LoongBuy password and cannot access your private account.',image:'/assets/guide/guide-official-login.jpg',alt:'Actual empty LoongBuy login form showing email, password and sign-in options',caption:'Official LoongBuy login screen with the fields left blank.'},
{id:'order',n:'05',title:'Review and pay for the selected goods',place:'YOUR PRIVATE LOONGBUY ACCOUNT',body:'Follow the official checkout, compare the item, variant and quantity, and review all charges shown before you decide to pay. The official shopping process describes product purchasing separately from international parcel shipping.',check:'This tutorial did not create an order or execute a payment. The checkout image is an example from the official public tutorial, not a payment made by us.',image:'/assets/guide/guide-official-payment.jpg',alt:'Official LoongBuy public tutorial example showing order confirmation, selected items and listed charges',caption:'Official public tutorial example · older order-confirmation interface. Amounts shown are examples.'},
{id:'qc',n:'06',title:'Follow the order and review warehouse photos',place:'YOUR PRIVATE LOONGBUY ACCOUNT',body:'Use your order and warehouse information to follow progress and review the photos associated with your items. Compare the selected product, quantity, size, color and visible condition. Ask a specific question if an important detail is unclear.',check:'This image is the official public tutorial’s warehouse example, not an order placed by this website. Its older interface may differ from your current account.',image:'/assets/guide/guide-official-qc.jpg',alt:'Warehouse information and QC photo area in the official public LoongBuy tutorial',caption:'Official public Shopping Process tutorial example · older account interface. Source linked below.'},
{id:'shipping',n:'07',title:'Prepare a parcel and compare the available quote',place:'YOUR PRIVATE LOONGBUY ACCOUNT',body:'The official process continues through warehouse parcel preparation, recipient information and the available shipping quotation. Check the contents and packing assumptions, compare the options shown for your parcel, and read the current terms before paying for international shipping.',check:'The rates and route labels in an old tutorial screenshot are examples, not current offers.',image:'/assets/guide/guide-official-shipping.jpg',alt:'Official LoongBuy tutorial example of shipping routes and optional packaging services',caption:'Official public tutorial example · current routes and charges must be checked in your own account.'},
{id:'track',n:'08',title:'Track the parcel and keep the right reference',place:'YOUR PRIVATE LOONGBUY ACCOUNT',body:'Use the parcel record and tracking entry for the shipment you submitted. Keep the order and parcel references together, record the last visible event, and contact official support with the correct reference if something needs clarification.',check:'The reference shown below is a public instructional example. Findsheet does not provide private order or parcel tracking.',image:'/assets/guide/guide-official-tracking.jpg',alt:'Official LoongBuy tutorial parcel-detail example highlighting the logistics tracking entry',caption:'Official public tutorial example · parcel details and logistics tracking entry.'}
];
