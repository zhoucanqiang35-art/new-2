import Indexing from '../../components/Indexing.astro';
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const paths=[{n:'01',title:'Your first order',desc:'Understand the handoff from Findsheet to LoongBuy, then follow the illustrated walkthrough.',links:[['First-order planning','/articles/loongbuy-beginner-guide/'],['Purchase guide with screenshots','/guides/how-to-buy/'],['Spreadsheet basics','/articles/loongbuy-spreadsheet-guide/']]},{n:'02',title:'Find the right product',desc:'Build a shortlist with categories, product IDs and photos. Compare the details before moving on.',links:[['Search the finds database','/articles/loongbuy-finds-database/'],['Image search tips','/articles/loongbuy-image-search/'],['Compare other purchasing agents','/articles/loongbuy-agent-comparison/']]},{n:'03',title:'Check the item',desc:'Separate listing photos from QC, identify visible concerns and keep your order references together.',links:[['Listing photos vs. QC','/articles/loongbuy-qc-photos/'],['A practical QC checklist','/articles/loongbuy-qc-checklist/'],['Returns and storage questions','/articles/loongbuy-returns-storage/']]},{n:'04',title:'Plan your parcel',desc:'Compare current quotes using the same parcel, address and assumptions, then follow the correct tracking stage.',links:[['Understand shipping costs','/articles/loongbuy-shipping-cost/'],['Compare shipping lines','/articles/loongbuy-shipping-lines/'],['Country preparation checklist','/articles/loongbuy-country-shipping/'],['Warehouse and tracking','/articles/loongbuy-warehouse-tracking/']]}];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>LoongBuy Guides — Buying Walkthrough, QC & Shipping</title><meta name="description" content="Follow a LoongBuy buying guide with real screenshots, then learn product search, QC checks, shipping quote comparisons and warehouse tracking."/><Indexing /><link rel="icon" href="/assets/favicon.ico"/></head><body><Header/><main><section class="page-intro"><p class="eyebrow">ONE USEFUL STEP AT A TIME</p><h1>LoongBuy guides.<br/><span class="gradient-text">Your next step, made clearer.</span></h1><p>Choose a learning path, or open the complete screenshot walkthrough from this website to the official LoongBuy shopping pages.</p><a class="button" href="/guides/how-to-buy/">Start the illustrated buying guide ↗</a></section><section class="section"><div class="learning-paths">{paths.map(p=><article class="learning-path"><span class="path-number">{p.n}</span><h2>{p.title}</h2><p>{p.desc}</p><ol>{p.links.map(([label,url])=><li><a href={url}>{label} <span>↗</span></a></li>)}</ol></article>)}</div></section><section class="section learning-banner"><div><p class="eyebrow">QUICK QUESTIONS, CLEAR ANSWERS</p><h2>Looking for one detail?</h2><p>Search 40 answers on prices, purchasing, photos, storage and shipping.</p></div><a class="button" href="/faq/">Explore the FAQ ↗</a></section></main><Footer/></body></html>
