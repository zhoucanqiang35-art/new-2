---
import Indexing from '../components/Indexing.astro';
import featured from '../featured.json';
import PilotProductLinks from '../components/PilotProductLinks.astro';
import { pilotPath } from '../lib/pilot-products.js';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import faqs from '../faqs.json';
import articles from '../articles.json';
import {usd} from '../lib/currency.js';
const buy=(id)=>'https://loongbuy.com/product-details?'+new URLSearchParams({url:'https://weidian.com/item.html?itemID='+id});
const cats=[['shoes','Shoes & sneakers'],['hoodies-sweaters','Hoodies'],['t-shirts','T-shirts'],['jackets','Jackets'],['pants-shorts','Pants & shorts'],['accessories','Accessories'],['jersey','Jerseys'],['electronics','Electronics'],['headwear','Headwear'],['ShortSets','Short sets'],['other-stuff','Other finds']];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>LoongBuy Spreadsheet — Finds, Buying Guides & QC</title><meta name="description" content="Explore LoongBuy spreadsheet finds across shoes, clothing and accessories. Browse FindSpreadsheet products and open the original item on LoongBuy."/><Indexing /><link rel="icon" href="/assets/favicon.ico"/></head><body class="home-page">
<Header />
<main>
<section class="hero gradient-hero"><div class="hero-copy"><p class="update-badge"><i></i> FindSpreadsheet catalog · 8,094 product finds</p><h1><span>Discover </span><span class="gradient-text">LoongBuy Spreadsheet</span><br/>Finds &amp; Shopping Guides</h1><p class="hero-description">Discover LoongBuy spreadsheet finds, explore product photos,<br/>and build your next haul with shoes, streetwear and everyday favorites.</p><div class="hero-actions"><a class="button" href="#spreadsheet">▦ LoongBuy Spreadsheet <svg class="arrow-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a><a class="button white" href="https://loongbuy.com/register?code=BH6480" target="_blank" rel="noopener">Buy It Now <svg class="arrow-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a></div><form class="search" id="hero-search"><span aria-hidden="true">⌕</span><input name="q" placeholder="Search shoes, hoodies, accessories…" aria-label="Search spreadsheet"/><a class="camera" id="image-open" href="/image-search/" aria-label="Search by image"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 7h4l2-3h6l2 3h4v13H3Z"/><circle cx="12" cy="13" r="4"/></svg></a><button class="search-submit" aria-label="Search"><svg class="arrow-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button></form><div class="hero-tags"><a href="/image-search/">Image Search</a><a href="#qc">QC Guide</a><a href="/guides/">Shopping Guides</a><a href="#spreadsheet">Spreadsheet</a></div></div></section><section class="stats-strip" aria-label="Catalog overview"><div><span>▦</span><strong>8,094</strong><p>Spreadsheet Finds</p></div><div><span>◈</span><strong>11</strong><p>Product Categories</p></div><div><span>⌕</span><strong>Image Search</strong><p>Find Similar Products</p></div><div><span>$</span><strong>USD</strong><p>Reference Prices</p></div></section>
<div class="trust-strip"><span>⌕ <strong>Find your style</strong> Search the spreadsheet</span><span>▧ <strong>Look closer</strong> Check listing & QC details</span><span>↗ <strong>Make it yours</strong> Buy directly on LoongBuy</span></div>
<section class="catalog section" id="spreadsheet"><div class="section-heading"><div><p class="eyebrow">THE GOOD STUFF, ALL IN ONE PLACE</p><h2>Find your next favorite<span class="orange">.</span></h2></div><span class="catalog-caption">YOUR STYLE. YOUR BUDGET. YOUR NEXT HAUL.</span></div><div class="category-tabs" role="group" aria-label="Product categories"><button class="active" data-cat="">All finds</button>{cats.map(([id,label])=><button data-cat={id}>{label}</button>)}</div><div class="catalog-toolbar"><p id="results-label">A selection from the FindSpreadsheet catalog</p><div><button class="text-button" id="search-toggle">⌕ Search</button><select id="sort" aria-label="Sort products"><option value="featured">Featured</option><option value="newest">Newest in snapshot</option><option value="low">Price: low to high</option><option value="high">Price: high to low</option></select></div></div><div class="catalog-query" hidden><input id="catalog-query" aria-label="Filter products" placeholder="Search by name or product ID…"/><button id="clear-search">Clear</button></div><div class="products" id="products" tabindex="0" role="region" aria-label="Spreadsheet Finds">{featured.map((p,i)=><article class="product-card"><a class="product-picture" href={pilotPath(p.id)}><img src={p.localImage||p.image} alt={p.name} loading="lazy"/><span class="product-number">0{i+1}</span><span class="product-arrow">↗</span></a><div class="card-meta"><span>{cats.find(c=>c[0]===p.category)?.[1]}</span><span>WEIDIAN</span></div><a class="product-name" data-product-title data-product-id={p.id} dir="auto" href={pilotPath(p.id)}>{p.name}</a><div class="card-bottom"><strong>{usd(p.price)}</strong><a href={buy(p.weidianId)} target="_blank" rel="noopener">Buy on LoongBuy ↗</a></div></article>)}</div><div class="pagination" id="pagination"><button class="outline" id="browse-all">Browse the spreadsheet <span>↗</span></button></div><p class="data-note"><a href="/products/">Browse selected finds by category</a></p><p class="data-note">Catalog · Historical FindSpreadsheet export. USD estimates use 1 USD = 6.6642 CNY (Nov 16, 2026). Confirm the current price and exchange rate on LoongBuy.</p></section>
<section class="guide section" id="how-it-works"><div class="guide-intro"><p class="eyebrow">FROM FIND TO FRONT DOOR</p><h2>Your first haul,<br/>a little simpler<span class="orange">.</span></h2><p>Use this spreadsheet to discover products. LoongBuy is where you place your order and manage the next steps.</p><a class="button" href="/guides/how-to-buy/">See the step-by-step buying guide ↗</a></div><div class="steps"><article><span>01</span><div><h3>Find something you like.</h3><p>Browse categories, search by name, or compare similar product images.</p></div><b>⌕</b></article><article><span>02</span><div><h3>Open it on LoongBuy.</h3><p>Choose “Buy on LoongBuy” to open the original Weidian item through the agent.</p></div><b>↗</b></article><article><span>03</span><div><h3>Check before you ship.</h3><p>Confirm options and costs on LoongBuy. Review your warehouse QC before arranging shipping.</p></div><b>✓</b></article></div></section>
<section class="qc section" id="qc"><div><p class="eyebrow">A CLOSER LOOK GOES A LONG WAY</p><h2>See the details.<br/>Shop with context.</h2><p>Product photos show the listing. QC photos show a particular inspected item. Check the product ID, size, color and visible details before you decide.</p></div><div class="qc-box"><span class="qc-icon">▧</span><h3>Find the original product</h3><p>Paste a Weidian link or item ID to find matching products in this preview.</p><form id="qc-search"><input aria-label="Weidian product link or ID" placeholder="Weidian link or item ID" required/><button class="button">Find product ↗</button></form><p class="data-note">Open a product to check whether FindSpreadsheet has QC photos for its Weidian item ID.</p></div></section>
<section class="faq section" id="faq"><div><p class="eyebrow">A FEW THINGS TO KNOW</p><h2>Before your<br/>first find<span class="orange">.</span></h2><p class="data-note" style="text-align:left">40 answers across buying, USD prices, image search, QC and shipping.</p><div class="detail-links"><a class="outline" href="/faq/">Explore all questions →</a></div></div><div class="faq-list">{[faqs[0],faqs[8],faqs[10],faqs[25],faqs[32],faqs[34]].map((f,i)=><details open={i===0}><summary>{f.q}<span>+</span></summary><p>{f.a}</p><a class="faq-readmore" href={'/articles/'+f.article+'/'}>Read more →</a></details>)}</div></section>
<section class="section article-feature"><p class="eyebrow">THE FINDSHEET FIELD NOTES</p><div class="section-heading"><h2>Make the next step a little clearer.</h2><a href="/articles/">Explore all 12 articles →</a></div><div class="article-grid" tabindex="0" role="region" aria-label="Articles">{[articles[3],articles[4],articles[8]].map(a=><a class="article-card" href={'/articles/'+a.slug+'/'}><span>{a.tag} · {a.read.toUpperCase()}</span><h3>{a.title}</h3><p>{a.description}</p><b>Read the guide →</b></a>)}</div></section><section class="last-cta"><div><p class="eyebrow">LESS SCROLLING. BETTER DISCOVERIES.</p><h2>Your next find is waiting.</h2></div><a href="#spreadsheet">Explore the spreadsheet <span>↗</span></a></section>
</main><Footer/>
<PilotProductLinks />
<script src="/app.js?v=featured-detail-v1" is:inline></script></body></html>
