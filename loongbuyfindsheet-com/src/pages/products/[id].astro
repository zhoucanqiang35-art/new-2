---
import Header from '../../components/Header.astro';
import Indexing from '../../components/Indexing.astro';
import { sellerPhotos, buyUrl } from '../../lib/pilot-products.js';
import { catalogProducts, categoryLabels } from '../../lib/catalog-products.js';
import { usd } from '../../lib/currency.js';
import '../../styles/global.css';

export function getStaticPaths() {
  return catalogProducts.map(product => ({ params: { id: product.id }, props: { product } }));
}
const { product } = Astro.props;
const photos = sellerPhotos(product);
const category = categoryLabels[product.category] || 'Product finds';
const description = `Compare seller photos, reference price and purchase options for ${product.name}, Weidian item ${product.weidianId}.`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{product.name} | LoongBuy Findsheet</title>
  <meta name="description" content={description} />
  <Indexing />
</head>
<body>
  <Header />
  <main>
    <nav class="section product-breadcrumb" aria-label="Product navigation"><a href="/spreadsheet/">Product spreadsheet</a><span aria-hidden="true">/</span><span>{category}</span></nav>
    <div id="product-detail" data-product-id={product.id} data-weidian-id={product.weidianId} data-product-name={product.name} data-product-price={usd(product.price).replace(/[^0-9.]/g,'')}>
      <div class="detail-layout">
        <div class="product-media">
          <div class="photo-stage"><a class="photo-open" href={photos[0]} target="_blank" rel="noopener"><img src={product.localImage || photos[0]} alt={product.name} fetchpriority="high" decoding="async" /></a></div>
          <div class="photo-thumbnails" aria-label="Product photo previews">{photos.map((url,index)=><a class="photo-thumbnail" href={url} target="_blank" rel="noopener"><img src={url} alt={product.name+' photo '+(index+1)} loading="lazy" decoding="async" /></a>)}</div>
        </div>
        <div class="detail-info">
          <p class="eyebrow">{category}</p>
          <h1>{product.name}</h1>
          <p>Weidian item {product.weidianId}</p>
          <p class="detail-price">{usd(product.price)} USD</p>
          <p>Reference price from the FindSpreadsheet catalog. Confirm the current price, options and availability on LoongBuy.</p>
          <div class="detail-links">
            <a class="button" href={buyUrl(product.weidianId)} target="_blank" rel="sponsored noopener">Buy on LoongBuy</a>
            <a class="outline" href={new URL(product.sourcePath, 'https://findspreadsheet.com').href} target="_blank" rel="noopener">View original listing</a>
          </div>
        </div>
      </div>
    </div>
    <section class="section product-listing-notes" aria-labelledby="listing-notes-title">
      <h2 id="listing-notes-title">About this listing</h2>
      <p>{product.name} is listed in {category.toLowerCase()} in the FindSpreadsheet catalog. This page refers to Weidian item {product.weidianId}; use this number to match the seller listing and any available inspection photos.</p>
      <dl><dt>Product</dt><dd>{product.name}</dd><dt>Category</dt><dd>{category}</dd><dt>Weidian item ID</dt><dd>{product.weidianId}</dd><dt>Catalog price</dt><dd>CN¥{Number(product.price).toFixed(2)} / approximately {usd(product.price)} USD</dd></dl>
      <p>The price shown is a catalog reference. Check the current price, sizes, colors and availability on LoongBuy before ordering. International shipping and optional services are quoted separately by the purchasing platform.</p>
      <p><a href="/guides/how-to-buy/">How to buy this item</a> · <a href="/articles/loongbuy-qc-checklist/">What to check in QC photos</a> · <a href="/browse/1/">Browse the complete product directory</a></p>
    </section>
  </main>
  <footer><p class="data-note">Independent recommendation site. Orders and payments are handled on loongbuy.com.</p></footer>
  <script src="/app.js?v=full-catalog-v5" is:inline></script>
</body>
</html>
