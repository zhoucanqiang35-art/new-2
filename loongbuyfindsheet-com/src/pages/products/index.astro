---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Indexing from '../../components/Indexing.astro';
import { pilotProducts, pilotPath } from '../../lib/pilot-products.js';
import { usd } from '../../lib/currency.js';
import '../../styles/global.css';

const categoryNames = {
  shoes: 'Shoes & sandals', 'hoodies-sweaters': 'Hoodies & sweaters', 't-shirts': 'T-shirts',
  jackets: 'Jackets', 'pants-shorts': 'Pants & shorts', accessories: 'Accessories',
  jersey: 'Jerseys', headwear: 'Headwear',
};
const categories = Object.groupBy(pilotProducts, item => item.category);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Selected Weidian Finds | LoongBuy Findsheet</title>
  <meta name="description" content="Compare photos and reference prices for selected Weidian products before opening them on LoongBuy." />
  <Indexing />
</head>
<body>
  <Header />
  <main class="section">
    <h1>Selected Weidian finds</h1><p><a href="/browse/1/">Browse all 8,087 product pages</a></p>
    <p>Compare the seller photos and reference prices before opening the exact listing on LoongBuy.</p>
    <nav class="category-tabs" aria-label="Selected product categories">
      {Object.keys(categories).map(category => <a href={'#' + category}>{categoryNames[category]}</a>)}
    </nav>
    {Object.entries(categories).map(([category, products]) => (
      <section id={category}>
        <h2>{categoryNames[category]}</h2>
        <div class="products">
          {products.map(product => (
            <article class="product-card">
              <a class="product-picture" href={pilotPath(product.id)}><img src={product.localImage || product.image} alt={product.name} loading="lazy" decoding="async" /></a>
              <h3><a class="product-name" href={pilotPath(product.id)}>{product.name}</a></h3>
              <p>{usd(product.price)} reference price</p>
            </article>
          ))}
        </div>
      </section>
    ))}
  </main>
  <Footer />
</body>
</html>
