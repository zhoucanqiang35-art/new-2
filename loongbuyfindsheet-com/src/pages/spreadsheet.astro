---
import featured from '../featured.json';
import { pilotPath } from '../lib/pilot-products.js';
import { usd } from '../lib/currency.js';
const buy=(id)=>'https://loongbuy.com/product-details?'+new URLSearchParams({url:'https://weidian.com/item.html?itemID='+id});
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Indexing from '../components/Indexing.astro';
import PilotProductLinks from '../components/PilotProductLinks.astro';
import '../styles/global.css';
const cats=[['shoes','Shoes & sneakers'],['hoodies-sweaters','Hoodies'],['t-shirts','T-shirts'],['jackets','Jackets'],['pants-shorts','Pants & shorts'],['accessories','Accessories'],['jersey','Jerseys'],['electronics','Electronics'],['headwear','Headwear'],['ShortSets','Short sets'],['other-stuff','Other finds']];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>LoongBuy Product Spreadsheet | Browse All Finds</title><meta name="description" content="Search LoongBuy finds by name or Weidian item ID, browse categories and compare reference prices."/><Indexing /><link rel="icon" href="/assets/favicon.ico"/></head><body><Header/><main><div class="page-intro"><p class="eyebrow">LOONGBUY FINDS</p><h1>Product spreadsheet</h1><p>Browse the full catalog. Search by product name or Weidian item ID.</p></div><section class="catalog section" id="spreadsheet"><div class="section-heading"><div><p class="eyebrow">THE GOOD STUFF, ALL IN ONE PLACE</p><h2>Find your next favorite<span class="orange">.</span></h2></div><span class="catalog-caption">YOUR STYLE. YOUR BUDGET. YOUR NEXT HAUL.</span></div><div class="category-tabs" role="group" aria-label="Product categories"><button class="active" data-cat="">All finds</button>{cats.map(([id,label])=><button data-cat={id}>{label}</button>)}</div><div class="catalog-toolbar"><p id="results-label">A selection from the FindSpreadsheet catalog</p><div><button class="text-button" id="search-toggle">⌕ Search</button><select id="sort" aria-label="Sort products"><option value="featured">Featured</option><option value="newest">Newest in snapshot</option><option value="low">Price: low to high</option><option value="high">Price: high to low</option></select></div></div><div class="catalog-query" hidden><input id="catalog-query" aria-label="Filter products" placeholder="Search by name or product ID…"/><button id="clear-search">Clear</button></div><div class="products" id="products" tabindex="0" role="region" aria-label="Spreadsheet Finds">{featured.map((p,i)=><article class="product-card"><a class="product-picture" href={pilotPath(p.id)}><img src={p.localImage||p.image} alt={p.name} loading="lazy"/><span class="product-number">0{i+1}</span><span class="product-arrow">↗</span></a><div class="card-meta"><span>{cats.find(c=>c[0]===p.category)?.[1]}</span><span>WEIDIAN</span></div><a class="product-name" data-product-title data-product-id={p.id} dir="auto" href={pilotPath(p.id)}>{p.name}</a><div class="card-bottom"><strong>{usd(p.price)}</strong><a href={buy(p.weidianId)} target="_blank" rel="noopener">Buy on LoongBuy ↗</a></div></article>)}</div><div class="pagination" id="pagination"><button class="outline" id="browse-all">Browse the spreadsheet <span>↗</span></button></div><p class="data-note"><a href="/products/">Browse selected finds by category</a></p><p class="data-note">Catalog · Historical FindSpreadsheet export. USD estimates use 1 USD = 6.6642 CNY (Nov 16, 2026). Confirm the current price and exchange rate on LoongBuy.</p></section></main><Footer/><PilotProductLinks/><script src="/app.js?v=compact-reference-v3" is:inline></script></body></html>