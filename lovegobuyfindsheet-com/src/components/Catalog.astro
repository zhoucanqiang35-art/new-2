---
import {readFileSync} from "node:fs";
import Icon from "./Icon.astro";
import {categories, categoryLabel, detailsUrl, featuredImage, highlighted, priceLabel, type Product} from "../lib/catalog";

import {homeFeatured} from "../lib/home-photos";
const {home = false} = Astro.props;
const products: Product[] = JSON.parse(readFileSync("public/data/catalog.json", "utf8"));
const highlights = (home ? homeFeatured : highlighted).flatMap(id => products.find(product => product.id === id) ?? []);
function photo(product: Product) {
  if (!home) return featuredImage(product);
  if (!highlighted.includes(product.id)) return product.image;
  const galleries = JSON.parse(readFileSync("public/data/gallery-" + product.weidianId.slice(0, 4) + ".json", "utf8"));
  return galleries[product.weidianId]?.[1] || product.image;
}
const displayCount = new Intl.NumberFormat("en").format(products.length);
---
  <section class="section shell catalog-section" id="catalog" aria-labelledby="catalog-title">
    <div class="section-heading"><div><h2 id="catalog-title">Explore the finds</h2><p>{displayCount} Weidian listings from the FindSpreadsheet preview catalog.</p></div><a class="button button-outline" href="/image-search/"><Icon name="image" size={18}/> Search by photo</a></div>
    <div class="catalog-controls">
      <div class="chips" aria-label="Filter by category">
        <button class="chip is-active" type="button" data-category="" aria-pressed="true">All finds</button>
        {categories.map(([key,label]) => <button class="chip" type="button" data-category={key} aria-pressed="false">{label}</button>)}
      </div>
      <label class="sort" for="sort"><span>Sort</span><select id="sort"><option value="featured">Featured</option><option value="latest">Latest added</option><option value="asc">Price low to high</option><option value="desc">Price high to low</option></select></label>
    </div>
    <div id="catalog-status" class="catalog-status" role="status" aria-live="polite"><span>Featured finds</span></div>
    <div id="results" class="products">
      {highlights.map(product => <article class="product-card"><a href={detailsUrl(product.weidianId)}><div class="product-image"><img src={photo(product)} alt="" width="320" height="320" loading="lazy" /></div><div class="product-copy"><span class="product-tag">{categoryLabel(product.category)}</span><h3 data-product-name={product.weidianId}>{product.name}</h3><span class="product-price"><span data-price-cny={product.price} data-i18n-ignore>{priceLabel(product.price)}</span> <b aria-hidden="true">↗</b></span></div></a></article>)}
    </div>
    <div id="pagination" class="pagination" hidden><button id="prev" class="button button-outline" type="button">← Previous</button><span id="pages"></span><button id="next" class="button button-outline" type="button">Next →</button></div>
    <noscript><p>Enable JavaScript to search and filter the full catalog.</p></noscript>
  </section>
<script>
  import "../lib/browse";
</script>
