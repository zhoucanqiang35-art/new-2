---
import {faqTopics} from "../lib/faq-content";
const {home = false} = Astro.props;
const Heading = home ? "h2" : "h1";
---
<section class:list={["shell", "section", "faq", {"home-faq": home}]} id="faq" aria-labelledby="faq-title">
  <div class="section-heading">
    <div>
      <Heading id="faq-title">LoveGoBuy spreadsheet FAQ</Heading>
      <p>Answers about Weidian finds, ordering, warehouse QC photos, USD prices and international shipping.</p>
    </div>
    {home && <a class="inline-arrow" href="/faq/">Open FAQ <span aria-hidden="true">↗</span></a>}
  </div>
  <div class="faq-topics">
    {faqTopics.map(topic => <details class="faq-topic" id={topic.id} open data-mobile-fold>
      <summary>{topic.title}</summary>
      <div class="faq-questions">
        {topic.entries.map(entry => <details id={entry.id} class="faq-question">
          <summary>{entry.question}</summary>
          {entry.answer.map(paragraph => <p>{paragraph}</p>)}
          <ul class="faq-links">
            {entry.links.map(link => {
              const external = link.href.startsWith("https://");
              return <li><a href={link.href} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined}>{link.label}</a></li>;
            })}
          </ul>
        </details>)}
      </div>
    </details>)}
  </div>
</section>
<script>
  import "../lib/mobile-folds";
</script>
