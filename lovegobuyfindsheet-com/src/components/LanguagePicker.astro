---
import languages from "../languages.json";
---
<div class="language-picker" data-i18n-ignore>
  <button id="open-language" class="button button-small button-outline language-button" type="button" aria-haspopup="dialog" aria-controls="language-dialog">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/></svg>
    <span id="current-language">English</span>
  </button>
  <dialog id="language-dialog" class="agent-dialog language-dialog" aria-labelledby="language-title">
    <div class="agent-dialog-header">
      <h2 id="language-title">Choose a language</h2>
      <form method="dialog"><button id="close-language" class="agent-close" type="submit" aria-label="Close language picker">×</button></form>
    </div>
    <div class="language-options">
      {languages.map(({code, name, dir}) => <button type="button" data-language={code} dir={dir} lang={code} aria-pressed={code === "en"}>{name}</button>)}
    </div>
    <p id="language-status" role="status" hidden></p>
  </dialog>
</div>
<script>
  import "../lib/language-picker";
</script>
