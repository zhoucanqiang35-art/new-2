---
import LanguagePicker from "./LanguagePicker.astro";
import SiteTracking from "./SiteTracking.astro";
import {isIndexableSite,isIndexablePath} from "../lib/seo.mjs";
import {registration} from "../lib/catalog";
import "../styles/style.css";
const {compactHome = false, title = "LoveGoBuy Spreadsheet | Findsheet", description = "Explore Weidian finds from FindSpreadsheet, search by photo, and open the original listing on LoveGoBuy."} = Astro.props;
const canonical = isIndexableSite(Astro.site) && isIndexablePath(Astro.url.pathname) ? new URL(Astro.url.pathname,Astro.site).href : undefined;
const navigation = [
  ["Home", "/"], ["Browse finds", "/browse/"], ["Image search", "/image-search/"],
  ["Buying guide", "/guide/how-to-buy/"], ["FAQ", "/faq/"], ["SEO", "/seo/"],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {canonical ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex, follow" />}
  <meta name="description" content={description} />
  <meta name="theme-color" content="#f8f9f5" />
  <link rel="icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Bricolage+Grotesque:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <title>{title}</title>
  <SiteTracking />
</head>
<body class:list={{"compact-home":compactHome}}>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="shell head-inner">
      <a class="wordmark" href="/" aria-label="LoveGoBuy Findsheet home">
        <img src="/lovegobuy-logo.png" width="146" height="27" alt="LoveGoBuy" />
        <span>FINDSHEET</span>
      </a>
      <nav aria-label="Main navigation">
        {navigation.map(([label, href]) => <a href={href} aria-current={Astro.url.pathname === href ? "page" : undefined}>{label}</a>)}
      </nav>
      <div class="head-actions">
        <LanguagePicker />
        <a class="button button-small" href={registration} rel="sponsored noopener" target="_blank">Join LoveGoBuy <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="site-footer">
    <div class="shell foot-inner">
      <div><a class="wordmark" href="/"><img src="/lovegobuy-logo.png" width="122" height="23" alt="LoveGoBuy" /><span>FINDSHEET</span></a><p>Independent shopping guide. Some outbound links are referral links.</p></div>
      <div><a href="/guide/how-to-buy/">Buying guide</a><a href="/faq/">FAQ</a><a href="https://findspreadsheet.com/">Catalog by FindSpreadsheet ↗</a><a href={registration} rel="sponsored noopener" target="_blank">Open LoveGoBuy ↗</a></div>
    </div>
    <p class="currency-attribution">Reference rates · 2026-11-24 · <a href="https://www.exchangerate-api.com" target="_blank" rel="noopener">Rates By Exchange Rate API</a></p>
  </footer>
</body>
</html>
