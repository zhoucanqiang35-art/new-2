---
import {readFileSync} from "node:fs";
import Layout from "../components/Layout.astro";
import Icon from "../components/Icon.astro";

const coverage = JSON.parse(readFileSync("public/data/visual-coverage.json", "utf8"));
const number = new Intl.NumberFormat("en-US");
---
<Layout title="LoveGoBuy Image Search | Find Products by Photo" description="Upload a reference photo and search Weidian listings using catalog covers, carousel photos and available warehouse QC images.">
  <section class="shell section image-search-page" aria-labelledby="image-search-title">
    <div class="content-heading">
      <h1 id="image-search-title">Search by image</h1>
      <p>Search {number.format(coverage.indexedImages)} catalog, carousel and warehouse QC photos across {number.format(coverage.coveredProducts)} listings.</p>
    </div>
    <div class="image-search-controls">
      <label class="upload" for="image-file"><Icon name="image" size={28}/><strong>Choose a photo</strong><span>Image file up to 12 MB</span><input id="image-file" type="file" accept="image/*" /></label>
      <figure id="image-preview" hidden><img alt="Your reference photo" width="128" height="128" /><figcaption></figcaption></figure>
    </div>
    <p class="muted">Your reference photo is processed in your browser.</p>
    <p id="image-status" class="catalog-status" role="status" aria-live="polite"></p>
    <div id="image-results" class="products" aria-label="Matching products"></div>
    <button id="image-more" class="button button-outline" type="button" hidden>Show more matches</button>
  </section>
</Layout>
<script>
  import "../lib/image-search";
</script>
