---
import {readFileSync} from "node:fs";
import Layout from "../components/Layout.astro";
import Icon from "../components/Icon.astro";
import {categories, categoryLabel, detailsUrl, featuredImage, highlighted, priceLabel, registration, type Product} from "../lib/catalog";

const products: Product[] = JSON.parse(readFileSync("public/data/catalog.json", "utf8"));
const highlights = highlighted.flatMap(id => products.find(p => p.id === id) ?? []);
const hero = highlights[0];
const selections = [["shoes","Shoes","4509"],["hoodies-sweaters","Hoodies","7366"],["accessories","Accessories","7980"],["jersey","Jerseys","7653"],["jackets","Jackets","8573"],["pants-shorts","Pants & shorts","8510"]];
const displayCount = new Intl.NumberFormat("en").format(products.length);
---
<Layout>
  <section class="hero shell" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="kicker"><span class="dot"></span> INDEPENDENT WEIDIAN FINDS</p>
      <h1 id="home-title">LoveGoBuy<br/><em>Spreadsheet.</em></h1>
      <p class="hero-desc">Discover sneakers, streetwear and everyday finds from FindSpreadsheet. Search the catalog, compare photos and open the listing on LoveGoBuy.</p>
      <form id="search-form" class="hero-search" action="/#catalog">
        <label class="visually-hidden" for="query">Search products or Weidian ID</label><Icon name="search" />
        <input type="search" id="query" name="q" placeholder="Search a product or Weidian ID" />
        <button class="button" type="submit">Search <Icon name="arrow" size={17} /></button>
      </form>
      <div class="hero-links">
        <button class="link-button" data-image-trigger type="button"><Icon name="image" /> Search by photo</button>
        <a href="/qc/"><Icon name="qc" /> Check QC photos</a>
      </div>
    </div>
    <a class="hero-feature" href={detailsUrl(hero.weidianId)}>
      <img src={featuredImage(hero)} alt={hero.name} width="720" height="720" fetchpriority="high" />
      <div class="feature-top"><span>FROM THE CATALOG</span><span class="feature-open" aria-hidden="true">↗</span></div>
      <div class="feature-caption"><div><span>WEIDIAN · SHOES</span><strong>{hero.name}</strong></div><span>{priceLabel(hero.price)}</span></div>
    </a>
  </section>
  <section class="section shell category-section" aria-labelledby="category-title">
    <div class="section-heading"><div><h2 id="category-title">Browse by category</h2><p>Start with a style or explore the full spreadsheet.</p></div><a class="inline-arrow" href="#catalog" data-category="">View all finds <Icon name="arrow" size={17}/></a></div>
    <div class="category-grid">
      {selections.map(([key,label,id]) => <a data-category={key} class="category-card" href={"/?category=" + key + "#catalog"}><img src={"/featured/" + id + ".webp"} alt="" width="240" height="190" loading="lazy" /><span>{label}<b aria-hidden="true">↗</b></span></a>)}
    </div>
  </section>
  <section class="section shell catalog-section" id="catalog" aria-labelledby="catalog-title">
    <div class="section-heading"><div><h2 id="catalog-title">Explore the finds</h2><p>{displayCount} Weidian listings from the FindSpreadsheet preview catalog.</p></div><button class="button button-outline" data-image-trigger type="button"><Icon name="image" size={18}/> Search by photo</button></div>
    <div class="catalog-controls">
      <div class="chips" aria-label="Filter by category">
        <button class="chip is-active" type="button" data-category="" aria-pressed="true">All finds</button>
        {categories.map(([key,label]) => <button class="chip" type="button" data-category={key} aria-pressed="false">{label}</button>)}
      </div>
      <label class="sort" for="sort"><span>Sort</span><select id="sort"><option value="featured">Featured</option><option value="latest">Latest added</option><option value="asc">Price low to high</option><option value="desc">Price high to low</option></select></label>
    </div>
    <div id="catalog-status" class="catalog-status" role="status" aria-live="polite"><span>Featured finds</span></div>
    <div id="results" class="products">
      {highlights.map(product => <article class="product-card"><a href={detailsUrl(product.weidianId)}><div class="product-image"><img src={featuredImage(product)} alt="" width="320" height="320" loading="lazy" /></div><div class="product-copy"><span class="product-tag">{categoryLabel(product.category)}</span><h3>{product.name}</h3><span class="product-price">{priceLabel(product.price)} <b aria-hidden="true">↗</b></span></div></a></article>)}
    </div>
    <div id="pagination" class="pagination" hidden><button id="prev" class="button button-outline" type="button">← Previous</button><span id="pages"></span><button id="next" class="button button-outline" type="button">Next →</button></div>
    <noscript><p>Enable JavaScript to search and filter the full catalog.</p></noscript>
  </section>
  <section class="guide" id="guide" aria-labelledby="guide-title">
    <div class="shell section">
      <div class="section-heading"><div><h2 id="guide-title">How to buy with LoveGoBuy</h2><p>From a product find to your LoveGoBuy warehouse.</p></div><a class="button" href={registration} target="_blank" rel="sponsored noopener">Join LoveGoBuy ↗</a></div>
      <div class="guide-grid">
        <article><Icon name="search" size={25}/><h3>Find your item</h3><p>Search by name, Weidian ID or a reference photo, then compare the available product images.</p></article>
        <article><Icon name="qc" size={25}/><h3>Look for warehouse photos</h3><p>Check the QC section on a listing or paste its link into <a href="/qc/">QC Finder</a> to see the preview’s verified coverage.</p></article>
        <article><Icon name="box" size={25}/><h3>Open it on LoveGoBuy</h3><p>Confirm the seller options, current item price and shipping estimates before ordering.</p></article>
      </div>
    </div>
  </section>
  <section class="shell section faq" aria-labelledby="faq-title">
    <h2 id="faq-title">Questions about the spreadsheet</h2>
    <details><summary>What is the LoveGoBuy spreadsheet?</summary><p>It is a searchable guide to Weidian listings from FindSpreadsheet. Each detail page includes the product references and an official LoveGoBuy link.</p></details>
    <details><summary>How does image search work?</summary><p>The preview compares an uploaded photo with catalog images using visual similarity. Your image is processed in your browser.</p></details>
    <details><summary>Where do prices and QC photos come from?</summary><p>Catalog prices are snapshot prices in Chinese yuan. QC photos, where included, come from FindSpreadsheet’s warehouse-photo feed. The purchase page shows the current listing details.</p></details>
  </section>
  <dialog id="image-dialog" aria-labelledby="image-title">
    <div class="dialog-head"><h2 id="image-title">Search by photo</h2><form method="dialog"><button class="close" aria-label="Close">×</button></form></div>
    <p>Choose a product photo. The search runs on this device.</p>
    <label class="upload"><Icon name="image" size={27}/><span>Choose an image</span><input id="image-file" type="file" accept="image/*" /></label>
    <p id="image-status" role="status"></p>
  </dialog>
</Layout>
<script>
  import "../lib/browse";
</script>
