---
import Layout from "../components/Layout.astro";
---
<Layout title="Product details | LoveGoBuy Findsheet">
  <section class="shell section content-heading"><h1>Product details</h1><p id="legacy-status">Choose a product from the catalog.</p><a class="button" href="/browse/">Browse finds</a></section>
</Layout>
<script>
  const query = new URLSearchParams(location.search);
  const id = query.get("id");
  if (id && /^\d{5,20}$/.test(id)) {
    query.delete("id");
    const suffix = query.toString();
    location.replace("/product/" + encodeURIComponent(id) + "/" + (suffix ? "?" + suffix : "") + location.hash);
  }
</script>
