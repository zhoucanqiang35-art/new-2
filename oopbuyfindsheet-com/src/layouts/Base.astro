---
const { title = 'OopBuy Spreadsheet — Finds, links & guides' } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>{!Astro.url.pathname.startsWith("/product/") && <link rel="canonical" href={new URL(Astro.url.pathname, "https://oopbuyfindsheet.com").href} />}<title>{title}</title><meta name="description" content="Explore OopBuy spreadsheet finds and product research with FindSpreadsheet."/><link rel="preconnect" href="https://findspreadsheet.com"/><style is:global is:inline>
:root{--ink:#162723;--green:#183f36;--lime:#d9f079;--cream:#f7f8f2;--line:#dce3d8}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,sans-serif;color:var(--ink);background:var(--cream)}a{color:inherit;text-decoration:none}button,input{font:inherit}.bar{background:#173c32;color:#e8f4c4;text-align:center;padding:9px;font-size:11px;letter-spacing:.1em}.wrap{width:min(1240px,calc(100% - 64px));margin:auto}.head{height:76px;display:flex;align-items:center;gap:42px}.logo{font-size:23px;font-weight:900;letter-spacing:-1.6px;color:#173c32;white-space:nowrap}.logo b{color:#7f9947}.nav{display:flex;gap:30px;margin:auto;font-size:13px;font-weight:650}.nav a:hover{text-decoration:underline}.smallbtn{border:1px solid #b8c8b7;border-radius:100px;padding:12px 19px;font-size:12px;font-weight:700}.hero{background:#e8f0dc;border-radius:24px;overflow:hidden;position:relative;min-height:475px;display:flex;align-items:center}.hero-content{padding:64px 7%;position:relative;z-index:1;width:70%}.pill{font-size:11px;letter-spacing:.14em;font-weight:800;color:#496b4d;text-transform:uppercase;display:flex;align-items:center;gap:9px}.pill:before{content:'';width:8px;height:8px;border-radius:100%;background:#88a943}h1{font-size:clamp(45px,6.2vw,84px);line-height:1.01;letter-spacing:-.065em;margin:22px 0;font-weight:750}h1 em{font-family:Georgia,serif;font-weight:400;color:#678b58}p{line-height:1.7}.intro{font-size:16px;color:#53685a;max-width:530px;margin-bottom:26px}.search{display:flex;background:#fff;border-radius:100px;padding:6px;max-width:560px;box-shadow:0 12px 36px #284d2110}.search input{min-width:0;border:0;outline:0;background:none;flex:1;padding:12px 18px;font-size:14px}.search button,.btn{background:var(--green);color:white;border:0;border-radius:100px;padding:15px 25px;font-size:13px;font-weight:700;cursor:pointer;display:inline-block}.hero-foot{font-size:12px;color:#6a7a67;margin-top:17px}.art{position:absolute;right:4%;top:8%;width:34%;height:84%;border-radius:180px 180px 20px 20px;background:#bdce9d;overflow:hidden;transform:rotate(3deg)}.art img{width:100%;height:100%;object-fit:cover;mix-blend-mode:multiply;opacity:.9}.art-label{position:absolute;right:3%;bottom:12%;background:#fff;border-radius:15px;padding:16px 22px;box-shadow:0 12px 30px #314c2730;z-index:2;font-size:11px;line-height:1.5}.art-label b{display:block;font-size:16px}.strip{display:flex;justify-content:space-between;gap:20px;border-bottom:1px solid var(--line);padding:25px 3px;color:#53665a;font-size:12px;font-weight:650}.dot{color:#8cab55;margin-right:8px}.section{padding:76px 0 6px}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:25px}.overline{text-transform:uppercase;color:#789661;font-size:10px;letter-spacing:.17em;font-weight:800}.section h2{font-size:clamp(30px,4vw,48px);letter-spacing:-.05em;margin:10px 0 4px}.section-head p{color:#718077;font-size:13px;margin:0}.more{font-size:12px;font-weight:750;border-bottom:1px solid #a5b6a3;padding-bottom:6px}.category-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:12px}.cat{background:#fff;border:1px solid #ebeee7;border-radius:15px;min-height:124px;padding:20px;display:flex;flex-direction:column;justify-content:space-between;transition:.2s}.cat:hover,.product:hover{transform:translateY(-4px)}.cat small{color:#a1b19c;font-size:11px}.cat span{font-weight:700;font-size:14px}.cat i{font-style:normal;float:right;color:#83a171}.products{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.product{transition:.2s}.picture{height:300px;background:#ebeee8;border-radius:16px;overflow:hidden;position:relative}.picture img{width:100%;height:100%;object-fit:cover}.badge{position:absolute;top:15px;left:15px;background:#fff;border-radius:30px;padding:7px 11px;font-size:10px;font-weight:750}.productmeta{display:flex;justify-content:space-between;padding:16px 2px 0}.productmeta small{font-size:10px;letter-spacing:.12em;color:#849481;font-weight:700}.productmeta h3{font-size:16px;margin:7px 0}.arrow{background:#e0ead3;width:36px;height:36px;border-radius:50%;display:grid;place-items:center}.guide{background:#193c32;color:#fff;border-radius:23px;margin:80px 0 0;padding:55px;display:flex;gap:40px;justify-content:space-between;align-items:center}.guide h2{font-size:38px;line-height:1.1;letter-spacing:-.045em;margin:14px 0}.guide p{color:#c4d6c5;max-width:520px;font-size:14px}.guide .btn{background:var(--lime);color:#1d3828;white-space:nowrap}.faq{display:grid;grid-template-columns:1fr 1fr;gap:50px;padding:80px 0}.faq h2{font-size:36px;letter-spacing:-.05em;margin:10px 0}.faq details{border-bottom:1px solid var(--line);padding:20px 0}.faq summary{cursor:pointer;font-size:14px;font-weight:700}.faq details p{font-size:13px;color:#68796d}.footer{border-top:1px solid var(--line);padding:35px 0 45px;color:#7a897d;font-size:12px}.footline{display:flex;justify-content:space-between;gap:20px;align-items:center}.notice{font-size:11px;margin-top:15px}.example{margin-top:18px;color:#657c67;font-size:12px}.example a{text-decoration:underline} @media(max-width:760px){.wrap{width:calc(100% - 32px)}.head{height:65px;gap:10px;justify-content:space-between}.nav{display:none}.smallbtn{padding:10px 14px}.hero{min-height:500px;align-items:flex-start}.hero-content{padding:43px 25px;width:100%}h1{font-size:49px}.intro{font-size:14px;max-width:85%}.art{top:auto;bottom:0;right:4%;height:180px;width:42%;border-radius:100px 100px 0 0}.art-label{bottom:20px;right:38%;padding:10px}.search{max-width:100%}.search button{padding:12px 17px}.strip{font-size:10px;flex-wrap:wrap}.section{padding-top:52px}.section-head{align-items:start;gap:15px}.category-grid{grid-template-columns:repeat(3,1fr)}.cat{min-height:100px;padding:14px}.products{grid-template-columns:repeat(2,1fr)}.product:last-child{display:none}.picture{height:220px}.guide{padding:28px;display:block;margin-top:55px}.guide h2{font-size:31px}.guide .btn{margin-top:10px}.faq{grid-template-columns:1fr;gap:5px;padding:55px 0}.footline{align-items:start;flex-direction:column}}
</style><style is:global is:inline>
.nav{gap:20px}.head{gap:18px}.language{border:1px solid #b8c8b7;border-radius:50px;background:transparent;padding:10px;font-size:12px;color:#173c32;max-width:110px}.page{padding:64px 0 90px;min-height:65vh}.page h1{font-size:clamp(38px,5vw,64px)}.pageintro{color:#68796d;max-width:760px}.data-note{padding:14px 18px;background:#edf3e5;border-radius:10px;color:#506a4e;font-size:13px}.listing{display:grid;grid-template-columns:repeat(4,1fr);gap:22px 16px;margin-top:26px}.listing .picture{height:230px}.listbar{display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin-top:25px}.listbar input,.listbar select{background:white;border:1px solid #d9e3d4;border-radius:10px;padding:12px}.pagination{display:flex;justify-content:center;align-items:center;gap:16px;margin-top:30px}.pagination button{border:1px solid #b8c8b7;background:#fff;border-radius:40px;padding:10px 18px;cursor:pointer}.article-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.article{background:#fff;border:1px solid #e2e9dd;border-radius:16px;padding:25px;line-height:1.6}.article h2{font-size:20px}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.mobile-nav{display:none}.mobile-links{display:flex;gap:14px;overflow:auto;white-space:nowrap;padding:0 0 12px;font-size:12px}.mobile-links a{font-weight:700}.missing{color:#52685a}.product-card-title{font-weight:700;font-size:14px;line-height:1.4}.sku{color:#718077;font-size:11px}.listing img{object-fit:cover}.listing a{display:block}@media(max-width:760px){.mobile-nav{display:block}.listing{grid-template-columns:repeat(2,1fr)}.listing .picture{height:190px}.article-grid,.steps{grid-template-columns:1fr}.head{gap:8px}.logo{font-size:18px}.smallbtn{font-size:10px}.language{max-width:90px;padding:8px;font-size:11px}.page{padding:35px 0 70px}}
</style><link rel="stylesheet" href="/premium.css"/><script is:inline src="/eu-languages.js" defer></script><script is:inline src="/category-content.js" defer></script><script is:inline src="/category-advice.js" defer></script><script is:inline src="/extended-content.js" defer></script><script is:inline src="/research-content.js" defer></script><script is:inline src="/faq-more.js" defer></script><script is:inline src="/featured-translations.js" defer></script><script is:inline src="/export-translations.js" defer></script><script is:inline src="/ui-translations.js" defer></script><script is:inline src="/product-title-translations.js" defer></script><script is:inline src="/official-guide-i18n.js" defer></script><script is:inline src="/fi-translations.js" defer></script><script is:inline src="/extra-languages.js" defer></script><script is:inline src="/seo-article-translations.js" defer></script><script is:inline src="/additional-language-draft.js" defer></script><script is:inline src="/additional-language-content.js" defer></script><script is:inline src="/additional-faq-translations.js" defer></script><script is:inline src="/additional-faq-translations-2.js" defer></script><script is:inline src="/additional-faq-translations-3.js" defer></script><script is:inline src="/additional-guide-translations.js" defer></script><script is:inline src="/additional-guide-translations-2.js" defer></script><script is:inline src="/additional-seo-translations.js" defer></script><script is:inline src="/additional-guide-research.js" defer></script><script is:inline src="/additional-category-tips.js" defer></script><script is:inline src="/additional-category-copy.js" defer></script><script is:inline src="/additional-category-advice.js" defer></script><script is:inline src="/additional-page-batch.js" defer></script><script is:inline src="/additional-page-batch-2.js" defer></script><script is:inline src="/additional-page-batch-3.js" defer></script><script is:inline src="/additional-page-batch