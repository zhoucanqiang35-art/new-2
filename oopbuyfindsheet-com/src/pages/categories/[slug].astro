---
import Base from '../../layouts/Base.astro';
import {categories} from '../../data/categories.js';
import {details} from '../../data/category-details.js';
import advice from '../../data/category-advice.json';
export function getStaticPaths(){return categories.map(([slug,en,zh])=>({params:{slug},props:{en,zh}}))}
const {en,zh}=Astro.props;const slug=Astro.params.slug;const detail=details[slug];
---
<Base title={`${en} — OopBuy Findsheet`}><main class="wrap page"><a class="more" href="/categories/" data-i18n="back_categories">← All categories</a><h1 data-en={en} data-zh={zh}>{en}</h1><p class="pageintro" data-i18n="category_intro">Browse this category from the FindSpreadsheet catalog.</p><a class="btn view-category" href={`/finds/?category=${encodeURIComponent(slug)}#listing`} data-i18n="view_products">View products in this category ↗</a><section class="category-guide" aria-label="Category details" data-i18n-aria-label="ui_category_details"><div class="category-guide-title"><div class="overline" data-i18n="category_details">CATEGORY DETAILS</div><h2 data-i18n="category_checklist">What to check before ordering</h2></div><div class="category-guide-grid"><article><h3 data-i18n="materials_label">Materials & details</h3><p data-category-detail={slug} data-en={detail.en} data-zh={detail.zh}>{detail.en}</p></article><article><h3 data-i18n="weight_label">Weight & packing</h3><p data-category-advice={slug} data-advice-kind="weight" data-en={advice[slug].en.weight} data-zh={advice[slug].zh.weight}>{advice[slug].en.weight}</p></article><article><h3 data-i18n="shipping_label">Shipping & fees</h3><p data-category-advice={slug} data-advice-kind="shipping" data-en={advice[slug].en.shipping} data-zh={advice[slug].zh.shipping}>{advice[slug].en.shipping}</p></article></div><p class="category-note" data-i18n="category_note">Material, actual weight and shipping cost are not supplied in this catalog snapshot; confirm the specific product details before ordering.</p></section></main></Base>
