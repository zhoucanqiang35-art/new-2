---
import Base from '../../layouts/Base.astro';
import {categories} from '../../data/categories.js';
import {details} from '../../data/category-details.js';
import advice from '../../data/category-advice.json';
---
<Base title="Browse categories — OopBuy Findsheet"><main class="wrap page categories-page"><div class="overline" data-i18n="cat_eyebrow">Find your direction</div><h1 data-i18n="categories">Categories</h1><p class="pageintro" data-i18n="categories_intro">Explore categories from the FindSpreadsheet catalog.</p><section class="category-overview"><div class="overline" data-i18n="category_details">CATEGORY DETAILS</div><h2 data-i18n="category_checklist">What to check before ordering</h2><div class="category-overview-grid">{categories.map(([slug,en,zh])=><article class="category-overview-card" id={`category-detail-${slug}`}><h3 data-en={en} data-zh={zh} data-category-name={slug}>{en}</h3><h4 data-i18n="materials_label">Materials & details</h4><p data-category-detail={slug} data-en={details[slug].en} data-zh={details[slug].zh}>{details[slug].en}</p><h4 data-i18n="weight_label">Weight & packing</h4><p data-category-advice={slug} data-advice-kind="weight" data-en={advice[slug].en.weight} data-zh={advice[slug].zh.weight}>{advice[slug].en.weight}</p><h4 data-i18n="shipping_label">Shipping & fees</h4><p data-category-advice={slug} data-advice-kind="shipping" data-en={advice[slug].en.shipping} data-zh={advice[slug].zh.shipping}>{advice[slug].en.shipping}</p></article>)}</div><p class="category-note" data-i18n="category_note">Material, actual weight and shipping cost are not supplied in this catalog snapshot; confirm the specific product details before ordering.</p></section></main></Base>
