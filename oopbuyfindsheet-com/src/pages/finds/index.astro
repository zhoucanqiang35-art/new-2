---
import Base from '../../layouts/Base.astro';
import CategoryNav from '../../components/CategoryNav.astro';
---
<Base title="Finds — OopBuy Findsheet"><main class="wrap page"><div class="finds-header"><div><div class="overline" data-i18n="finds_eyebrow">Worth a closer look</div><h1 data-i18n="finds">Featured finds</h1><p class="pageintro" data-i18n="all_intro">Browse all products in the FindSpreadsheet catalog snapshot.</p></div><div class="finds-search-wrap"><form class="finds-search" role="search" id="finds-search" action="/finds/" method="get"><label class="sr-only" for="top-search" data-i18n="search">Search ↗</label><input id="top-search" name="q" type="search" placeholder="Search products, brands or styles..." data-i18n-placeholder="search_placeholder" aria-label="Search products" data-i18n-aria-label="ui_search"/><button type="button" class="image-search-trigger" data-image-search-trigger aria-controls="finds-image-search-status" aria-label="Image search is not available yet." title="Image search is not available yet."><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h3l1.5-2h7L17 7h3a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1Z"/><circle cx="12" cy="13" r="3.2"/></svg></button><button type="submit" data-i18n="search">Search ↗</button></form><p id="finds-image-search-status" class="image-search-status" data-image-search-status role="status" hidden>Image search is not available yet.</p></div></div><div class="overline" data-i18n="browse_categories">BROWSE ALL CATEGORIES</div><CategoryNav/><div class="data-note" data-i18n="snapshot">FindSpreadsheet catalog exported 10 November 2026. Listings and prices may have changed.</div><div class="listbar"><input id="filter" type="search" placeholder="Filter products" data-i18n-placeholder="filter" aria-label="Filter" data-i18n-aria-label="ui_filter"/><select id="sort" aria-label="Sort" data-i18n-aria-label="ui_sort"><option value="source" data-i18n="sort_source">Source order</option><option value="price-low" data-i18n="sort_low">Price: low to high</option><option value="price-high" data-i18n="sort_high">Price: high to low</option></select><span id="count" class="sku"></span></div><div id="listing" class="listing" data-category="all" aria-live="polite"></div><div class="pagination"><button id="previous" data-i18n="previous">Previous</button><span id="page-number"></span><button id="next" data-i18n="next">Next</button></div><p class="sku" data-i18n="price_note">USD prices are from FindSpreadsheet at export. Confirm the current price on OopBuy.</p></main><script is:inline src="/catalog.js" defer></script></Base>
