---
import Base from '../../layouts/Base.astro';
---
<Base title="Image search — OopBuy Findsheet"><main class="wrap page image-search-page"><div class="overline">OOPBUY FINDS</div><h1 id="image-page-title">Image search</h1><p id="image-page-intro" class="pageintro">Choose a product image to find visually similar products. Your image stays in your browser.</p><section class="image-upload-panel"><img id="image-upload-preview" class="image-upload-preview" alt="" hidden/><div><button class="btn image-upload-button" type="button" data-image-search-trigger>Choose an image</button><p id="image-upload-name" class="image-file-name"></p><small>JPG · PNG · WebP · 15 MB</small></div></section><section class="image-page-results" id="results" aria-live="polite"><p id="image-results-count" class="image-results-count"></p><h2 id="image-page-heading">Visually similar products</h2><p id="image-page-note" class="image-results-count"></p><div id="image-page-grid" class="listing"></div></section></main><style is:global>.image-search-page{max-width:1120px}.image-search-page>h1{font-size:clamp(38px,5vw,60px);margin:12px 0}.image-search-page>.pageintro{max-width:700px;line-height:1.7}.image-upload-panel{display:flex;align-items:center;gap:24px;padding:32px;margin:28px 0 40px;min-height:170px;border:2px dashed #c8d5c5;border-radius:14px;background:#f9fbf7}.image-upload-preview{width:110px;height:110px;object-fit:cover;border-radius:10px;background:#edf1e9}.image-upload-button{border:0;cursor:pointer}.image-file-name,.image-upload-panel small,.image-results-count{font-size:12px;color:#637469}.image-page-results{border-top:1px solid #dce6d8;padding-top:16px}.image-page-results h2{font-size:27px;margin:18px 0 8px}.image-page-results .listing{margin-top:24px}.image-page-results .picture{aspect-ratio:1;height:auto}.image-page-results .picture img{width:100%;height:100%;object-fit:cover}.image-results{margin-top:28px}@media(max-width:600px){.image-upload-panel{padding:20px;gap:15px;min-height:130px}.image-upload-preview{width:84px;height:84px}.image-page-results h2{font-size:23px}}</style><script is:inline src="/image-search-page.js" defer></script></Base>
