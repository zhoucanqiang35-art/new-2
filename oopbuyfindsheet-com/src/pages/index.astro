---
import FaqList from "../components/FaqList.astro";
import Base from "../layouts/Base.astro";
import {categories} from "../data/categories.js";
import {details as categoryDetails} from "../data/category-details.js";

const products = [
 {name:'Cotton-Wreath Print Denim Jacket and Jeans Collection', category:'JACKETS', image:'https://findspreadsheet.com/uploads/allimg/20261009/1-261009114A1119.webp', href:'/product/?id=8573'},
 {name:'Letter-Print T-Shirt Collection', category:'T-SHIRTS', image:'https://findspreadsheet.com/uploads/allimg/20261007/1-26100G23410938.webp', href:'/product/?id=8389'},
 {name:'Boxed Boxer Briefs - CXS-10192', category:'PANTS & SHORTS', image:'https://findspreadsheet.com/uploads/allimg/20261010/1-261010152Z9411.jpg', href:'/product/?id=8789'},
];


---
<Base><main class="wrap home-wrap"><section class="editorial-masthead"><div class="masthead-copy"><div class="overline" data-i18n="eyebrow">Your next great find starts here</div><h1>OopBuy<br/><em data-i18n="hero_spreadsheet">Spreadsheet.</em></h1><p class="intro" data-i18n="hero_desc">Discover product finds, browse categories and get ready to shop with confidence. Your starting point, powered by FindSpreadsheet.</p><form class="search" action="/finds/" method="get"><input type="search" name="q" placeholder="Try sneakers, hoodies or a product ID" data-i18n-placeholder="search_placeholder" aria-label="Search products" data-i18n-aria-label="ui_search" required/><button type="button" class="image-search-trigger" data-image-search-trigger aria-controls="home-image-search-status" aria-label="Image search is not available yet." title="Image search is not available yet."><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h3l1.5-2h7L17 7h3a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1Z"/><circle cx="12" cy="13" r="3.2"/></svg></button><button type="submit" data-i18n="search">Search ↗</button></form><p id="home-image-search-status" class="image-search-status" data-image-search-status role="status" hidden>Image search is not available yet.</p><div class="hero-foot" data-i18n="hero_foot">Browse an archived FindSpreadsheet catalog</div></div></section><nav class="home-quicklinks" aria-label="Browse" data-i18n-aria-label="ui_browse"><a href="/categories/" data-i18n="strip_categories">Browse by category</a><a href="/finds/" data-i18n="strip_products">FindSpreadsheet product listings</a><a href="/guide/" data-i18n="strip_research">Research before you order</a><a href="https://oopbuy.com/register?inviteCode=VH4XVEESR" data-i18n="strip_links">OopBuy shopping links</a></nav><section class="section" id="categories"><div class="section-head"><div><div class="overline" data-i18n="cat_eyebrow">Find your direction</div><h2 data-i18n="cat_title">Shop by category.</h2><p data-i18n="cat_desc">Start with what you're looking for.</p></div><a class="more" href="/finds/" data-i18n="all_products">All products ↗</a></div><div class="category-grid">{categories.map(([slug,en,zh])=><a class="cat" href={`/finds/?category=${encodeURIComponent(slug)}#listing`}><span data-category-name={slug} data-en={en} data-zh={zh}>{en}</span></a>)}</div><details class="home-category-details"><summary data-i18n="category_checklist">What to check before ordering</summary><div class="category-overview-grid">{categories.map(([slug,en,zh])=><article class="category-overview-card"><h3 data-en={en} data-zh={zh} data-category-name={slug}>{en}</h3><h4 data-i18n="materials_label">Materials & details</h4><p data-category-detail={slug} data-en={categoryDetails[slug].en} data-zh={categoryDetails[slug].zh}>{categoryDetails[slug].en}</p><h4 data-i18n="weight_label">Weight & packing</h4><p data-i18n="weight_text">Weight varies by item, size and packaging. Check the actual packed weight and dimensions before shipping.</p><h4 data-i18n="shipping_label">Shipping & fees</h4><p data-i18n="shipping_text">Shipping depends on destination, parcel weight, size and available routes. Check the final quote on OopBuy.</p><a class="more" href={`/categories/${slug}/`} data-i18n="categories">Categories ↗</a></article>)}</div><p class="category-note" data-i18n="category_note">Material, actual weight and shipping cost are not supplied in this catalog snapshot; confirm the specific product details before ordering.</p></details><div class="home-category-link"><a class="more" href="/categories/" data-i18n="categories">Categories ↗</a></div></section><section class="section" id="finds"><div class="section-head"><div><div class="overline" data-i18n="finds_eyebrow">Worth a closer look</div><h2 data-i18n="finds_title">Featured finds.</h2><p data-i18n="finds_desc">Explore example product records from FindSpreadsheet.</p></div><a class="more" href="/finds/" data-i18n="explore">Explore the catalog ↗</a></div><div class="products">{products.map((p,i)=><a class="product" href={p.href}><div class="picture"><img src={p.image} alt={p.name} loading="lazy"/><span class="badge" data-i18n="featured_badge">FEATURED FIND</span></div><div class="productmeta"><div><small data-i18n={`featured_category_${i}`}>{p.category}</small><h3 data-i18n={`featured_name_${i}`}>{p.name}</h3></div><span class="arrow">↗</span></div></a>)}</div><p class="example"><span data-i18n="example">Example OopBuy product:</span> <a href="https://oopbuy.com/product/weidian/7861965906?inviteCode=U68CWQBN5" data-i18n="example_link">View item 7861965906 on OopBuy ↗</a></p></section><section id="guide" class="home-guide section"><div class="section-head"><div><div class="overline" data-i18n="guide_eyebrow">A LITTLE MORE CONFIDENCE</div><h2 data-i18n="guide">How it works</h2><p data-i18n="guide_desc">A simple path from product discovery to a considered order.</p></div><div><a class="more" href="/guide/" data-i18n="read_guide">Read the guide ↗</a><br/><a class="more" href="/guide/stitching-check/">Stitching QC guide ↗</a></div></div><div class="home-steps"><article><small>01</small><h3 data-i18n="step1">Find a product</h3><p data-i18n="g1p">Find items by category or keyword. This catalog is a historical export: record the ID and check the seller, measurements, material and availability, then confirm the current price on OopBuy. Sizes can vary by seller; keep the product ID to check the order.</p><a href="/categories/" data-i18n="categories">Categories</a></article><article><small>02</small><h3 data-i18n="step2">Check the details</h3><p data-i18n="g2p">Open the item and use its purchase button to reach OopBuy. Check the listing, variation, quantity, current price and any purchase restrictions before ordering. If the item is unavailable, review the platform message before accepting a replacement.</p><a href="/finds/" data-i18n="finds">Featured finds</a></article><article><small>03</small><h3 data-i18n="step3">Continue to OopBuy</h3><p data-i18n="g3p">Register or sign in and review your selected options and charges. You generally pay for the item and any seller-to-warehouse shipping first; international shipping is paid separately when submitting a parcel. Follow purchasing through the order; preorders or stock shortages may delay delivery to the warehouse.</p><a href="https://oopbuy.com/register?inviteCode=VH4XVEESR" data-i18n="register">Register on OopBuy ↗</a></article><article><small>04</small><h3 data-i18n="g4h">Warehouse and QC review</h3><p data-i18n="g4p">After the item reaches the warehouse, open OopBuy User Center → Warehouse to check status and available QC photos. Compare size, colour and visible defects; contact OopBuy before international shipment if something is wrong. Ask support whether extra photos or measurements are available and whether they carry a fee.</p></article><article><small>05</small><h3 data-i18n="g5h">Pack and ship internationally</h3><p data-i18n="g5p">Select stored items for a parcel, enter the destination and compare available routes. Check restrictions, packaging, chargeable weight, shipping and possible taxes. Pay the final quote and keep the waybill to track delivery. Packing can change the chargeable weight; track the waybill and check the current tax rules.</p></article></div></section><section id="faq" class="faq home-faq"><div class="faq-intro"><div class="overline" data-i18n="details">THE DETAILS</div><h2 data-i18n="good_to_know">Good to know.</h2><p data-i18n="faq_desc">Simple answers for smarter product research.</p><a class="more" href="/faq/" data-i18n="faq">FAQ</a></div><div><FaqList expanded={false} /></div></section><section class="home-cta"><div><div class="overline" data-i18n="guide_eyebrow">A LITTLE MORE CONFIDENCE</div><h2 data-i18n="guide_head">Find it. Check it. Make it yours.</h2><p data-i18n="guide_text">Browse a product, review its photos and details, then open the purchasing platform. Check the latest price, options and shipping terms before placing an order.</p></div><a class="btn" href="https://oopbuy.com/register?inviteCode=VH4XVEESR" data-i18n="get_started">Get started on OopBuy ↗</a></section></main></Base>
