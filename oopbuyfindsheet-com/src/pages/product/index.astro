---
import Base from '../../layouts/Base.astro';
import {categories} from '../../data/categories.js';
---
<Base title="Product details — OopBuy Findsheet"><main class="wrap page product-page"><div class="overline" data-i18n="browse_categories">BROWSE ALL CATEGORIES</div><nav class="product-categories" aria-label="All product categories" data-i18n-aria-label="ui_categories">{categories.map(([slug,en,zh])=><a href={`/finds/?category=${encodeURIComponent(slug)}#listing`} data-category-name={slug} data-en={en} data-zh={zh}>{en}</a>)}</nav><a class="more" href="/finds/" data-i18n="back_finds">← Back to products</a><section id="product" aria-live="polite"><p data-i18n="loading">Loading product…</p></section></main><style is:global>.product-categories{display:flex;flex-wrap:wrap;gap:9px;margin:15px 0 38px}.product-categories a{padding:10px 14px;background:#fff;border:1px solid #dce6d8;border-radius:30px;font-size:12px;font-weight:700;color:#254839}.product-categories a:hover{background:#e6efdc}.product-layout{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:45px;margin-top:24px}.product-gallery{background:#eef1ea;border-radius:20px;overflow:hidden;min-height:360px}.product-gallery img{display:block;width:100%;max-height:630px;object-fit:contain}.thumbnails{display:flex;overflow:auto;gap:8px;margin-top:12px}.thumbnails img{width:68px;height:68px;object-fit:cover;border-radius:8px}.product-info h1{font-size:clamp(30px,4vw,49px);line-height:1.1;margin:12px 0 18px}.product-price-usd{font-size:30px;font-weight:750;color:#173c32}.product-meta{font-size:13px;color:#68796d;line-height:1.6}.product-actions{display:flex;gap:12px;flex-wrap:wrap;margin:26px 0}.product-actions .outline{border:1px solid #a7bba7;background:transparent;color:#173c32}.product-category-active{background:#193c32!important;color:white!important}.product-disclaimer{padding:16px;background:#edf3e5;border-radius:12px;font-size:12px;line-height:1.6;color:#506a4e}.product-image-placeholder{min-height:360px;display:grid;place-items:center;color:#68796d}.product-info .sku{font-size:12px}.product-gallery-wrap{min-width:0}@media(max-width:760px){.product-layout{grid-template-columns:1fr;gap:20px}.product-gallery{min-height:230px}.product-categories{gap:7px;margin-bottom:25px}.product-categories a{font-size:11px;padding:8px 11px}.product-info h1{font-size:32px}}.product-info .product-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px}.product-info .product-buy{grid-column:1/-1;display:flex;justify-content:center}.product-info .platform-menu,.product-info .product-secondary{width:100%;box-sizing:border-box}.product-info .product-secondary{text-align:center}.style-photos{margin:26px 0;padding:20px;border:1px solid #dce6d8;border-radius:14px;background:#fff}.style-photos-title{font-size:17px;margin:0 0 12px}.style-photos-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(62px,1fr));gap:8px;max-height:225px;overflow-y:auto;overscroll-behavior:contain}.style-photos-grid img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:8px}.style-photos-note{font-size:12px;line-height:1.5;color:#68796d;margin:10px 0 0}.product-page #product>.product-qc{margin-top:48px;padding-top:28px;border-top:1px solid #dce6d8}.product-page #product>.product-qc .product-photo-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:12px}.product-page #product>.product-qc img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:9px}@media(max-width:760px){.style-photos-grid{grid-template-columns:repeat(4,minmax(0,1fr));max-height:220px}.product-page #product>.product-qc .product-photo-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.product-page #product>.product-qc{margin-top:28px}.product-info .product-actions{gap:8px}}</style><script is:inline src="/product.js" defer></script></Base>
