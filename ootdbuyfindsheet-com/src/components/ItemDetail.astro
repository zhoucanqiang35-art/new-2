---
import Layout from '../layouts/Layout.astro';
import { buyUrl, categories, priceLabel, productCategory } from '../lib/settings.mjs';
const { initial } = Astro.props;
const product = initial?.product;
const category = product && categories[productCategory(product)];
const title = product ? product.name + ' | Ootdbuy Findsheet' : 'Product details | Ootdbuy Findsheet';
const description = product && 'Browse photos, price and seller information for ' + product.name + ' on Ootdbuy Findsheet.';

---
<Layout {title} {description} indexable={Boolean(product)}>
  <section class="wrap tool-page">
    <p class="eyebrow"><a href="/spreadsheet/">Spreadsheet</a> / Product details</p>
    <p id="item-status" class="status" role="status" hidden={Boolean(product)}>Loading product details…</p>
    <div class="detail" id="item" hidden={!product} data-item={initial && JSON.stringify(initial)}>
      <div class="detail-imagery">
        <div class="detail-photo"><img id="item-photo" src={initial?.photos[0]} alt={product?.name ?? ''} fetchpriority="high"></div>
        <p id="photo-status" role="status" hidden>The saved photos could not be loaded. Try the seller listing below.</p>
        <div class="thumbs" id="item-thumbs" aria-label="Product photos"></div>
      </div>
      <div class="detail-copy">
        <p class="eyebrow" id="item-category">{category}</p><h1 id="item-name" translate="no">{product?.name}</h1>
        <div class="detail-price"><strong id="item-price" data-price-cny={product?.price}>{product && priceLabel(product.price)}</strong> <small>Estimated item price · <span data-currency-code>USD</span></small></div>
        <p id="item-id">{product && 'Weidian item ' + product.weidianId}</p>
        <a class="button primary detail-buy" id="item-buy" href={product && buyUrl(product.weidianId)} target="_blank" rel="sponsored noopener">Buy on Ootdbuy</a>
        <div class="detail-actions">
          <details class="other-agents">
            <summary class="button outline"><span>Other shopping agents</span><span class="control-caret" aria-hidden="true"></span></summary>
            <ul id="item-agents" class="choice-grid item-agent-grid"></ul>
          </details>
          <button class="button outline" id="item-copy" type="button">Copy product link</button>
        </div>
        <p id="item-copy-status" class="sr-only" role="status"></p>
        <input id="item-share-url" class="item-share-url" type="url" aria-label="Product link" readonly hidden>
        <div class="seller-options" id="seller-options" hidden></div>
        <div class="detail-utilities">
          <a id="item-source">Findspreadsheet listing</a>
          <button id="item-save" type="button" aria-pressed="false">Save product</button>
        </div>
      </div>
    </div>
    <section class="item-qc section" id="item-qc" hidden>
      <div class="detail-photo-heading">
        <h2 data-qc-heading>Product photos</h2>
        <button class="button outline" type="button" data-qc-refresh>Check QC</button>
      </div>
      <p class="status" data-qc-status role="status" hidden></p>
      <div class="qc-grid" data-qc-gallery></div>
    </section>
  </section>
</Layout>
<script>
  import { buyUrl, categories, coverUrl, mainSite, findItemId, itemShard, priceLabel, productCategory } from '../lib/settings.mjs';
  import { element, readJson } from '../lib/dom.mjs';
  import { agents, agentUrl, defaultAgent } from '../lib/agents.mjs';
  import { readSellerDetails } from '../lib/product-guide.mjs';
  import { renderQc } from '../lib/qc.mjs';

  const byId = id => document.getElementById(id);
  const status = byId('item-status');
  const initial = JSON.parse(byId('item').dataset.item || 'null');
  const id = initial?.product.weidianId ?? findItemId(new URLSearchParams(location.search).get('id') ?? '');
  async function showItem() {
    if (!id) {
      status.textContent = 'Choose a product from the spreadsheet.';
      return;
    }
    const data = initial ?? await readJson('/data/items/' + itemShard(id) + '.json')
      .then(rows=>rows[id]).catch(error=>{
        if (error.status === 404) return null;
        throw error;
      });
    if (!data) {
      status.textContent = 'This item is not in the saved catalog.';
      return;
    }
    const {product, photos} = data;
    const mainPhoto = byId('item-photo');
    const photoStatus = byId('photo-status');
    const thumbnails = byId('item-thumbs');
    mainPhoto.alt = product.name;
    mainPhoto.translate = false;

    const category = productCategory(product);
    byId('item-category').textContent = categories[category] ?? 'Weidian product';
    byId('item-name').textContent = product.name;
    byId('item-price').textContent = priceLabel(product.price);
    byId('item-price').dataset.priceCny = product.price ?? '';
    byId('item-id').textContent = 'Weidian item ' + id;
    byId('item-buy').href = buyUrl(id);
    byId('item-save').dataset.saveProduct = id;
    byId('item-save').dataset.productName = product.name;
    byId('item-source').href = new URL(product.sourcePath, mainSite);
    document.title = product.name + ' | Ootdbuy Findsheet';
    const copy = byId('item-copy');
    const shareUrl = byId('item-share-url');
    const copyStatus = byId('item-copy-status');
    copy.addEventListener('click', async () => {
      shareUrl.value = location.origin + location.pathname + location.search;
      try {
        await navigator.clipboard.writeText(shareUrl.value);
        copy.textContent = 'Link copied';
        copyStatus.textContent = 'Link copied';
        shareUrl.hidden = true;
      } catch {
        shareUrl.hidden = false;
        shareUrl.select();
      }
    });
    for (const agent of agents.filter(entry => entry.key !== defaultAgent)) {
      const row = element('li');
      const link = element('a', {
        href: agentUrl(agent.key, id, product.sourcePath), target: '_blank', className: 'choice-tile',
        rel: agent.key === 'findspreadsheet' ? 'noopener' : 'sponsored noopener',
      });
      link.translate = false;
      if (agent.icon) link.append(element('img', {src:agent.icon,width:20,height:20,alt:'',loading:'lazy'}));
      link.append(document.createTextNode(agent.name));
      row.append(link);
      byId('item-agents').append(row);
    }
    status.hidden = true;
    byId('item').hidden = false;
    document.dispatchEvent(new Event('product:ready'));
    const qc = byId('item-qc');
    qc.hidden = false;
    void renderQc(id, qc, location.hash === '#item-qc' ? 'lookup' : 'preview', photos);
    const photoButtons = [];
    function addPhotoButton(url, index) {
      const thumb = element('button', { type:'button' });
      thumb.setAttribute('aria-label','Show product photo ' + (index + 1));
      thumb.setAttribute('aria-pressed','false');
      const preview = element('img', { src:url, alt:'', loading:'lazy' });
      preview.addEventListener('error', () => { thumb.hidden = true; }, { once:true });
      thumb.append(preview);
      thumb.addEventListener('click', () => showPhoto(url));
      thumbnails.append(thumb);
      photoButtons.push(thumb);
    }
    photos.forEach(addPhotoButton);

    let remaining = [];
    let liveImages = [];
    const attempted = new Set();
    let shown = '';
    function tryNextPhoto() {
      shown = remaining.shift() ?? liveImages.find(url => !attempted.has(url));
      if (shown) {
        attempted.add(shown);
        mainPhoto.src = shown;
      }
      else {
        mainPhoto.hidden = true;
        photoStatus.hidden = false;
      }
    }
    function showPhoto(url) {
      attempted.clear();
      remaining = [...new Set([url, product.image, ...photos])].filter(Boolean);
      tryNextPhoto();
    }
    mainPhoto.addEventListener('load', () => {
      mainPhoto.hidden = false;
      photoStatus.hidden = true;
      const index = photos.indexOf(shown === product.image ? coverUrl(product) : shown);
      photoButtons.forEach((button, i) => button.setAttribute('aria-pressed', String(i === index)));
    });
    mainPhoto.addEventListener('error', tryNextPhoto);
    showPhoto(photos[0]);

    void readSellerDetails(id).then(seller => {
      if (!seller) return;
      const options = byId('seller-options');
      for (const {name, values} of seller.options) {
        const group = element('fieldset', {className:'variant-group'});
        const legend = element('legend', {}, name);
        legend.translate = false;
        const tiles = element('div', {className:'variant-grid'});
        for (const {label, image} of values) {
          const button = element('button', {type:'button', className:'choice-tile variant-tile'});
          button.translate = false;
          button.setAttribute('aria-pressed', 'false');
          button.setAttribute('aria-label', label);
          if (image) {
            button.title = label;
            button.append(element('img', {src:image, alt:'', loading:'lazy'}));
          } else {
            button.textContent = label;
          }
          button.addEventListener('click', () => {
            const selected = tiles.querySelector('[aria-pressed="true"]');
            selected?.setAttribute('aria-pressed', 'false');
            button.setAttribute('aria-pressed', 'true');
            if (image) showPhoto(image);
          });
          tiles.append(button);
        }
        group.append(legend, tiles);
        options.append(group);
      }
      options.hidden = options.childElementCount === 0;

      liveImages = seller.images;
      if (photos.length < 2 || !photoStatus.hidden) {
        for (const url of seller.images) {
          if (photos.includes(url) || url === product.image) continue;
          photos.push(url);
          addPhotoButton(url, photos.length - 1);
        }
        const backup = liveImages.find(url => !attempted.has(url));
        if (!photoStatus.hidden && backup) showPhoto(backup);
      }
    }).catch(() => {});
  }
  try { await showItem(); }
  catch { status.hidden = false; status.textContent = 'The product could not be loaded. Refresh to try again.'; }
</script>
