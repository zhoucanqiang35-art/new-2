---
import { languages } from '../lib/languages.mjs';
---
<details class="language-picker" id="site-language">
  <summary class="control-button" aria-label="Website language">
    <span data-language-label translate="no">English</span>
    <span class="control-caret" aria-hidden="true"></span>
  </summary>
  <div class="choice-grid language-grid">
    {languages.map(([code, label]) =>
      <button class="choice-tile" type="button" data-language={code} lang={code} dir="auto" translate="no" aria-pressed={code === 'en'}>{label}</button>
    )}
  </div>
</details>
<span id="language-status" class="sr-only" role="status"></span>
