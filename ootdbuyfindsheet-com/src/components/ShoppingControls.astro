---
import { agentByKey, agents, defaultAgent } from '../lib/agents.mjs';
import { currencies, rateDate, rateSource } from '../lib/currency.mjs';
---
<div class="header-controls">
  <button class="control-button favorite-control" type="button" data-open-favorites aria-label="Saved products">
    <span aria-hidden="true">♡</span><small data-favorite-count hidden></small>
  </button>
  <details id="shopping-settings">
    <summary class="control-button"><img data-selected-agent-icon src={agentByKey[defaultAgent].icon} width="18" height="18" alt=""><span data-selected-agent>{agentByKey[defaultAgent].name}</span><span class="control-divider" aria-hidden="true"></span><span data-currency-code>USD</span><span class="control-caret" aria-hidden="true"></span></summary>
    <div class="settings-panel">
      <h2>Shopping agent</h2>
      <div class="agent-grid">
        {agents.map(agent => <button type="button" data-select-agent={agent.key} aria-pressed={agent.key === defaultAgent}><span class="agent-icon" aria-hidden="true">{agent.icon ? <img src={agent.icon} width="20" height="20" loading="lazy" alt="" /> : agent.name.slice(0,2)}</span>{agent.name}</button>)}
      </div>
      <h2>Currency</h2>
      <div class="currency-grid">
        {currencies.map(currency => <button type="button" data-select-currency={currency} aria-pressed={currency === 'USD'}>{currency}</button>)}
      </div>
      <p class="settings-note">Estimates based on <a href={rateSource}>ECB rates</a> from {rateDate}. Checkout prices are set by the seller or agent.</p>
    </div>
  </details>
</div>
<dialog class="shop-dialog" id="favorites-dialog" aria-labelledby="favorites-title">
  <div class="dialog-heading"><h2 id="favorites-title">Saved products</h2><form method="dialog"><button class="control-button" aria-label="Close saved products">×</button></form></div>
  <div id="favorite-list"></div>
</dialog>
