---
import { register, mainSite } from '../lib/settings.mjs';
import '../site.css';
import { isProductionSite, siteUrl } from '../lib/seo.mjs';
import LanguagePicker from '../components/LanguagePicker.astro';
import CurrencyPicker from '../components/CurrencyPicker.astro';
import Favorites from '../components/Favorites.astro';
const { title, indexable = true, canonicalPath, description = 'Browse Ootdbuy finds with product photos, saved warehouse QC and direct links to Ootdbuy.' } = Astro.props;
const path = Astro.url.pathname;
const links = [
  ['/', 'Home'], ['/categories/', 'Categories'], ['/spreadsheet/', 'The spreadsheet'],
  ['/how-to-order/', 'Ordering'], ['/handoffs/', 'Handoffs'],
  ['/help/', 'Help & FAQ'],
];
const toolLinks = [['/qc/', 'QC photos'], ['/image-search/', 'Image search']];
const activePath = ['/guides/', '/guides/shipping/'].includes(path) ? '/how-to-order/' : path;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content={description}>
    {(!isProductionSite || !indexable) && <meta name="robots" content="noindex, follow">}
    {isProductionSite && indexable && <link rel="canonical" href={siteUrl(canonicalPath ?? path)}>}
    <link rel="icon" href="/favicon.ico">
    <title>{title}</title>
    {isProductionSite && <meta name="msvalidate.01" content="E34A6C20A8A058592D1DC4B20523F6CB">}
    {isProductionSite && (
      <script is:inline>
        if (location.hostname === 'ootdbuyfindsheet.com') {
          const measurementId = 'G-77F4XD2EXS';
          const pageLocation = location.origin + location.pathname;
          const referrer = document.referrer ? new URL(document.referrer) : null;

          window.dataLayer = window.dataLayer || [];
          function gtag() {
            window.dataLayer.push(arguments);
          }

          gtag('js', new Date());
          gtag('config', measurementId, {
            page_location: pageLocation,
            page_referrer: referrer ? referrer.origin + referrer.pathname : '',
            allow_google_signals: false,
            allow_ad_personalization_signals: false,
          });

          const script = document.createElement('script');
          script.async = true;
          script.src = 'https://www.googletagmanager.com/gtag/js?id=' + measurementId;
          document.head.append(script);
        }
      </script>
    )}
  </head>
  <body>
    <a href="#content" class="skip-link">Skip to content</a>
    <header class="header">
      <div class="wrap header-row">
        <a class="brand" href="/" aria-label="Ootdbuy Findsheet home">
          <img src="/media/ootdbuy-logo.png" alt="Ootdbuy">
          <span>Findsheet</span>
        </a>
        <button class="control-button nav-toggle" type="button" aria-controls="main-navigation" aria-expanded="false">Menu</button>
        <nav id="main-navigation" aria-label="Main navigation">
          {links.filter(([href]) => href !== '/handoffs/').map(([href, label]) => <a href={href} aria-current={activePath === href ? 'page' : undefined}>{label}</a>)}
          <a class="mobile-signup" href={register} target="_blank" rel="sponsored noopener">Join Ootdbuy</a>
        </nav>
        <div class="header-actions">
          <div class="locale-controls">
            <LanguagePicker />
            <CurrencyPicker />
          </div>
          <a class="button signup" href={register} target="_blank" rel="sponsored noopener">Join Ootdbuy</a>
        </div>
      </div>
    </header>
    <main id="content"><slot /></main>
    <footer class="footer">
      <div class="wrap footer-inner">
        <div><strong translate="no">Ootdbuy Findsheet</strong><p>An independent catalog from <a href={mainSite}>Findspreadsheet</a>. Orders are placed on Ootdbuy.</p></div>
        <nav aria-label="Footer navigation">
          {[...links, ...toolLinks].map(([href, label]) => <a href={href}>{label}</a>)}
          <Favorites />
        </nav>
      </div>
    </footer>
  </body>
</html>

<script>
  import '../lib/localize.mjs';
  import '../lib/shopping-controls.mjs';
  const toggle = document.querySelector('.nav-toggle');
  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
  });
</script>
