---
import Layout from '../../layouts/Layout.astro';
import HandoffGuide from '../../components/HandoffGuide.astro';
---
<Layout title="From Seller to Delivery | Ootdbuy Findsheet">
  <section class="wrap tool-page">
    <p class="eyebrow"><a href="/">Home</a> / Handoffs</p>
    <h1>From seller to delivery</h1>
    <p class="intro">See who has your item and what you can check at each handoff.</p>
    <HandoffGuide />
    <div class="button-row">
      <a class="button primary" href="/qc/">Look up saved QC</a>
      <a class="button outline" href="/guides/shipping/">Read the shipping guide</a>
      <a class="button outline" href="/help/">Open the help page</a>
    </div>
  </section>
</Layout>
