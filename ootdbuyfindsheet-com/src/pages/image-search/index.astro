---
import Layout from '../../layouts/Layout.astro';
---
<Layout indexable={false} title="Search Ootdbuy Finds by Image | Ootdbuy Findsheet">
  <section class="wrap tool-page">
    <p class="eyebrow"><a href="/">Home</a> / Image search</p>
    <h1>Find it by photo</h1>
    <p class="intro">Choose a photo to find visually similar products in Findspreadsheet’s saved image index. Your chosen image stays in your browser.</p>
    <div class="upload-box">
      <label for="image-file">Choose a product photo<input id="image-file" type="file" accept="image/jpeg,image/png,image/webp"></label>
      <button id="image-example" class="button outline" type="button">Try a sample photo</button>

    </div>
    <div id="image-controls" class="image-controls" hidden>
      <div class="image-frame"><img id="image-preview" alt="Reference photo for image search"></div>
      <div><label for="image-crop">Crop around the center</label>
        <input id="image-crop" type="range" min="1" max="3" step=".1" value="1">
        <button class="button outline" id="apply-crop" type="button">Search this crop</button>
      </div>
    </div>
    <progress id="image-progress" aria-label="Image search progress" hidden></progress>
    <p class="status" role="status" id="image-status">JPG, PNG or WebP up to 20 MB.</p>
    <div class="product-grid" id="image-results"></div>
  </section>
</Layout>
<script>
  import '../../lib/image-search.mjs';
</script>
