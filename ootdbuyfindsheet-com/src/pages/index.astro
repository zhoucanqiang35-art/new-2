---
import { productPath } from '../lib/seo.mjs';
import { searchHint } from '../lib/languages.mjs';
import Layout from '../layouts/Layout.astro';
import OrderWalkthrough from '../components/OrderWalkthrough.astro';
import HandoffGuide from '../components/HandoffGuide.astro';
import HelpFaq from '../components/HelpFaq.astro';
import { priceLabel } from '../lib/settings.mjs';
import { categoryCards, catalog } from '../lib/categories-at-build.mjs';
const number = new Intl.NumberFormat('en').format(catalog.length);
---
<Layout title="Ootdbuy Spreadsheet | Finds, QC Photos & Product Links">
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="eyebrow hero-tag"><span></span> A Findspreadsheet catalog</p>
        <h1><span translate="no">Ootdbuy</span>{' '}<em>Spreadsheet.</em></h1>
        <p class="hero-lead">Find your next piece, check product and warehouse photos, then open the listing on Ootdbuy.</p>
        <form class="hero-search" action="/spreadsheet/">
          <label class="sr-only" for="hero-query">Find a product</label>
          <input id="hero-query" name="q" placeholder={searchHint}>
          <button class="button primary">Search finds</button>
        </form>
        <div class="hero-links">
          <a href="/image-search/">Search by image</a>
          <a href="/qc/">Look up QC photos</a>
          <a href="#ordering">Ordering</a>
          <a href="#handoffs">Handoffs</a>
          <a href="#faq">Help &amp; FAQ</a>
        </div>
      </div>
    </div>
  </section>
  <section class="wrap section">
    <div class="section-head">
      <div><h2>Shop by category</h2><p>{number} Weidian listings from Findspreadsheet’s saved catalog.</p></div>
      <a class="button outline" href="/categories/">Browse all categories</a>
    </div>
    <div class="category-grid">
       {categoryCards.map(({name, image, price, productId}) =>
        <a href={productPath(productId)} class="category-card">
          <img src={image} alt="" loading="lazy"><span>{name}<br><small>Example price <span data-price-cny={price}>{priceLabel(price)}</span></small></span>
        </a>)}
    </div>
  </section>
  <section class="wrap section guide-home" id="ordering">
    <div class="section-head"><div><h2>How to order with Ootdbuy</h2><p>Follow the real screens from your first item search to parcel tracking.</p></div><a class="button outline" href="/how-to-order/">Read the full ordering guide</a></div>
    <OrderWalkthrough compact />
  </section>
  <section class="wrap section guide-home" id="handoffs">
    <div class="section-head"><div><h2>From seller to delivery</h2><p>See who has your item and what you can check at each handoff.</p></div><a class="button outline" href="/handoffs/">Open the handoff guide</a></div>
    <HandoffGuide compact />
  </section>
  <section class="wrap section guide-home" id="faq">
    <div class="section-head"><div><h2>Help &amp; FAQ</h2></div><a class="button outline" href="/help/">Open the help page</a></div>
    <HelpFaq />
  </section>
</Layout>
