---
import Layout from './Layout.astro';
import { categories, itemUrl, priceLabel, buyUrl } from '../lib/catalog.mjs';
import catalog from '../../public/data/catalog.json';
import savedQc from '../../public/data/qc.json';
import { savedQcLabel } from '../lib/qc.mjs';
import { englishSearchHelp, chineseSearchHelp, productSearchPlaceholder } from '../lib/search.mjs';
const { category = '', intro } = Astro.props;
const title = category ? `OrientDig ${categories[category]} Spreadsheet` : 'OrientDig product spreadsheet';
const description = intro ?? 'Compare Weidian listings and see which items have saved warehouse photos. Prices are estimates converted from saved seller listings.';
const useCards = !category;
const path = category ? `/categories/${category.toLowerCase()}/` : '/spreadsheet/';
const products = category ? catalog.filter(product => product.category === category) : catalog;
const withWarehousePhotos = category
  ? products.filter(product => savedQc[product.weidianId]?.photos?.length).slice(0, 3)
  : [];
const picks = category ? [...new Map(
  [...withWarehousePhotos, ...products.slice(24, 27)].map(product => [product.weidianId, product])
).values()].slice(0, 3) : [];
---
<Layout title={title + " | Search Weidian Finds"} description={description}>
  <section class="wrap page">
    {category && <p><a class="text-link" href="/categories/">All categories</a></p>}
    <h1>{title}</h1>
    <p class="lead">{description}</p>
    {picks.length > 0 && (
      <aside class="panel" aria-label="Listings to compare">
        <h2>Listings to compare</h2>
        <ul>{picks.map(product => <li>
          <a class="text-link" href={itemUrl(product.weidianId)} translate="no">{product.name}</a>
          {savedQc[product.weidianId]?.photos?.length > 0 && <small> · Saved warehouse photos</small>}
        </li>)}</ul>
      </aside>
    )}
    <form id="catalog-form" class="panel filters" action={path} data-category={category || undefined} role="search">
      <label class="field search-field">Product search<input class="input" name="q" placeholder={productSearchPlaceholder} /></label>
      {!category && <label class="field">Category<select name="category"><option value="">All categories</option>{Object.entries(categories).map(([slug,name])=><option value={slug}>{name}</option>)}</select></label>}
      <label class="field">Sort by<select name="sort"><option value="">Latest in snapshot</option><option value="price-asc">Price low to high</option><option value="price-desc">Price high to low</option></select></label>
      <button class="button primary">Search</button>
      <label class="qc-filter"><input type="checkbox" name="qc" value="1" /> With saved warehouse QC</label>
    </form>
    <p class="small muted catalog-search-hint">{englishSearchHelp} <span lang="zh-Hans" translate="no">{chineseSearchHelp}</span></p>
    <p class="status muted" id="catalog-status" role="status">{products.length.toLocaleString('en-US')} listings</p>
    {useCards ? <div id="catalog-list" class="sheet-grid" data-layout="cards">
      {products.slice(0,24).map(product => {
        const href = itemUrl(product.weidianId);
        const record = savedQc[product.weidianId];
        const count = record?.photos?.length ?? 0;
        return <article class="sheet-product">
          <a class="sheet-photo" href={href}><img src={product.image} alt={product.name} translate="no" width="320" height="240" loading="lazy" /></a>
          <div class="sheet-info">
            <p class="sheet-meta muted"><span>{categories[product.category]}</span><span translate="no">{product.weidianId}</span></p>
            <h2><a href={href} translate="no">{product.name}</a></h2>
            <div class="sheet-metrics"><strong class="catalog-price" data-price-cny={product.price ?? ''}>{priceLabel(product.price)}</strong>
              {count ? <a class="qc-count" href={href}>{savedQcLabel(count, record?.status)}</a> : <span>{savedQcLabel(count, record?.status)}</span>}
            </div>
            <div class="sheet-actions"><a class="button outline" href={href}>Review</a><a class="button primary" href={buyUrl(product.weidianId)} data-agent-product={product.weidianId} data-source-path={product.sourcePath} rel="sponsored noopener" target="_blank">Buy on OrientDig</a></div>
          </div>
        </article>;
      })}
    </div> : <div class="table-scroll">
      <table class="finds-table">
        <thead><tr><th scope="col">Product</th><th scope="col">Estimate (<span data-currency-code>USD</span>)</th><th scope="col">Warehouse QC</th><th scope="col">Review & order</th></tr></thead>
        <tbody id="catalog-list">{products.slice(0,24).map(product=>
          <tr>
            <th scope="row"><a class="listing" href={itemUrl(product.weidianId)}><img src={product.image} alt="" width="62" height="54" loading="lazy" /><span><strong translate="no">{product.name}</strong><small>{categories[product.category]} · {product.weidianId}</small></span></a></th>
            <td class="catalog-price" data-price-cny={product.price ?? ""}>{priceLabel(product.price)}</td>
            <td>{savedQc[product.weidianId]?.photos?.length ? <a class="qc-count" href={itemUrl(product.weidianId)}>{savedQc[product.weidianId].photos.length} saved photos</a> : savedQcLabel(0, savedQc[product.weidianId]?.status)}</td>
            <td><div class="row"><a class="text-link" href={itemUrl(product.weidianId)}>Review</a><a href={buyUrl(product.weidianId)} data-agent-product={product.weidianId} data-source-path={product.sourcePath} rel="sponsored noopener" target="_blank">Buy on OrientDig</a></div></td>
          </tr>)}</tbody>
      </table>
    </div>}
    <div id="catalog-empty"></div>
    <div class="row paging" id="catalog-paging" hidden><button class="button outline" id="catalog-prev">Previous</button><span id="catalog-page"></span><button class="button outline" id="catalog-next">Next</button></div>
    <noscript><p>Enable JavaScript to filter and page through the full preview catalog.</p></noscript>
  </section>
</Layout>
<style is:global>
.sheet-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px}
.sheet-product{display:flex;flex-direction:column;min-width:0;background:white;border:1px solid var(--line);border-radius:13px;overflow:hidden}
.sheet-photo{display:block;background:#f4f5f6}
.sheet-photo img{width:100%;height:auto;aspect-ratio:4/3;object-fit:contain}
.sheet-info{padding:11px;display:flex;flex-direction:column;gap:7px;flex:1}
.sheet-info h2{font-size:1rem;line-height:1.25;letter-spacing:-.02em;overflow-wrap:anywhere}
.sheet-info h2 a:hover{text-decoration:underline}
.sheet-meta,.sheet-metrics{display:flex;gap:5px 8px;flex-wrap:wrap;align-items:center;justify-content:space-between;margin:0;font-size:.78rem}
.sheet-metrics{margin-top:auto;color:var(--muted)}
.sheet-metrics strong{font-size:1.02rem}
.sheet-actions{display:grid;grid-template-columns:1fr 1.45fr;gap:6px}
.sheet-actions .button{min-width:0;min-height:37px;font-size:.77rem;padding:5px;overflow-wrap:anywhere}
@media(max-width:950px){.sheet-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:620px){.sheet-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.sheet-info{padding:8px}.sheet-actions{grid-template-columns:1fr}}

.filters{display:grid;grid-template-columns:minmax(190px,2.4fr) 1fr 1fr auto;gap:12px;align-items:end}.qc-filter{grid-column:1/-1;display:flex;align-items:center;gap:7px;color:var(--muted)}.qc-filter input{accent-color:var(--accent-dark);width:17px;height:17px}
.filters[data-category]{grid-template-columns:minmax(190px,2.4fr) 1fr auto}
.paging{justify-content:center;margin-top:22px}.paging button:disabled{opacity:.45;cursor:default}
.table-scroll{overflow:auto;border:1px solid var(--line);border-radius:12px;background:white}.finds-table{width:100%;min-width:610px;border-collapse:collapse;text-align:left;font-size:.94rem}.finds-table thead{background:#f2f4f6}.finds-table th,.finds-table td{padding:9px 13px;border-bottom:1px solid var(--line)}.finds-table tbody tr:last-child>*{border-bottom:0}.finds-table tbody tr:hover{background:#f8f9fa}.finds-table th:first-child{max-width:530px}.finds-table td{white-space:nowrap}.listing{display:flex;align-items:center;gap:9px}.listing img{width:57px;height:47px;border-radius:6px;object-fit:cover;background:#f4f5f6;flex:none}.listing small{display:block;color:var(--muted);margin-top:4px;font-weight:400}.qc-count{font-weight:700;color:var(--accent-dark)}
#catalog-empty:not(:empty){padding:12px 0}
@media(max-width:720px){.filters,.filters[data-category]{grid-template-columns:1fr 1fr}.search-field{grid-column:1/-1}.filters button{grid-column:1/-1}.finds-table{min-width:0}.finds-table thead{display:none}.finds-table tbody tr{display:grid;grid-template-columns:1fr auto;column-gap:9px;padding:9px;border-bottom:1px solid var(--line)}.finds-table th,.finds-table td{padding:3px 0;border:0}.finds-table th:first-child{grid-column:1/-1;margin-bottom:4px}.finds-table td:last-child{grid-column:1/-1}.finds-table td:last-child .row{justify-content:flex-start;gap:16px}.finds-table td{white-space:normal}}
</style>
<script>
  import '../lib/browse.mjs';
</script>
