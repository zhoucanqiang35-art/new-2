---
const { compact = false } = Astro.props;
---
<section class:list={['image-search-box', { 'image-search-compact': compact }]} id="image-search">
  <label class="image-drop" id="image-drop">
    <input class="visually-hidden" id="image-file" type="file" accept="image/*" aria-labelledby="image-upload-title" aria-describedby="image-status" />
    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V3m-4 4 4-4 4 4M4 15v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4"/></svg>
    <strong id="image-upload-title">Upload image</strong>
    <span>Choose a photo or drop it here</span>
  </label>
  <div class="image-search-footer">
    <p class="status muted" id="image-status" role="status">Use a clear photo with one product in frame.</p>
    <button class="button outline" type="button" id="image-example">Try a sample photo</button>
  </div>
  <img id="image-preview" alt="Reference photo" hidden />
</section>
<div class="grid photo-results" id="image-results"></div>
<style>
.image-search-box{width:min(100%,820px);margin-inline:auto}
.image-drop{display:grid;justify-items:center;align-content:center;gap:8px;min-height:230px;padding:20px;background:var(--accent-soft);border:2px dashed #a7a7a7;border-radius:13px;color:var(--ink);cursor:pointer;text-align:center}
.image-drop strong{font-size:1.25rem}.image-drop span{color:var(--muted);font-size:.88rem}
.image-drop:hover,.image-drop:focus-within,.image-drop.is-dragging{border-color:var(--ink);background:#ececec}
.image-drop:focus-within{outline:2px solid var(--ink);outline-offset:3px}
.image-search-footer{display:flex;flex-wrap:wrap;gap:6px 14px;justify-content:space-between;align-items:center;margin-top:7px}
.image-search-footer p{margin:0;font-size:.84rem}
.image-search-footer .button{min-height:34px;padding:5px 10px;font-size:.81rem}
#image-preview{max-width:min(190px,100%);max-height:145px;object-fit:contain;border-radius:8px;margin-top:12px}
.photo-results:not(:empty){margin-top:15px}
.image-search-compact{width:100%}
.image-search-compact .image-drop{min-height:94px;gap:4px;padding:9px}
.image-search-compact .image-drop svg{width:22px;height:22px}
.image-search-compact .image-drop strong{font-size:1rem}
@media(max-width:540px){.image-search-footer p{font-size:.77rem}.image-drop{min-height:190px}.image-search-compact .image-drop{min-height:88px}}
</style>
<script>
  import '../lib/image-search.mjs';
</script>
