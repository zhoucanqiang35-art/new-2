---
import { faq } from '../lib/faq.mjs';
const { headingLevel: Heading = 'h3' } = Astro.props;
---
<div class="platform-faq faq">
  {faq.map(group => <section class="panel">
    <Heading>{group.title}</Heading>
    {group.questions.map(([question, answer, href, label]) => <details>
      <summary>{question}</summary>
      <p>{answer}</p>
      <a class="text-link small" href={href}>{label}</a>
    </details>)}
  </section>)}
</div>
<style>
.platform-faq{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;align-items:start}
.platform-faq .panel{padding:clamp(12px,2vw,20px)}
.platform-faq details{padding:10px 0}.platform-faq details:last-child{border-bottom:0;padding-bottom:0}
.platform-faq summary{line-height:1.4}.platform-faq a{display:inline-block;margin-top:5px}
@media(max-width:850px){.platform-faq{grid-template-columns:1fr}}
</style>
