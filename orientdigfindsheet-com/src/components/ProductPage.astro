---
import Layout from './Layout.astro';
import QcResults from './QcResults.astro';
import Card from './Card.astro';
import { agents, agentUrl } from '../lib/agents.mjs';
import { buyUrl, categories, origin, priceLabel } from '../lib/catalog.mjs';
import { categoryUrl } from '../lib/category-content.mjs';
const { product, related = [], gallery = [], invalidId = '' } = Astro.props;
const heading = product?.name ?? 'Product unavailable';
const description = product ? `View seller photos, a reference price and warehouse QC for ${product.name} (Weidian item ${product.weidianId}).` : undefined;
const initialData = product ? JSON.stringify({ product, gallery }).replaceAll('<', '\\u003c') : '';

---
<Layout title={heading + " | OrientDig Findsheet"} description={description} noIndex={!product}>
  <section class="wrap page">
    <p><a class="text-link" href="/spreadsheet/">Back to spreadsheet</a></p>
    {!product && <div class="panel">
      <h1>{heading}</h1>
      <p>This item is outside the saved catalog.</p>
      {invalidId && <div class="row"><a class="button primary" href={buyUrl(invalidId)} rel="sponsored noopener">Check this Weidian item on OrientDig</a><a class="button outline" href={'/tools/?id='+invalidId+'#qc'}>Check warehouse QC</a></div>}
    </div>}
    {product && <article id="product">
      <script is:inline id="product-data" type="application/json" set:html={initialData}></script>
      <header class="item-header">
        <div><p id="item-category" class="muted small">{categories[product.category]}</p><h1 id="item-title" translate="no">{product.name}</h1><p id="item-id" class="muted small">Weidian item {product.weidianId}</p></div>

      </header>
      <div class="product-layout">
      <div class="compare">
        <section class="panel gallery" aria-labelledby="listing-photo-title">
          <h2 id="listing-photo-title">Seller photos</h2>
          <p class="small muted">Listing images from Findspreadsheet.</p>
          <img class="comparison-image" id="main-image" src={product.image} alt={product.name} translate="no" width="530" height="430" />
          <div id="thumbnails" class="row thumbnails"></div>
        </section>
        <section class="panel gallery" data-compare-qc aria-labelledby="warehouse-photo-title">
          <h2 id="warehouse-photo-title">Warehouse QC photos</h2>
          <p class="small muted">Warehouse inspection photos for this Weidian ID.</p>
          <div data-qc-preview hidden><img class="comparison-image" alt="" width="530" height="430" /><p class="small muted" data-qc-source></p></div>
          <QcResults />
        </section>
      </div>
      <aside class="panel item-actions" aria-label="Price and purchase options">
        <h2>Price &amp; purchase</h2>
        <p id="item-price" class="item-price" data-price-cny={product.price ?? ""}>{priceLabel(product.price)}</p>
        <p class="small muted">Estimated item price in <span data-currency-code>USD</span>. Shipping and any agent fees are calculated separately.</p>
        <a class="button primary" id="buy-link" href={buyUrl(product.weidianId)} data-agent-product={product.weidianId} data-source-path={product.sourcePath} rel="sponsored noopener" target="_blank">Buy on OrientDig</a>
        <button class="button outline" id="other-agents" type="button">Other shopping agents</button>
        <button class="button outline" type="button" data-save-product={product.weidianId} data-product-name={product.name} aria-pressed="false">Save product</button>
        <a class="text-link small" id="source-link" href={new URL(product.sourcePath,origin).href} rel="noopener" target="_blank">Findspreadsheet listing</a>
      </aside>
      </div>
      <dialog class="shop-dialog" id="agent-dialog" aria-labelledby="agent-dialog-title">
        <div class="dialog-heading"><h2 id="agent-dialog-title">Choose a shopping agent</h2><form method="dialog"><button class="control-button" aria-label="Close shopping agents">×</button></form></div>
        <p>Open this same Weidian item with the agent of your choice.</p>
        <div class="agent-grid product-agents">
          {agents.filter(agent => agent.key !== 'findspreadsheet').map(agent => <a data-product-agent={agent.key} href={agentUrl(agent.key,product.weidianId)} rel="sponsored noopener" target="_blank"><span class="agent-icon" aria-hidden="true"><img src={agent.icon} alt="" width="20" height="20" loading="lazy" /></span><span translate="no">{agent.name}</span></a>)}
        </div>
      </dialog>
      <section class="panel review-notes">
        <div><h2>Before you order</h2><p>Check whether the photos show your intended variant. Confirm current price, size and availability on OrientDig. Review your own warehouse QC before you submit a parcel.</p></div>
        <div class="row"><a class="text-link" href="/tools/#qc">Check another item</a><a class="text-link" href="/guides/shipping/">Estimate international shipping</a></div>
      </section>
      <section class="item-related" id="related-products" aria-labelledby="related-title" hidden={!related.length}>
        <div class="content-heading"><h2 id="related-title">Related products</h2><a class="text-link" id="related-category" href={categoryUrl(product.category)}>Browse this category</a></div>
        <div id="related-list" class="related-grid">{related.map(entry => <Card product={entry} />)}</div>
      </section>
    </article>}
  </section>
</Layout>
<style is:global>
.item-related{margin-top:32px}.related-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px}
@media(max-width:850px){.related-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:480px){.related-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
.item-header{display:flex;justify-content:space-between;align-items:end;gap:13px;margin-bottom:14px}.item-header h1{font-size:clamp(2rem,4.6vw,3.7rem);margin:0}.item-header p{margin:.32rem 0} .product-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(250px,315px);align-items:start;gap:14px}
.item-actions{position:sticky;top:14px;display:grid;gap:9px}
.item-actions h2{font-size:1.35rem}.item-actions p{margin:0}.item-actions .item-price{font-size:2rem;font-weight:850;color:var(--accent-dark)}
.product-agents a{display:flex;gap:8px;align-items:center;border:1px solid var(--line);background:white;border-radius:7px;padding:9px;font-weight:700;font-size:.88rem}.product-agents a:hover{border-color:var(--accent-dark);background:var(--accent-soft)}
.compare{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}.compare .gallery{padding:13px}.compare .gallery h2{font-size:1.4rem}.compare .gallery p{margin:.35rem 0 .6rem}.compare .comparison-image{width:100%;height:clamp(220px,29vw,390px);object-fit:contain;background:#f4f5f6;border-radius:9px}.compare .thumbnails{margin-top:8px;gap:6px}.compare [data-qc-gallery]{display:flex;flex-wrap:wrap;gap:6px}
.compare .thumbnails button,.compare .qc-thumbnail{background:#f4f5f6;padding:2px;border:1px solid #aaa;border-radius:6px;cursor:pointer}.compare button[aria-pressed=true]{border:2px solid #475569}.compare .thumbnails img,.compare .qc-thumbnail img{width:49px;height:49px;object-fit:cover;border-radius:4px}.review-notes{margin-top:13px}.review-notes p{color:var(--muted)}
@media(max-width:890px){.product-layout{grid-template-columns:minmax(0,1fr) minmax(225px,260px)}}
@media(max-width:710px){.product-layout{grid-template-columns:minmax(0,1fr)}.item-actions{position:static;grid-row:1}.compare .comparison-image{height:clamp(140px,43vw,260px)}}
@media(max-width:450px){.compare{grid-template-columns:1fr}.compare .comparison-image{height:240px}}
</style>
<script>
  import '../lib/item.mjs';
</script>
