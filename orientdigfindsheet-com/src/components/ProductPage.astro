---
import Layout from './Layout.astro';
import QcResults from './QcResults.astro';
import { agents, agentUrl } from '../lib/agents.mjs';
import { buyUrl, categories, origin, priceLabel } from '../lib/catalog.mjs';
import { categoryUrl } from '../lib/category-content.mjs';
import qc from '../../public/data/qc.json';
import snapshots from '../data/seller-options.json';

const { product, gallery = [], invalidId = '' } = Astro.props;
const heading = product?.name ?? 'Product unavailable';
const description = product ? `View seller photos, a reference price and warehouse QC for ${product.name} (Weidian item ${product.weidianId}).` : undefined;
const photos = product ? [...new Set([product.image, ...gallery].filter(Boolean))] : [];
const savedOptions = product ? snapshots[product.weidianId] ?? [] : [];
const savedQc = product ? qc[product.weidianId]?.photos ?? [] : [];
const sourceUrl = product ? new URL(product.sourcePath, origin).href : '';
const sellerUrl = product ? 'https://weidian.com/item.html?itemID=' + product.weidianId : '';
---
<Layout title={heading + " | OrientDig Findsheet"} description={description} noIndex={!product}>
  <section class="wrap page product-page">
    <a class="text-link small product-back" href="/spreadsheet/">Back to spreadsheet</a>
    {!product && <div class="panel">
      <h1>{heading}</h1>
      <p>This item is outside the saved catalog.</p>
      {invalidId && <div class="row"><a class="button primary" href={buyUrl(invalidId)} rel="sponsored noopener">Check this Weidian item on OrientDig</a><a class="button outline" href={'/qc/?id='+invalidId}>Check warehouse QC</a></div>}
    </div>}
    {product && <article id="product" data-weidian-id={product.weidianId}>
      <div class="product-layout">
        <section class="seller-gallery" aria-label="Seller photos">
          <a id="main-photo-link" href={photos[0]} target="_blank" rel="noopener" aria-label="Open product photo">
            <img id="main-image" src={photos[0]} alt={product.name} translate="no" width="600" height="500" fetchpriority="high" loading="eager" />
          </a>
          {photos.length > 1 && <div class="photo-strip" aria-label="Seller photos">
            {photos.map((photo, index) => <button type="button" data-listing-photo={photo} aria-pressed={index === 0} aria-label={'Show product photo ' + (index + 1)}>
              <img src={photo} alt="" width="58" height="58" loading="eager" decoding="async" />
            </button>)}
          </div>}
        </section>

        <section class="item-actions" aria-label="Price and purchase options">
          <header class="item-header">
            <a href={categoryUrl(product.category)} class="small muted text-link">{categories[product.category]}</a>
            <h1 id="item-title" translate="no">{product.name}</h1>
            <p class="muted small">Weidian item {product.weidianId}</p>
          </header>
          <p id="item-price" class="item-price" data-price-cny={product.price ?? ""}>{priceLabel(product.price)}</p>
          <p class="small muted">Estimated item price in <span data-currency-code>USD</span>.</p>
          <a class="button primary" id="buy-link" href={buyUrl(product.weidianId)} data-agent-product={product.weidianId} data-source-path={product.sourcePath} rel="sponsored noopener" target="_blank">Buy on OrientDig</a>
          <div class="purchase-actions">
            <details id="other-agents" class="purchase-agents">
              <summary class="control-button"><span>Other shopping agents</span><span class="control-caret" aria-hidden="true"></span></summary>
              <div class="settings-panel picker-panel product-agents"><div class="option-grid picker-scroll">
                {agents.filter(agent => agent.key !== 'findspreadsheet').map(agent => <a href={agentUrl(agent.key, product.weidianId)} rel="sponsored noopener" target="_blank">
                  <span class="agent-icon" aria-hidden="true"><img src={agent.icon} alt="" width="20" height="20" loading="lazy" /></span>
                  <span translate="no">{agent.name}</span>
                </a>)}
              </div></div>
            </details>
            <button class="button outline" type="button" id="copy-product" data-copy-url={sellerUrl}>Copy product link</button>
          </div>
          <p id="copy-status" class="small muted" role="status" hidden></p>

          <div class="photo-options" id="seller-options">
            <h2>Product options</h2>
            <p class="small muted" id="seller-options-status" role="status" hidden={savedOptions.length > 0}>Checking seller options…</p>
            <div id="seller-options-groups">
              {savedOptions.map(group => <section class="seller-option-group">
                <h3 translate="no">{group.label}</h3>
                <div class="purchase-photo-grid">
                  {group.options.map(option => <button type="button" data-seller-photo={option.image} aria-label={option.label} title={option.label} translate="no" aria-pressed="false">
                    <img src={option.image} alt="" width="58" height="58" loading="eager" decoding="async" />
                  </button>)}
                </div>
              </section>)}
            </div>
          </div>
          <div class="row product-links">
            <a class="text-link small" href={sellerUrl} rel="noopener" target="_blank">Check sizes and availability on Weidian</a>
            <button class="text-link small save-product" type="button" data-save-product={product.weidianId} data-product-name={product.name} aria-pressed="false">Save product</button>
            <a class="text-link small" id="source-link" href={sourceUrl} rel="noopener" target="_blank">Findspreadsheet listing</a>
          </div>
        </section>
      </div>

      <section class="product-detail-photos" aria-labelledby="warehouse-photo-title">
        <div class="content-heading"><h2 id="warehouse-photo-title">Warehouse QC photos</h2><a class="text-link small" href={'/qc/?id=' + product.weidianId}>Check warehouse QC</a></div>
        {savedQc.length > 0 ? <div class="detail-photo-grid" id="saved-detail-photos">
          {savedQc.map((photo, index) => <a href={photo.url} target="_blank" rel="noopener"><img src={photo.url} alt={'Warehouse QC photo ' + (index + 1)} width="160" height="160" loading="eager" decoding="async" /></a>)}
        </div> : <div id="seller-reference-photos">
          <p class="small muted">Seller reference photos</p>
          <div class="detail-photo-grid">
            {photos.map(photo => <a href={photo} target="_blank" rel="noopener"><img src={photo} alt={product.name} translate="no" width="160" height="160" loading="eager" decoding="async" /></a>)}
          </div>
        </div>}
        <QcResults eager />
      </section>

      <details class="review-notes">
        <summary>Before you order</summary>
        <p>Check whether the photos show your intended variant. Confirm current price, size and availability on OrientDig. Review your own warehouse QC before you submit a parcel.</p>
        <div class="row"><a class="text-link" href="/qc/">Check another item</a><a class="text-link" href="/guides/shipping/">Estimate international shipping</a></div>
      </details>
    </article>}
  </section>
</Layout>
<style is:global>
.product-page{padding-block:19px 45px}
.product-back{display:inline-block;margin-bottom:12px}
.product-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);gap:clamp(14px,3vw,38px);align-items:start}
.seller-gallery{min-width:0}
#main-photo-link{display:block;background:var(--accent-soft);border:1px solid var(--line);border-radius:10px;overflow:hidden}
#main-image{width:100%;height:auto;aspect-ratio:1.18;object-fit:contain}
.photo-strip{display:grid;grid-template-columns:repeat(auto-fill,minmax(55px,1fr));gap:6px;margin-top:7px;padding:3px}
:is([data-listing-photo],[data-seller-photo]){padding:2px;border:1px solid var(--line);border-radius:5px;background:var(--accent-soft);cursor:pointer}
:is([data-listing-photo],[data-seller-photo])[aria-pressed=true]{border-color:var(--ink);box-shadow:inset 0 0 0 1px var(--ink)}
:is([data-listing-photo],[data-seller-photo]) img{width:100%;height:auto;aspect-ratio:1;object-fit:contain;border-radius:3px}
.item-actions{min-width:0;display:grid;gap:8px}
.item-header h1{font-size:clamp(1.45rem,3vw,2.55rem);line-height:1.10;margin:6px 0;overflow-wrap:anywhere}
.item-actions p{margin:0}
.item-price{font-size:clamp(1.5rem,3vw,2.2rem);font-weight:850;line-height:1.2}
.purchase-actions{position:relative;display:grid;grid-template-columns:1fr 1fr;align-items:start;gap:7px}
.purchase-actions :is(.button,.control-button){width:100%;min-height:39px;padding:6px;font-size:.85rem}
.purchase-actions .control-button{white-space:normal}
.purchase-agents[open] .control-caret{transform:rotate(225deg);margin-top:3px}
.purchase-agents .product-agents{position:absolute;inset:calc(100% + 8px) auto auto 0;inset-inline:0 auto;width:min(100%,304px);padding:9px}
.product-agents a{display:flex;gap:7px;align-items:center;border:1px solid var(--line);background:#fff;border-radius:6px;padding:5px 7px;min-height:36px;font-weight:650;font-size:.83rem;min-width:0;overflow-wrap:anywhere}
.product-agents a:is(:hover,:focus-visible){border-color:var(--ink);background:var(--accent-soft)}
.photo-options{margin-top:8px;border-top:1px solid var(--line);padding-top:10px}
.photo-options h2{font-size:1rem;margin-bottom:8px}
.seller-option-group{display:grid;grid-template-columns:minmax(58px,auto) minmax(0,1fr);align-items:start;gap:8px;margin-bottom:8px}
.seller-option-group h3{font-size:.85rem;line-height:1.25;padding-top:10px;overflow-wrap:anywhere;max-width:120px}
.purchase-photo-grid{display:grid;grid-template-columns:repeat(auto-fill, minmax(39px,1fr));gap:6px}
.product-links{gap:6px 13px;margin-top:4px}
.save-product{border:0;background:none;color:inherit;padding:0;cursor:pointer}
.product-detail-photos{margin-top:21px;border-top:1px solid var(--line);padding-top:14px}
.product-detail-photos h2{font-size:clamp(1.2rem,3vw,1.65rem)}
.product-detail-photos .content-heading{margin-bottom:7px}
.product-detail-photos .qc-grid,.detail-photo-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(100px,1fr));gap:7px}
.detail-photo-grid a{background:var(--accent-soft);border:1px solid var(--line);border-radius:7px;overflow:hidden}
.detail-photo-grid img{width:100%;height:auto;aspect-ratio:1;object-fit:contain}
.review-notes{margin-top:17px;border-top:1px solid var(--line);padding-top:9px}
.review-notes summary{cursor:pointer;font-weight:700}.review-notes p{color:var(--muted)}
@media(max-width:660px){.product-layout{grid-template-columns:1fr}#main-image{max-height:410px}}
@media(max-width:440px){.detail-photo-grid,.product-detail-photos .qc-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.seller-option-group{grid-template-columns:1fr}.seller-option-group h3{padding-top:0}}
</style>
<script>
  import '../lib/item.mjs';
</script>
