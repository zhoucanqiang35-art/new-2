---
import Layout from './Layout.astro';
import FindTools from './FindTools.astro';
const { section } = Astro.props;
---
<Layout noIndex title="Image Search & Warehouse QC | OrientDig Findsheet">
  <script is:inline define:vars={{ section }}>
    location.replace('/tools/' + location.search + '#' + section);
  </script>
  <section class="wrap page">
    <h1>Image search &amp; warehouse QC</h1>
    <FindTools />
  </section>
</Layout>
