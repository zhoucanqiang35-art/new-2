---
import Layout from '../../components/Layout.astro';
import TopicCards from '../../components/TopicCards.astro';
import { categoryEntries } from '../../lib/category-content.mjs';

const description = 'Browse the OrientDig spreadsheet by product category. Open a category to search its own listings and check for saved warehouse QC.';
---
<Layout title="OrientDig Spreadsheet Categories | Browse Weidian Finds" description={description}>
  <section class="wrap page">
    <h1>Product categories</h1>
    <p class="lead">{description}</p>
    <a class="text-link" href="/spreadsheet/">Search all products</a>
    <TopicCards entries={categoryEntries} />
  </section>
</Layout>
