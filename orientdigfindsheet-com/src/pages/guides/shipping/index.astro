---
import Layout from '../../../components/Layout.astro';
import ShippingOverview from '../../../components/ShippingOverview.astro';
import { help } from '../../../lib/orientdig.mjs';
const description = 'Use the official OrientDig shipping calculator to compare international routes, billing weights and parcel charges.';
---
<Layout title="OrientDig Shipping Guide | Parcel Cost & Official Estimator" description={description}>
  <section class="wrap page">
    <h1>OrientDig shipping guide</h1>
    <p class="lead">{description}</p>
    <ShippingOverview headingLevel="h2" />
    <section class="prose content-block">
      <h2>What to check after paying for a parcel</h2>
      <p>Keep the parcel ID and check the status after submission. The warehouse may still be verifying your parcel or waiting for carrier pickup. Once dispatched, save the tracking number and check the carrier scan history if the status stops updating.</p>
      <p>If the packed dimensions or carrier measurement differ from the initial estimate, open the final billing details in your account. For a delayed or returned parcel, check the last tracking event and give support the parcel ID so it can review that shipment.</p>
      <div class="row"><a class="text-link" href={help.statuses}>Official parcel status definitions</a><a class="text-link" href="/faq/">Shipping and warehouse FAQ</a></div>
    </section>
  </section>
</Layout>
