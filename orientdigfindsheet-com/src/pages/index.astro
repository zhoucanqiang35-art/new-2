---
import Layout from '../components/Layout.astro';
import Card from '../components/Card.astro';
import FindTools from '../components/FindTools.astro';
import BuyingWalkthrough from '../components/BuyingWalkthrough.astro';
import ShippingOverview from '../components/ShippingOverview.astro';
import PlatformFaq from '../components/PlatformFaq.astro';
import { articles } from '../lib/articles.mjs';
import { chineseSearchHelp } from '../lib/search.mjs';
import { categoryEntries } from '../lib/category-content.mjs';
import catalog from '../../public/data/catalog.json';

const picks = ['6250','8945','8573','8709','8656','8640','8397','8381','9018','8347','5984','8708','8648','8389','8367','8395','8943','8352']
  .map(id => catalog.find(item => item.id === id)).filter(Boolean);
const homeCategories = categoryEntries.filter(entry => entry.key !== 'other-stuff');
const icons = {
  shoes: 'M2 14l5-3 4-6 3 3-1 4 7 2a2 2 0 0 1 2 2v2H2zM2 17h20m-12-5 2 2m0-5 2 2',
  'hoodies-sweaters': 'M8 8c0-3 2-5 4-5s4 2 4 5l4 3 2 8h-4l-1-5v7H7v-7l-1 5H2l2-8zm0 0 4 4 4-4m-6 9h4',
  't-shirts': 'm8 4-5 3-1 5 4 2 1-2v9h10v-9l1 2 4-2-1-5-5-3c0 3-8 3-8 0z',
  jackets: 'm8 3-4 4-2 13h4l2-7v8h8v-8l2 7h4L20 7l-4-4-4 4zm4 4v14m-4-5 2-2m6 2-2-2',
  'pants-shorts': 'M7 3h10l3 18h-6l-2-10-2 10H4zm0 4h10m-5 0v4',
  accessories: 'M4 9h16l2 12H2zm4 1V7a4 4 0 1 1 8 0v3',
  headwear: 'M3 15a8 8 0 0 1 16 0H3zm0 0v3h17c3 0 2-3-1-3M11 7v3',
  jersey: 'm8 4-5 3-1 5 4 2 1-2v9h10v-9l1 2 4-2-1-5-5-3-4 4zm2 7h4l-2 6',
  electronics: 'M5 4h14v12H5zm-3 15h20v2H2zm7-11 2 2-2 2m4 0h2',
  ShortSets: 'M3 5l3-2 2 2 2-2 3 2-2 4-1-1v5H6V8L5 9zm11 7h6l2 9h-4l-1-4-1 4h-4z',
};
const categoryColors = {
  shoes: ['#1d4ed8', '#eaf1ff'],
  'hoodies-sweaters': ['#6d28d9', '#f2eaff'],
  't-shirts': ['#be185d', '#fcebf4'],
  jackets: ['#b45309', '#fef2df'],
  'pants-shorts': ['#047857', '#e5f7ef'],
  accessories: ['#a43a12', '#ffede5'],
  headwear: ['#0e7490', '#e6f7fb'],
  jersey: ['#be123c', '#ffeaf0'],
  electronics: ['#4338ca', '#eeedff'],
  ShortSets: ['#3f6212', '#f0f7e4'],
};
const description = 'Search OrientDig spreadsheet finds, match items by image, review saved QC, and compare shopping agents.';
---
<Layout title="OrientDig Spreadsheet | Product Finds, Image Search & QC" description={description}>
  <section class="home-intro">
    <div class="wrap intro-wrap">
      <div class="intro-copy">
        <h1>OrientDig Spreadsheet</h1>
        <p>Find a Weidian product, check its warehouse photos and choose a shopping agent.</p>
        <form action="/spreadsheet/" role="search" class="intro-search">
          <label for="home-query">Search {catalog.length.toLocaleString('en-US')} listings</label>
          <div class="row">
            <input class="input" id="home-query" name="q" placeholder="Product name, link or item ID" />
            <button class="button primary">Search</button>
          </div>
          <p class="small muted search-language" lang="zh-Hans" translate="no">{chineseSearchHelp}</p>
        </form>
        <div class="row intro-links"><a class="button outline" id="home-image-search" href="#image-search">Search by image</a><a class="text-link" href="/spreadsheet/">Browse spreadsheet</a></div>
      </div>
    </div>
  </section>

  <div class="wrap home-content">
    <section class="content-block" id="categories">
      <div class="content-heading"><h2>Browse by category</h2><a class="text-link" href="/categories/">All categories</a></div>
      <ul class="category-links">
        {homeCategories.map(entry => <li><a href={entry.href}>
          <span class="category-icon" aria-hidden="true" style={{'--icon-color': categoryColors[entry.key][0], '--icon-background': categoryColors[entry.key][1]}}>
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linejoin="round" stroke-linecap="round"><path d={icons[entry.key]} /></svg>
          </span>
          <span>{entry.title}</span>
        </a></li>)}
      </ul>
    </section>
    <section class="content-block" id="spreadsheet">
      <div class="content-heading"><h2>Spreadsheet picks</h2><a class="text-link" href="/spreadsheet/">Full spreadsheet</a></div>
      <div class="pick-grid" tabindex="0" role="region" aria-label="Spreadsheet picks">{picks.map(product => <Card product={product} image={"/media/featured/" + product.id + ".webp"} />)}</div>
    </section>
    <section class="content-block home-tools" id="tools">
      <div class="content-heading"><h2>Image search &amp; QC</h2><a class="text-link" href="/tools/">Open tools page</a></div>
      <FindTools />
    </section>
    <section class="content-block" id="how-to-use">
      <div class="content-heading"><h2>How to use OrientDig Findsheet</h2><a class="text-link" href="/guides/how-to-buy/">Open walkthrough</a></div>
      <BuyingWalkthrough compact />
    </section>
    <section class="content-block" id="shipping">
      <div class="content-heading"><h2>Shipping</h2><a class="text-link" href="/guides/shipping/">Shipping guide</a></div>
      <ShippingOverview compact />
    </section>
    <section class="content-block" id="blog">
      <div class="content-heading"><h2>Blog and agent comparisons</h2><a class="text-link" href="/articles/">All articles</a></div>
      <div class="home-blog">
        {articles.map(article => <article class="panel">
          <h3><a class="text-link" href={article.href}>{article.title}</a></h3>
          <p class="muted">{article.intro}</p>
          <details>
            <summary>Read a practical tip</summary>
            <h4>{article.sections[0].title}</h4>
            <p>{article.sections[0].text}</p>
            <a class="text-link small" href={article.href}>Read the full article</a>
          </details>
        </article>)}
      </div>
    </section>
    <section class="content-block" id="faq">
      <div class="content-heading"><h2>OrientDig spreadsheet FAQ</h2><a class="text-link" href="/faq/">Open FAQ page</a></div>
      <PlatformFaq />
    </section>
  </div>
</Layout>
<style>
.home-intro{padding:35px 0 27px;border-bottom:1px solid var(--line)}
.intro-wrap{display:grid;justify-items:center}
.intro-copy{width:min(100%,650px);text-align:center}
.intro-copy h1{font-size:clamp(2.15rem,5.4vw,4.7rem);line-height:1;letter-spacing:-.058em}
.intro-copy>p{color:var(--muted);font-size:1.05rem;margin:11px auto 15px;max-width:52ch}
.intro-search label{display:block;font-size:.86rem;font-weight:750;margin-bottom:5px;text-align:start}
.intro-search .row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:7px}
.search-language{margin:4px 0 0;text-align:start;font-size:.78rem}.intro-links{justify-content:center;margin-top:9px;font-size:.9rem;gap:14px}
.intro-links .button{min-height:38px;font-size:.86rem}
.home-content{padding-top:24px}
.home-blog{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;align-items:start}
.home-blog h3{line-height:1.25}.home-blog p{margin-bottom:.65rem}
.home-blog summary{cursor:pointer;font-weight:700;font-size:.9rem}.home-blog h4{margin:10px 0 0}
@media(max-width:850px){.home-blog{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:580px){.home-blog{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}
  .home-blog .panel{padding:9px}
  .home-blog h3{font-size:.94rem}
  .home-blog p,.home-blog summary{font-size:.78rem;line-height:1.4}
  .home-blog p{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .home-blog article:has(details[open]) p{display:block;overflow:visible}
  .home-content>.content-block:not(#faq){padding-block:14px}
  .home-content>.content-block:first-child{padding-top:0}
  .home-content>.content-block:not(#faq)>.content-heading{margin-bottom:9px}
  .home-tools :global(.tool-panel){padding:9px}
  .home-tools :global(.tool-grid){gap:6px}
  .home-tools :global(.tool-panel p){margin-block:3px;font-size:.8rem;line-height:1.35}
  .home-tools :global(.tool-panel h2){font-size:1.08rem}
  .home-tools :global(.tool-panel .field){gap:3px;font-size:.82rem}
  .home-tools :global(#image-status){min-height:0}
  .home-tools :global(.tool-panel .row){gap:5px}
  .home-tools :global(.tool-panel .row .field){flex:1 1 100%}
  .home-tools :global(.tool-panel .row){margin-top:5px}
  .home-tools :global(.tool-panel .input){min-height:38px;padding:5px 7px}
  .home-tools :global(.tool-panel .button){min-height:34px;padding:4px 7px;font-size:.74rem}}
.category-links{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}
.category-links a{height:100%;display:flex;gap:7px;flex-direction:column;align-items:center;justify-content:center;text-align:center;min-height:72px;background:white;border:1px solid var(--line);border-radius:9px;padding:7px;font-weight:700;font-size:.89rem;overflow-wrap:anywhere}
.category-icon{width:34px;height:34px;display:grid;place-items:center;flex:none;border-radius:9px;color:var(--icon-color);background:var(--icon-background)}
.category-links a:hover{border-color:var(--accent-dark);background:var(--accent-soft)}
.pick-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px}
.content-heading .text-link{font-size:.88rem;flex-shrink:0}
@media(max-width:900px){.pick-grid{grid-template-columns:repeat(6,minmax(116px,1fr));overflow-x:auto;padding:2px 2px 8px;scroll-snap-type:x proximity}.pick-grid :global(.card){scroll-snap-align:start}}
@media(max-width:675px){
  .home-intro{padding:21px 0 17px}.intro-copy>p{font-size:.96rem;margin:8px 0}.intro-links{gap:10px}
  .category-links{gap:5px}.category-links a{font-size:.69rem;padding:4px 2px;min-height:62px}.category-icon{width:27px;height:27px;border-radius:7px}.category-icon svg{width:18px;height:18px}
  .pick-grid{gap:7px}.pick-grid :global(.card img){height:auto;aspect-ratio:4/3}.pick-grid :global(.card-body){padding:7px 6px;font-size:.8rem}
  .pick-grid :global(.card-price),.pick-grid :global(.small){font-size:.76rem}
  .content-heading{align-items:baseline}.content-heading .text-link{font-size:.77rem;max-width:107px;text-align:end}
}
</style>
<script>
  const trigger = document.querySelector('#home-image-search');
  const upload = document.querySelector<HTMLInputElement>('#image-file');
  if (upload) {
    trigger?.addEventListener('click', event => {
      event.preventDefault();
      upload.click();
    });
    upload.addEventListener('change', () => {
      if (upload.files?.length) document.querySelector('#image-search')?.scrollIntoView({ block: 'start' });
    });
  }
</script>
