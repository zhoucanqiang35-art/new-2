---
import Layout from '../components/Layout.astro';
import Card from '../components/Card.astro';
import FindTools from '../components/FindTools.astro';
import BuyingWalkthrough from '../components/BuyingWalkthrough.astro';
import ShippingOverview from '../components/ShippingOverview.astro';
import PlatformFaq from '../components/PlatformFaq.astro';
import { articles } from '../lib/articles.mjs';
import { chineseSearchHelp, productSearchPlaceholder } from '../lib/search.mjs';
import { categoryEntries } from '../lib/category-content.mjs';
import catalog from '../../public/data/catalog.json';

const picks = ['6250','8945','8573','8709','8656','8640','8397','8381','9018','8347','5984','8708','8648','8389','8367','8395','8943','8352']
  .map(id => catalog.find(item => item.id === id)).filter(Boolean);
const homeCategories = categoryEntries.filter(entry => entry.key !== 'other-stuff');
const icons = {
  shoes: 'M2 14l5-3 4-6 3 3-1 4 7 2a2 2 0 0 1 2 2v2H2zM2 17h20m-12-5 2 2m0-5 2 2',
  'hoodies-sweaters': 'M8 8c0-3 2-5 4-5s4 2 4 5l4 3 2 8h-4l-1-5v7H7v-7l-1 5H2l2-8zm0 0 4 4 4-4m-6 9h4',
  't-shirts': 'm8 4-5 3-1 5 4 2 1-2v9h10v-9l1 2 4-2-1-5-5-3c0 3-8 3-8 0z',
  jackets: 'm8 3-4 4-2 13h4l2-7v8h8v-8l2 7h4L20 7l-4-4-4 4zm4 4v14m-4-5 2-2m6 2-2-2',
  'pants-shorts': 'M7 3h10l3 18h-6l-2-10-2 10H4zm0 4h10m-5 0v4',
  accessories: 'M4 9h16l2 12H2zm4 1V7a4 4 0 1 1 8 0v3',
  headwear: 'M3 15a8 8 0 0 1 16 0H3zm0 0v3h17c3 0 2-3-1-3M11 7v3',
  jersey: 'm8 4-5 3-1 5 4 2 1-2v9h10v-9l1 2 4-2-1-5-5-3-4 4zm2 7h4l-2 6',
  electronics: 'M5 4h14v12H5zm-3 15h20v2H2zm7-11 2 2-2 2m4 0h2',
  ShortSets: 'M3 5l3-2 2 2 2-2 3 2-2 4-1-1v5H6V8L5 9zm11 7h6l2 9h-4l-1-4-1 4h-4z',
};
const categoryColors = {
  shoes: ['#1d4ed8', '#eaf1ff'],
  'hoodies-sweaters': ['#6d28d9', '#f2eaff'],
  't-shirts': ['#be185d', '#fcebf4'],
  jackets: ['#b45309', '#fef2df'],
  'pants-shorts': ['#047857', '#e5f7ef'],
  accessories: ['#a43a12', '#ffede5'],
  headwear: ['#0e7490', '#e6f7fb'],
  jersey: ['#be123c', '#ffeaf0'],
  electronics: ['#4338ca', '#eeedff'],
  ShortSets: ['#3f6212', '#f0f7e4'],
};
const description = 'Search OrientDig spreadsheet finds, match items by image, review saved QC, and compare shopping agents.';
---
<Layout title="OrientDig Spreadsheet | Product Finds, Image Search & QC" description={description}>
  <section class="home-intro">
    <div class="wrap intro-wrap">
      <div class="intro-copy">
        <h1>OrientDig Spreadsheet</h1>
        <p>Find a Weidian product, check its warehouse photos and choose a shopping agent.</p>
      </div>
      <div class="intro-panel">
        <form action="/spreadsheet/" role="search" class="intro-search">
          <label for="home-query">Search {catalog.length.toLocaleString('en-US')} listings</label>
          <div class="search-fields">
            <input class="input" id="home-query" name="q" placeholder={productSearchPlaceholder} />
            <button class="button primary">Search</button>
          </div>
          <div class="row search-suggestions" aria-label="Search suggestions">
            {['Hoodies', 'Sneakers', 'Jerseys'].map((label, index) => <a href={'/spreadsheet/?q=' + ['hoodie', 'sneaker', 'jersey'][index]}>{label}</a>)}
          </div>
          <p class="small muted search-language" lang="zh-Hans" translate="no">{chineseSearchHelp}</p>
        </form>
        <div class="row intro-links"><a class="button outline" id="home-image-search" href="#image-search">Search by image</a><a class="text-link" href="/spreadsheet/">Browse spreadsheet</a></div>
      </div>
    </div>
  </section>

  <div class="wrap home-content">
    <section class="content-block" id="categories">
      <div class="content-heading"><h2>Browse by category</h2><a class="text-link" href="/spreadsheet/">All categories</a></div>
      <ul class="category-links">
        {homeCategories.map(entry => <li><a href={'/spreadsheet/?' + new URLSearchParams({ category: entry.key })}>
          <span class="category-icon" aria-hidden="true" style={{'--icon-color': categoryColors[entry.key][0], '--icon-background': categoryColors[entry.key][1]}}>
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linejoin="round" stroke-linecap="round"><path d={icons[entry.key]} /></svg>
          </span>
          <span class="category-title">{entry.title}</span>
          <small>View all products</small>
        </a></li>)}
      </ul>
    </section>
    <section class="content-block" id="spreadsheet">
      <div class="content-heading"><h2>Spreadsheet picks</h2><a class="text-link" href="/spreadsheet/">Full spreadsheet</a></div>
      <div class="pick-grid" tabindex="0" role="region" aria-label="Spreadsheet picks">{picks.map(product => <Card product={product} image={"/media/featured/" + product.id + ".webp"} />)}</div>
    </section>
    <section class="content-block home-tools" id="tools">
      <div class="content-heading"><h2>Image search</h2><a class="text-link" href="/tools/">Open image search</a></div>
      <FindTools compact />
    </section>
    <section class="content-block" id="how-to-use">
      <div class="content-heading"><h2>How to use OrientDig Findsheet</h2><a class="text-link" href="/guides/how-to-buy/">Open walkthrough</a></div>
      <BuyingWalkthrough compact />
    </section>
    <section class="content-block" id="shipping">
      <div class="content-heading"><h2>Shipping</h2><a class="text-link" href="/guides/shipping/">Shipping guide</a></div>
      <details class="home-disclosure">
        <summary>Estimate international shipping</summary>
        <ShippingOverview compact />
      </details>
    </section>
    <section class="content-block" id="blog">
      <div class="content-heading"><h2>Blog and agent comparisons</h2><a class="text-link" href="/articles/">All articles</a></div>
      <div class="home-blog">
        {articles.map(article => <article class="panel">
          <details>
            <summary>{article.title}</summary>
            <p class="muted">{article.intro}</p>
            <h4>{article.sections[0].title}</h4>
            <p>{article.sections[0].text}</p>
            <a class="text-link small" href={article.href}>Read the full article</a>
          </details>
        </article>)}
      </div>
    </section>
    <section class="content-block" id="faq">
      <div class="content-heading"><h2>OrientDig spreadsheet FAQ</h2><a class="text-link" href="/faq/">Open FAQ page</a></div>
      <PlatformFaq compact />
    </section>
  </div>
</Layout>
<style>
.home-intro{padding:clamp(28px,5.5vw,76px) 0;background:var(--accent-soft);border-bottom:1px solid var(--line)}
.intro-wrap{display:grid;grid-template-columns:minmax(0,.83fr) minmax(0,1.17fr);align-items:center;gap:clamp(22px,4.3vw,62px)}
.intro-copy h1{font-size:clamp(2.15rem,5vw,4.3rem);line-height:1.04;letter-spacing:-.06em;overflow-wrap:anywhere}
.intro-copy>p{color:var(--muted);font-size:1.05rem;margin:14px 0 0;max-width:43ch}
.intro-panel{min-width:0;border:1px solid var(--line);background:white;border-radius:12px;padding:clamp(16px,3vw,38px)}
.intro-search label{display:block;font-size:.9rem;font-weight:750;margin-bottom:9px;text-align:start}
.search-fields{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:9px}
.search-fields :is(.input,.button){min-height:52px}
.search-language{margin:8px 0 0;text-align:start;font-size:.8rem}
.intro-links{margin-top:14px;font-size:.9rem;gap:12px}
.intro-links .button{min-height:40px;font-size:.86rem}
.home-content{padding-block:clamp(26px,5vw,60px)}
.home-content>.content-block{padding-block:clamp(30px,4.3vw,60px)}
.home-content>.content-block:first-child{padding-top:0}
.home-content>.content-block>.content-heading{margin-bottom:clamp(14px,2.4vw,26px)}
.home-content .content-heading h2{font-size:clamp(1.35rem,3vw,2.25rem);line-height:1.13}
.home-disclosure{padding:12px 16px;border:1px solid var(--line);border-radius:8px}
.home-disclosure>summary{padding:4px 0;cursor:pointer;font-weight:650}
.home-disclosure[open]>summary{margin-bottom:12px}
.search-suggestions{gap:5px;margin-top:7px}
.search-suggestions a{border:1px solid var(--line);border-radius:6px;font-size:.77rem;font-weight:650;padding:3px 8px;background:var(--accent-soft)}
.search-suggestions a:hover{border-color:var(--ink)}
.pick-grid :global(.card img){height:auto;aspect-ratio:1.55}
.pick-grid :global(.card-body){padding:10px;gap:4px;font-size:.88rem}

.home-blog{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;align-items:start}
.home-blog .panel{padding:11px 12px}
.home-blog p{margin-bottom:.55rem}
.home-blog summary{cursor:pointer;font-weight:700;font-size:.86rem;line-height:1.35;padding:3px 0}
.home-blog h4{margin:8px 0 0}
@media(max-width:850px){.home-blog{grid-template-columns:repeat(2,minmax(0,1fr));gap:6px}}
@media(max-width:580px){.home-blog summary{font-size:.84rem}.home-blog{gap:8px}}
.category-links{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}
.category-links a{height:100%;display:flex;gap:8px;flex-direction:column;align-items:center;justify-content:center;text-align:center;min-height:102px;background:white;border:1px solid var(--line);border-radius:9px;padding:10px 8px;font-weight:700;font-size:.92rem;overflow-wrap:anywhere}
.category-links small{color:var(--muted);font-weight:500;font-size:.76rem}
.category-icon{width:28px;height:28px;display:grid;place-items:center;flex:none;border-radius:9px;color:var(--icon-color);background:var(--icon-background)}
.category-links a:hover{border-color:var(--accent-dark);background:var(--accent-soft)}
.pick-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:14px}
.content-heading .text-link{font-size:.88rem;flex-shrink:0}
@media(max-width:900px){.pick-grid{grid-template-columns:repeat(6,minmax(116px,1fr));overflow-x:auto;padding:2px 2px 8px;scroll-snap-type:x proximity}.pick-grid :global(.card){scroll-snap-align:start}}
@media(max-width:860px){.intro-wrap{gap:20px}.category-links{gap:8px}}
@media(max-width:675px){
  .intro-wrap{grid-template-columns:1fr;gap:16px}
  .intro-copy>p{margin:8px 0 0;font-size:.95rem}
  .intro-panel{padding:16px}
  .category-links{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
  .category-links a{flex-direction:row;justify-content:flex-start;text-align:start;flex-wrap:wrap;gap:3px 7px;font-size:.84rem;padding:7px 8px;min-height:58px}
  .category-title{flex:1}
  .category-links small{flex-basis:100%;padding-inline-start:34px}
  .category-icon{width:27px;height:27px;border-radius:7px}.category-icon svg{width:18px;height:18px}
  .pick-grid{gap:8px}.pick-grid :global(.card img){height:auto;aspect-ratio:4/3}.pick-grid :global(.card-body){padding:8px;font-size:.82rem}
  .pick-grid :global(.card-price),.pick-grid :global(.small){font-size:.76rem}
  .content-heading{align-items:baseline}.content-heading .text-link{font-size:.8rem;max-width:107px;text-align:end}
}
</style>
<script>
  const trigger = document.querySelector('#home-image-search');
  const upload = document.querySelector<HTMLInputElement>('#image-file');
  if (upload) {
    trigger?.addEventListener('click', event => {
      event.preventDefault();
      upload.click();
    });
    upload.addEventListener('change', () => {
      if (upload.files?.length) document.querySelector('#image-search')?.scrollIntoView({ block: 'start' });
    });
  }
</script>
