---
import Layout from '../../components/Layout.astro';
import QcResults from '../../components/QcResults.astro';
import { warehouseSample } from '../../lib/orientdig.mjs';
const description = 'Look up current warehouse QC using a Weidian item ID or an OrientDig product link.';
---
<Layout title="Warehouse QC | OrientDig Findsheet" description={description}>
  <section class="wrap page">
    <h1>Warehouse QC</h1>
    <p class="lead">{description}</p>
    <div class="panel qc-lookup" id="qc">
      <form id="qc-form">
        <label class="field">Product link or Weidian ID<input class="input" id="qc-query" placeholder={'Example: '+warehouseSample} required /></label>
        <div class="row"><button class="button primary">Check QC</button><button class="button outline" id="qc-example" type="button">Try a QC sample</button></div>
        <p id="qc-error" class="small muted" role="alert" hidden></p>
      </form>
      <QcResults limit={4} />
      <div class="row" id="qc-actions" hidden><a class="text-link" id="qc-item">Product &amp; QC details</a></div>
    </div>
  </section>
</Layout>
<style>
.qc-lookup{max-width:720px}
#qc-form .row,#qc-actions{margin-top:10px}
</style>
<script>
  import '../../lib/qc-search.mjs';
</script>
