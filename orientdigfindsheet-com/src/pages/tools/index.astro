---
import Layout from '../../components/Layout.astro';
import FindTools from '../../components/FindTools.astro';
const description = 'Find similar product listings by image or check saved warehouse QC for a specific Weidian item.';
---
<Layout title="Image Search & Warehouse QC | OrientDig Findsheet" description={description}>
  <section class="wrap page">
    <h1>Image search &amp; warehouse QC</h1>
    <p class="lead">{description}</p>
    <FindTools />
  </section>
</Layout>
