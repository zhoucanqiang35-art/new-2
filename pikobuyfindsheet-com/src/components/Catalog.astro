---
import Icon from './Icon.astro';
import Product from './Product.astro';
import ShoppingMenu from './ShoppingMenu.astro';
import data from '../data/catalog.json';
import {categories,sourceOrigin} from '../lib/platform.mjs';
const {category=''}=Astro.props;
const initial = data.items.filter((p)=>!category||p.category===category).sort((a,b)=>b.date-a.date).slice(0,24);
---
<section class="container section" id="catalog" data-category={category}>
  <div class="catalog-heading">
    <p id="catalog-status" class="catalog-status" role="status">FindSpreadsheet catalog</p>
    <ShoppingMenu/>
  </div>
  <form class="toolbar" id="browse-form" action="/spreadsheet/">
    <div class="search-form"><Icon name="search" size={21}/><label for="catalog-q" class="sr">Search products</label><input id="catalog-q" name="q" type="search" maxlength="500" placeholder="Product name, item ID or link"/><button class="button primary">Search</button><a class="button outline image-search-entry" href="/image-search/" aria-label="Search by image" title="Search by image"><Icon name="camera" size={21}/></a></div>
    <label class="field">Category<select id="catalog-category" name="category"><option value="">All categories</option>{categories.map(([slug,label])=><option value={slug} selected={slug===category}>{label}</option>)}</select></label>
    <label class="field">Sort by<select id="catalog-sort" name="sort"><option value="relevance">Best match</option><option value="latest">Latest</option><option value="popular">Popular</option><option value="price-asc">Price low to high</option><option value="price-desc">Price high to low</option></select></label>
  </form>
  <div class="list-actions" style="margin:0 0 16px"><a class="text-link" href="/image-search/">Image search</a><a class="text-link" href={sourceOrigin+'/AllProducts/'}>Open full FindSpreadsheet catalog</a></div>
  <div class="product-grid" id="catalog-grid">{initial.map(product=><Product product={product}/>)}</div>
  <div class="list-actions"><button class="button outline" id="catalog-more" type="button" hidden>Show more products</button><a class="text-link" id="catalog-source" href={sourceOrigin+'/AllProducts/'}>View on FindSpreadsheet</a></div>
</section>
<script>
  import {setupCatalog} from '../lib/catalog-client.mjs';
  setupCatalog();
</script>
