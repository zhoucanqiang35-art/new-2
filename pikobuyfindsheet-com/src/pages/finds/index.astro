---
import Base from '../../layouts/Base.astro';
import ShoppingMenu from '../../components/ShoppingMenu.astro';
import {agents} from '../../lib/shopping.mjs';
---
<Base title="Product Find | Pikobuy Spreadsheet" noindex={true}>
  <section class="container section">
    <div class="breadcrumbs"><a id="find-back" href="/spreadsheet/">Spreadsheet</a> / Product</div>
    <div class="catalog-heading"><ShoppingMenu/></div>
    <p id="find-status" class="catalog-status" role="status">Opening product…</p>
    <div class="detail" id="find-detail" hidden>
      <section class="listing-gallery" aria-label="Seller photo carousel" aria-roledescription="carousel">
        <h2>Seller photos</h2>
        <div class="listing-gallery-stage">
          <a id="gallery-open" target="_blank" rel="noopener noreferrer" aria-label="Open seller photo in full size" hidden>
            <img class="detail-cover" id="find-image" alt="" width="550" height="550" fetchpriority="high" decoding="async"/>
          </a>
          <p id="gallery-empty" class="notice" hidden>The seller photos could not be displayed. Open the original listing to check its photos.</p>
          <button class="gallery-prev button outline" id="gallery-prev" type="button" aria-label="Previous seller photo" hidden>‹</button>
          <button class="gallery-next button outline" id="gallery-next" type="button" aria-label="Next seller photo" hidden>›</button>
        </div>
        <p id="gallery-position" class="gallery-position" role="status"></p>
        <div class="detail-gallery" id="find-gallery"></div>
      </section>
      <div class="detail-copy">
        <h1 id="find-title">Weidian item</h1><p id="find-id"></p><p class="price" id="find-price" translate="no"></p>
        <div class="list-actions">
          <a id="find-buy" class="button primary" target="_blank" rel="sponsored noopener">Buy on Pikobuy</a>
          <a id="find-weidian" class="button outline" target="_blank" rel="noopener" hidden>View Weidian listing</a>
          <button id="find-save" type="button" class="button outline" aria-pressed="false" hidden>Save product</button>
        </div>
        <details class="detail-agents" id="other-agents" hidden>
          <summary class="button outline">Other shopping agents</summary>
          <div class="detail-agent-grid">
            {agents.filter(({id}) => id !== 'pikobuy').map((agent) => (
              <a data-agent={agent.id} target="_blank" rel={agent.id === 'findspreadsheet' ? 'noopener' : 'sponsored noopener'}>
                <img src={agent.logo} alt="" width="20" height="20" loading="lazy"/><span translate="no">{agent.name}</span>
              </a>
            ))}
          </div>
        </details>
        <div class="list-actions"><a class="text-link" href="#product-qc">View warehouse QC photos</a></div>
        <div class="list-actions"><a id="find-source" class="text-link" target="_blank" rel="noopener">View product on FindSpreadsheet</a></div>
        <p class="notice">Check the selected option, price and availability on the seller page before ordering. <a class="text-link" href="/guides/how-to-buy/#options">How to verify this listing</a>.</p>
      </div>
    </div>
    <section class="qc-results detail-block" id="product-qc" hidden>
      <div class="section-head"><h2>Warehouse QC photos</h2><a class="text-link" href="/qc/#qc-checklist">QC checklist</a></div>
      <p role="status"></p><div class="product-grid"></div>
      <div class="list-actions"><a class="text-link" id="original-qc" target="_blank" rel="noopener" hidden>Check QC on the original product page</a></div>
    </section>
    <section class="detail-block" id="related-section" hidden>
      <div class="section-head"><h2>Related products</h2><a class="text-link" id="related-category">Browse this category</a></div>
      <div class="product-grid" id="related-grid"></div>
    </section>
  </section>
</Base>
<script>
  import {setupDetail} from '../../lib/product-detail.mjs';
  setupDetail();
</script>
