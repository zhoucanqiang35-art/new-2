---
import {pages,categories,products,langs,copy} from '../data.js';
import {guides,faqs} from '../guide-content.js';
import {resourceGuides} from '../resource-guides.js';
import ui from '../ui-copy.json';
import featuredNames from '../featured-names.json';
import catalog from '../../public/data/catalog.json';
export function getStaticPaths(){return Object.keys(langs).flatMap(lang=>['',...pages].map(page=>({params:{path:[lang==='en'?'':lang,page].filter(Boolean).join('/')||undefined},props:{lang,page}})));}
const {lang,page}=Astro.props; const t=copy[lang]; const base=lang==='en'?'':`/${lang}`; const url=(p='')=>`${base}/${p?`${p}/`:''}`; const register='https://www.pikobuy.com/register?invitedCode=KPNJVF&inviteUserId=1109716'; const titles=['',...pages]; const idx=page?pages.indexOf(page):-1;
const images=['https://findspreadsheet.com/uploads/allimg/20260919/1-2609191J3525H.jpg','https://findspreadsheet.com/uploads/allimg/20261010/1-2610101R252E2.jpg','https://findspreadsheet.com/uploads/allimg/20261010/1-2610101R111O3.jpg','https://findspreadsheet.com/uploads/allimg/20261010/1-2610101R1514R.jpg','https://findspreadsheet.com/uploads/allimg/20261010/1-2610101R23GH.jpg','https://findspreadsheet.com/uploads/allimg/20261010/1-2610101R11b29.jpg'];
const catalogLabels={en:'Open the full catalog and sort on FindSpreadsheet',de:'Gesamten Katalog öffnen und auf FindSpreadsheet sortieren',fr:'Ouvrir le catalogue complet et trier sur FindSpreadsheet',es:'Abrir el catálogo completo y ordenar en FindSpreadsheet',it:'Apri il catalogo completo e ordina su FindSpreadsheet',pt:'Abrir o catálogo completo e ordenar no FindSpreadsheet',nl:'Open de volledige catalogus en sorteer op FindSpreadsheet',pl:'Otwórz pełny katalog i sortuj w FindSpreadsheet',sv:'Öppna hela katalogen och sortera på FindSpreadsheet'};
const catalogUi={en:['Search name or ID','All categories','Newest','Price: low to high','Price: high to low','Show more','results','Exported 19 Oct 2026; prices and availability can change. USD prices are estimates at 6.6681 CNY/USD.','Open source & QC'],de:['Name oder ID suchen','Alle Kategorien','Neueste','Preis aufsteigend','Preis absteigend','Mehr anzeigen','Ergebnisse','Export vom 19. Okt. 2026; Preise und Verfügbarkeit können sich ändern. USD-Schätzung: 6,6681 CNY/USD.','Quelle und QC öffnen'],fr:['Rechercher un nom ou un ID','Toutes catégories','Plus récents','Prix croissant','Prix décroissant','Voir plus','résultats','Export du 19 oct. 2026 ; prix et disponibilité variables. Estimation USD : 6,6681 CNY/USD.','Voir la source et le QC'],es:['Buscar nombre o ID','Todas las categorías','Más recientes','Precio ascendente','Precio descendente','Mostrar más','resultados','Exportado el 19 oct. 2026; precios y disponibilidad pueden cambiar. Estimación USD: 6,6681 CNY/USD.','Ver fuente y QC'],it:['Cerca nome o ID','Tutte le categorie','Più recenti','Prezzo crescente','Prezzo decrescente','Mostra altro','risultati','Esportato il 19 ott. 2026; prezzi e disponibilità possono cambiare. Stima USD: 6,6681 CNY/USD.','Apri fonte e QC'],pt:['Buscar nome ou ID','Todas as categorias','Mais recentes','Menor preço','Maior preço','Mostrar mais','resultados','Exportado em 19 out. 2026; preços e estoque podem mudar. Estimativa USD: 6,6681 CNY/USD.','Abrir fonte e QC'],nl:['Zoek naam of ID','Alle categorieën','Nieuwste','Prijs oplopend','Prijs aflopend','Meer tonen','resultaten','Export van 19 okt. 2026; prijzen en voorraad kunnen wijzigen. USD-schatting: 6,6681 CNY/USD.','Bron en QC openen'],pl:['Szukaj nazwy lub ID','Wszystkie kategorie','Najnowsze','Cena rosnąco','Cena malejąco','Pokaż więcej','wyników','Eksport z 19 paź 2026; ceny i dostępność mogą się zmieniać. Szacunek USD: 6,6681 CNY/USD.','Otwórz źródło i QC'],sv:['Sök namn eller ID','Alla kategorier','Nyaste','Pris stigande','Pris fallande','Visa fler','resultat','Export från 19 okt. 2026; priser och lager kan ändras. USD-uppskattning: 6,6681 CNY/USD.','Öppna källa och QC']};
const buyTexts={en:['Buy on PikoBuy ↗','Purchase link unavailable'],de:['Bei PikoBuy kaufen ↗','Kauflink nicht verfügbar'],fr:['Acheter sur PikoBuy ↗','Lien indisponible'],es:['Comprar en PikoBuy ↗','Enlace no disponible'],it:['Acquista su PikoBuy ↗','Link non disponibile'],pt:['Comprar no PikoBuy ↗','Link indisponível'],nl:['Kopen bij PikoBuy ↗','Kooplink ontbreekt'],pl:['Kup w PikoBuy ↗','Link niedostępny'],sv:['Köp på PikoBuy ↗','Köplänk saknas']};
const featuredIds=['5973','8618','7352','7357','8932','8698','8330','9005']; const featured=featuredIds.map(id=>catalog.products.find(p=>p.id===id)).filter(Boolean); const categoryPhotos=['5974','8617','7362','7629','8517','8933','9006','8367','8697','8726'].map(id=>catalog.products.find(p=>p.id===id)?.image||'');
const storyPhotos=Array.from({length:8},(_,i)=>`/guide-topic-${i+1}.webp`);
const independentNote={en:'Independent resource. Not operated by PikoBuy.',de:'Unabhängiger Ratgeber, nicht von PikoBuy betrieben.',fr:'Guide indépendant, non géré par PikoBuy.',es:'Guía independiente, no gestionada por PikoBuy.',it:'Guida indipendente, non gestita da PikoBuy.',pt:'Guia independente, não operado pelo PikoBuy.',nl:'Onafhankelijke gids, niet beheerd door PikoBuy.',pl:'Niezależny poradnik, nieprowadzony przez PikoBuy.',sv:'Oberoende guide som inte drivs av PikoBuy.'};
const localTexts={en:['Choose a category to browse matching products here.','Browse the exported products and open any item for its details.'],de:['Wähle eine Kategorie, um passende Produkte hier zu entdecken.','Durchsuche die exportierten Produkte und öffne die Details.'],fr:['Choisissez une catégorie pour voir les produits ici.','Parcourez les produits exportés et ouvrez leurs détails.'],es:['Elige una categoría para ver sus productos aquí.','Explora los productos exportados y abre sus detalles.'],it:['Scegli una categoria per vedere i prodotti qui.','Esplora i prodotti esportati e apri i dettagli.'],pt:['Escolha uma categoria para ver os produtos aqui.','Explore os produtos exportados e abra os detalhes.'],nl:['Kies een categorie om producten hier te bekijken.','Bekijk geëxporteerde producten en open de details.'],pl:['Wybierz kategorię, aby zobaczyć produkty tutaj.','Przeglądaj eksportowane produkty i otwórz szczegóły.'],sv:['Välj en kategori för att se produkter här.','Bläddra bland exporterade produkter och öppna detaljer.']};
const resourceLabel={en:'Resource Center',de:'Ratgeber & Produkte',fr:'Centre de ressources',es:'Centro de recursos',it:'Centro risorse',pt:'Centro de recursos',nl:'Kenniscentrum',pl:'Centrum wiedzy',sv:'Kunskapscentrum'}; const statsLabels={en:['Products in export','Product categories','Languages','Snapshot year'],de:['Produkte im Export','Produktkategorien','Sprachen','Exportjahr'],fr:['Produits exportés','Catégories','Langues','Année de l’export'],es:['Productos exportados','Categorías','Idiomas','Año de exportación'],it:['Prodotti esportati','Categorie','Lingue','Anno di esportazione'],pt:['Produtos exportados','Categorias','Idiomas','Ano da exportação'],nl:['Producten in export','Productcategorieën','Talen','Exportjaar'],pl:['Produkty w eksporcie','Kategorie produktów','Języki','Rok eksportu'],sv:['Produkter i exporten','Produktkategorier','Språk','Exportår']};
const cats={en:['Shoes','Hoodies / Sweaters','T-Shirts','Jackets','Pants / Shorts','Headwear','Accessories','Jerseys','Electronics','Other Finds'],de:['Schuhe','Hoodies / Pullover','T-Shirts','Jacken','Hosen / Shorts','Kopfbedeckungen','Accessoires','Trikots','Elektronik','Weitere Funde'],fr:['Chaussures','Sweats / pulls','T-shirts','Vestes','Pantalons / shorts','Couvre-chefs','Accessoires','Maillots','Électronique','Autres trouvailles'],es:['Zapatos','Sudaderas','Camisetas','Chaquetas','Pantalones / shorts','Sombreros','Accesorios','Camisetas deportivas','Electrónica','Otros'],it:['Scarpe','Felpe','T-shirt','Giacche','Pantaloni / shorts','Cappelli','Accessori','Maglie sportive','Elettronica','Altri'],pt:['Calçados','Moletons','Camisetas','Jaquetas','Calças / shorts','Chapéus','Acessórios','Camisas esportivas','Eletrônicos','Outros'],nl:['Schoenen','Hoodies','T-shirts','Jassen','Broeken / shorts','Hoofddeksels','Accessoires','Sportshirts','Elektronica','Overige'],pl:['Buty','Bluzy / swetry','T-shirty','Kurtki','Spodnie / szorty','Nakrycia głowy','Akcesoria','Koszulki sportowe','Elektronika','Inne'],sv:['Skor','Huvtröjor','T-shirts','Jackor','Byxor / shorts','Huvudbonader','Accessoarer','Tröjor','Elektronik','Övrigt']};
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><link rel="icon" type="image/png" href="https://www.pikobuy.com/images/header/pikobuy-logo-figma.png"/><meta name="robots" content="noindex,nofollow"/><title>{page?t.nav[idx+1]+' | ':''}PikoBuy Spreadsheet — Finds & Guides</title><meta name="description" content={t.intro}/></head><body>
<header><a href={url()} class="brand"><span class="brand-logo"><img src="https://www.pikobuy.com/images/header/pikobuy-logo-figma.png" alt="PikoBuy"/><small>SPREADSHEET / FINDS</small></span></a><nav aria-label="Main navigation">{titles.map((p,i)=><a class:list={{active:p===page}} href={url(p)}>{t.nav[i]}</a>)}</nav><div class="tools"><label class="language"><span>◉</span><select aria-label="Language" id="locale">{Object.entries(langs).map(([code,name])=><option value={code} selected={code===lang}>{name}</option>)}</select></label><a href={register} class="join">{t.register} ↗</a></div></header>
<main>{!page ? <>
<section class="hero"><div class="hero-image"><div class="hero-copy"><div class="eyebrow">{t.tag} <span> / PIKOBUY FINDS</span></div><h1><span>{t.hero}</span><br/><em>PikoBuy</em> Spreadsheet<br/>{resourceLabel[lang]}</h1><p>{t.intro}</p><form action={url("products")} method="get"><span>⌕</span><input name="keywords" placeholder={t.search} required/><button>{t.go} ↗</button></form><div class="herolinks"><a href={url('products')}>{t.discover} ↗</a><a href={url("products")}>{t.browse} ↗</a></div></div></div></section>
<section class="snapshot"><div class="snapshot-intro"><div class="eyebrow">PIKOBUY SPREADSHEET</div><h2>{t.prod}</h2><p>{t.prodintro}</p></div><div class="snapshot-grid">{['8,911','11','9','2026'].map((n,i)=><div><strong>{n}</strong><span>{statsLabels[lang][i]}</span></div>)}</div></section>
<section class="section"><div class="section-head"><div><div class="eyebrow">01 / {t.kicker[0]}</div><h2>{t.cat}<span>.</span></h2><p>{t.catintro}</p></div><a class="textlink" href={url('categories')}>{t.more} ↗</a></div><div class="category-grid">{categories.map(([name,slug],i)=><a href={'/category/'+slug+'/?lang='+lang} class="category"><div class="category-image"><img src={categoryPhotos[i]} alt={cats[lang][i]} loading="lazy"/></div><div class="category-meta"><span>0{i+1}</span><strong>{cats[lang][i]}</strong><b>↗</b></div></a>)}</div></section>
<section class="section products"><div class="section-head"><div><div class="eyebrow">02 / {t.kicker[1]}</div><h2>{t.prod}<span>.</span></h2><p>{t.prodintro}</p></div><a class="textlink" href={url('products')}>{t.more} ↗</a></div><div class="product-grid home-products">{featured.map((p,i)=><article class="product"><a href={'/item/'+p.id+'/?lang='+lang}><div class="product-art"><img src={p.image} alt={featuredNames[lang][i]} loading="lazy"/><b>↗</b></div><small>FINDSPREADSHEET / {p.weidianId||p.id}</small><strong>{featuredNames[lang][i]}</strong></a><a class="detail-link" href={'/item/'+p.id+'/?lang='+lang}>{t.view} ↗</a>{/^\d+$/.test(p.weidianId||'')?<a class="purchase-card" href={'https://www.pikobuy.com/product/detail?productUrl='+encodeURIComponent('https://weidian.com/item.html?itemID='+p.weidianId)} target="_blank" rel="noopener noreferrer">{buyTexts[lang][0]}</a>:<span class="purchase-card unavailable">{buyTexts[lang][1]}</span>}</article>)}</div></section>
<section class="process"><div><div class="eyebrow">03 / {ui[lang].process}</div><h2>{t.journal}<span>.</span></h2><p>{t.journalintro}</p></div><div class="steps">{t.steps.map((s,i)=><div><span>0{i+1}</span><strong>{s}</strong><p>{t.steptext[i]}</p></div>)}</div></section>
<section class="section"><div class="section-head"><div><div class="eyebrow">04 / {t.kicker[4]}</div><h2>{t.journal}<span>.</span></h2><p>{t.journalintro}</p></div></div><div class="guide-grid">{pages.slice(2).map((p,i)=><a href={url(p)}><div class="guide-photo"><img src={storyPhotos[i]} alt="" loading="lazy"/></div><div class="guide-num">0{i+1} <span>↗</span></div><h3>{t.nav[i+3]}</h3><p>{t.texts[i+2]}</p><strong>{t.more} ↗</strong></a>)}</div></section><section class="section editorial"><div class="section-head"><div><div class="eyebrow">05 / {t.kicker[4]}</div><h2>{t.journal}<span>.</span></h2><p>{t.journalintro}</p></div></div><div class="editorial-list">{pages.slice(2).map((p,i)=><article><div><small>0{i+1} / {t.kicker[i+2]}</small><h3>{t.nav[i+3]}</h3><p>{t.texts[i+2]}</p><a href={url(p)}>{t.more} ↗</a></div><img src={storyPhotos[i+4]} alt="" loading="lazy"/></article>)}</div></section><section class="section home-faq"><div class="section-head"><div><div class="eyebrow">FAQ / PIKOBUY SPREADSHEET</div><h2>{t.nav[6]}<span>.</span></h2></div><a class="textlink" href={url("faq")}>{t.more} ↗</a></div><div class="reading-list">{faqs[lang].map(([heading,body])=><article><h3>{heading}</h3><p>{body}</p></article>)}</div></section><section class="cta"><div><div class="eyebrow">{ui[lang].cta}</div><h2>{t.cta}</h2><p>{t.ctatext}</p></div><a href={register}>{t.register} ↗</a></section>
</> : <><section class="pagehero"><div class="eyebrow">{t.kicker[idx]} / PIKOBUY SPREADSHEET</div><h1>{t.nav[idx+1]}<span>.</span></h1><p>{idx<2?localTexts[lang][idx]:t.texts[idx]}</p></section><section class="section">{page==='categories'? <div class="category-grid">{categories.map(([name,slug],i)=><a href={'/category/'+slug+'/?lang='+lang} class="category"><span>0{i+1}</span><strong>{cats[lang][i]}</strong><b>↗</b></a>)}</div> : page==='products'? <><div class="catalog-tools" data-lang={lang}><p>{catalogUi[lang][7]}</p><div class="catalog-controls"><input id="catalog-search" placeholder={catalogUi[lang][0]} aria-label={catalogUi[lang][0]}/><select id="catalog-category" aria-label={catalogUi[lang][1]}><option value="">{catalogUi[lang][1]}</option>{categories.map(([name,slug],i)=><option value={slug}>{cats[lang][i]}</option>)}<option value="ShortSets">{ui[lang].category[10]}</option></select><select id="catalog-sort" aria-label={ui[lang].sort}><option value="new">{catalogUi[lang][2]}</option><option value="low">{catalogUi[lang][3]}</option><option value="high">{catalogUi[lang][4]}</option></select></div><p id="catalog-count" aria-live="polite"></p><div id="catalog-results" class="product-grid"></div><button id="catalog-more" class="button">{catalogUi[lang][5]}</button><script is:inline src="/product-name-translations.js" defer></script><script is:inline src="/catalog.js" defer></script></div></> : page==='articles' || page==='faq' ? <div class="reading-list">{(page==='articles'?guides[lang]:faqs[lang]).map(([heading,body],i)=><article><h2>{heading}</h2><p>{body}</p></article>)}</div> : <div class="article"><div class="article-rail">PIKOBUY<br/>SPREADSHEET<br/><span>0{idx+1} / 06</span></div><div><h2>{t.nav[idx+1]}</h2><p>{t.texts[idx]}</p><div class="article-steps">{t.steps.map((s,i)=><div><span>0{i+1}</span><h3>{s}</h3><p>{t.steptext[i]}</p></div>)}</div>{(page==='qc'||page==='shipping') && <div class="resource-guide">{resourceGuides[lang][page].map(([heading,body])=><section><h3>{heading}</h3><p>{body}</p></section>)}</div>}<a class="button" href={url("products")}>{t.browse} ↗</a></div></div>}</section><section class="cta"><div><h2>{t.cta}</h2><p>{t.ctatext}</p></div><a href={register}>{t.register} ↗</a></section></>}</main>
<footer><div class="footer-brand">PIKO<span>BUY</span><small>SPREADSHEET / FINDS</small></div><p>{t.note}</p><div>{titles.map((p,i)=><a href={url(p)}>{t.nav[i]}</a>)}</div><small>© 2026 PIKOBUY SPREADSHEET · FINDSPREADSHEET</small></footer>
<script define:vars={{page}}>
document.getElementById('locale').addEventListener('change',e=>{const lang=e.target.value;location.href=(lang==='en'?'':'/'+lang)+'/'+(page?page+'/':'')+location.search+location.hash});
</script></body></html>
<style is:global>
