---
import '../styles/site.css';
const {title='PikoBuy Spreadsheet | Product Finds, QC & Shipping Guides', description: suppliedDescription, page='home', locale='en', articleSlug} = Astro.props;
const descriptions = {home:'Explore PikoBuy spreadsheet finds by category. Compare product listings and learn how to check QC photos and plan international shipping.', discover:'Search PikoBuy spreadsheet finds by product name or category. Compare catalogue listings, estimated prices and current seller details.', categories:'Explore PikoBuy spreadsheet categories, from shoes and clothing to accessories and electronics, and compare available product listings.', shipping:'Understand the factors affecting PikoBuy shipping costs, including parcel weight, dimensions, destination and available routes.', faq:'Find answers about PikoBuy spreadsheet listings, ordering, QC photos, shipping, returns and changing prices.', articles:'Read independent PikoBuy guides covering product links, ordering, QC photos, shipping, sizing, returns and tracking.'};
const description = suppliedDescription || descriptions[page] || 'Explore product details, estimated prices and buying guidance from the PikoBuy Spreadsheet catalogue.';
const pageTitle = page === 'home' ? title : `${title} | PikoBuy Spreadsheet`;
const languageCodes = ['en','de','fr','es','it','pt','nl','pl','sv'];
const articlePath = (language) => `${language === 'en' ? '' : '/' + language}/articles/${articleSlug}/`;

const nav=[['/','Home'],['/discover/','Discover'],['/categories/','Categories'],['/shipping/','Shipping'],['/articles/','SEO Articles'],['/faq/','FAQ']];
---
<!doctype html><html lang={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="index,follow"/><link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} /><title>{pageTitle}</title><meta name="description" content={description}/>{articleSlug && languageCodes.map(language => <link rel="alternate" hreflang={language} href={new URL(articlePath(language), Astro.site)} />)}{articleSlug && <link rel="alternate" hreflang="x-default" href={new URL(articlePath('en'), Astro.site)} />}<link rel="icon" href="https://www.pikobuy.com/images/common/pikobuy-icon-192.png"/></head><body data-page={page}><header><div class="bar"><a class="brand" href="/" aria-label="PikoBuy Spreadsheet"><img src="https://www.pikobuy.com/images/header/pikobuy-logo-figma.png" alt="PikoBuy"/><small>SPREADSHEET</small></a><nav>{nav.map(([href,label])=>label==='Categories'? <details class="nav-menu"><summary data-i="Categories">Categories</summary><div class="nav-dropdown"><a href="/categories/" data-i="All categories">All categories →</a><a href="/categories/?category=shoes" data-i="Shoes">Shoes</a><a href="/categories/?category=hoodies-sweaters" data-i="Hoodies">Hoodies / Sweaters</a><a href="/categories/?category=t-shirts" data-i="T-Shirts">T-Shirts</a><a href="/categories/?category=jackets" data-i="Jackets">Jackets</a><a href="/categories/?category=pants-shorts" data-i="Pants">Pants / Shorts</a><a href="/categories/?category=headwear" data-i="Headwear">Headwear</a><a href="/categories/?category=ShortSets" data-i="Sets">Sets</a><a href="/categories/?category=jersey" data-i="Jerseys">Jerseys</a><a href="/categories/?category=accessories" data-i="Accessories">Accessories</a><a href="/categories/?category=electronics" data-i="Electronics">Electronics</a></div></details>:<a href={href} data-i={label}>{label}</a>)}</nav><div class="right"><select id="language" aria-label="Language"><option value="en">English</option><option value="de">Deutsch</option><option value="fr">Français</option><option value="es">Español</option><option value="it">Italiano</option><option value="pt">Português</option><option value="nl">Nederlands</option><option value="pl">Polski</option><option value="sv">Svenska</option></select><a class="register" data-i="Register" href="https://www.pikobuy.com/register?invitedCode=KPNJVF&inviteUserId=1109716">Register ↗</a></div></div><div class="catnav" hidden><a href="/categories/" data-i="Categories">Categories</a><a href="/categories/?category=shoes" data-i="Shoes">Shoes</a><a href="/categories/?category=hoodies-sweaters" data-i="Hoodies">Hoodies</a><a href="/categories/?category=t-shirts" data-i="T-Shirts">T-Shirts</a><a href="/categories/?category=jackets" data-i="Jackets">Jackets</a><a href="/categories/?category=pants-shorts" data-i="Pants">Pants</a><a href="/categories/?category=headwear" data-i="Headwear">Headwear</a><a href="/categories/?category=jersey" data-i="Jerseys">Jerseys</a><a href="/categories/?category=accessories" data-i="Accessories">Accessories</a><a href="/categories/?category=electronics" data-i="Electronics">Electronics</a></div></header><main><slot/></main><footer><div class="footer"><div><a class="brand" href="/" aria-label="PikoBuy Spreadsheet"><img src="https://www.pikobuy.com/images/header/pikobuy-logo-figma.png" alt="PikoBuy"/><small>SPREADSHEET</small></a><p data-i="footer">An independent product discovery guide powered by FindSpreadsheet.</p></div><div><b data-i="Explore">Explore</b><p><a href="/discover/" data-i="Discover">Discover</a> · <a href="/categories/" data-i="Categories">Categories</a> · <a href="/shipping/" data-i="Shipping">Shipping</a> · <a href="/faq/">FAQ</a></p></div><div><b data-i="Disclaimer">Disclaimer</b><p data-i="disclaimer">Independent from PikoBuy. Prices and availability can change. Registration uses a referral link.</p></div></div></footer><script src="/shipping-i18n.js" is:inline></script><script src="/product-name-translations.js" is:inline></script><script src="/app.js" is:inline></script><script is:inline>
(()=>{const mq=window.matchMedia('(max-width: 600px)');const update=()=>document.querySelectorAll('.mobile-section:not(.home-articles),.responsive-article').forEach(el=>{el.open=!mq.matches});update();mq.addEventListener?.('change',update)})();
</script></body></html>
