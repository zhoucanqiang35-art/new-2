---
import Base from '../../layouts/Base.astro';
import { articles } from '../../data/editorial.js';
export function getStaticPaths() { return articles.map(article => ({ params: { slug: article.slug }, props: { article } })); }
const { article } = Astro.props;
---
<Base title={article.title} page="articles"><section class="inner container" data-article={article.slug}><a class="guide-link" href="/articles/" data-i="article-all">← All 10 guides</a><div class="eyebrow article-eyebrow" data-i="article-eyebrow">PIKOBUY SHOPPING GUIDE</div><h1><span class="article-title" data-article-field="title">{article.title}</span><span>.</span></h1><p class="lead" data-article-field="intro">{article.intro}</p><article class="article long-guide">{article.sections.map(([heading, ...paragraphs], i) => <section><h2 data-article-field={`sections.${i}.0`}>{heading}</h2>{paragraphs.map((paragraph, j) => <p data-article-field={`sections.${i}.${j + 1}`}>{paragraph}</p>)}</section>)}<p class="editorial-note"><span data-i="article-disclaimer">This independent guide is for research. Read the current </span><a href="https://www.pikobuy.com/guide" data-i="article-guide">PikoBuy shopping guide</a>, <a href="https://www.pikobuy.com/protocol/shipping" data-i="article-shipping">shipping terms</a> <span data-i="article-and">and</span> <a href="https://www.pikobuy.com/protocol/returns" data-i="article-returns">returns policy</a><span data-i="article-for-order"> for your order.</span></p><div class="actions"><a href="/discover/" class="primary" data-i="article-finds">Explore finds →</a><a href="/faq/" class="secondary" data-i="article-faq">Read the FAQ →</a></div></article></section></Base>
