---
import Base from '../layouts/Base.astro';
const categories=[['shoes','Shoes'],['hoodies-sweaters','Hoodies/Sweaters'],['t-shirts','T-Shirts'],['jackets','Jackets'],['pants-shorts','Pants/Shorts'],['headwear','Headwear'],['ShortSets','Sets'],['jersey','Jersey'],['accessories','Accessories'],['electronics','Electronics']];
---
<Base title="Categories" page="categories"><section class="category-page"><div class="category-intro"><div class="eyebrow" data-i="THE CATEGORY INDEX">THE CATEGORY INDEX</div><h1 data-i="Explore by category">Explore by category<span>.</span></h1><p class="lead" data-i="categoriesintro">Choose a category to browse matching finds from the FindSpreadsheet catalogue.</p></div><nav class="category-tabs" aria-label="Product categories">{categories.map(([slug,name])=><a href={`/categories/?category=${encodeURIComponent(slug)}`} data-category-tab={slug} data-i={name}>{name}</a>)}</nav><div class="category-content"><div class="category-controls"><label><span data-i="Search products">Search products</span><input id="search" type="search" placeholder="Search products or ID" data-placeholder-i="search-placeholder" aria-label="Search products"/></label><label><span data-i="Sort by">Sort by</span><select id="sort" aria-label="Sort"><option value="latest" data-i="Latest">Latest</option><option value="low" data-i="Price low to high">Price low to high</option><option value="high" data-i="Price high to low">Price high to low</option></select></label><select id="category" aria-label="Category" hidden><option value="">All categories</option></select></div><p id="count" aria-live="polite"></p><div class="product-grid lightproducts" id="products"></div><div class="paging"><button id="prev" data-i="Previous">Previous</button><span id="pagecount"></span><button id="next" data-i="Next">Next</button></div><p class="category-note" data-i="snapshot">Catalogue snapshot: prices and availability may change. Verify details on the source listing.</p><div class="editorial"><h2 data-i="How to choose a category">How to choose a category</h2><p data-i="catdetail">Begin with the type of item you need. Open a product to compare its source images, price, available options and seller listing before placing an order. A category is a starting point, not a guarantee of stock or quality.</p></div></div></section></Base>
