---
import Base from '../layouts/Base.astro';
import ArticleList from '../components/ArticleList.astro';
import { faqs } from '../data/faq.js';
const categories=[['shoes','Shoes'],['hoodies-sweaters','Hoodies/Sweaters'],['t-shirts','T-Shirts'],['jackets','Jackets'],['pants-shorts','Pants/Shorts'],['headwear','Headwear'],['ShortSets','Sets'],['jersey','Jersey'],['accessories','Accessories'],['electronics','Electronics']];
---
<Base page="home"><section class="hero"><div class="container hero-grid"><div><div class="eyebrow" data-i="eyebrow">● &nbsp; PIKOBUY SPREADSHEET DISCOVERY</div><h1><span>PikoBuy</span><br/><em>Spreadsheet</em></h1><p class="lead" data-i="hero">Discover a world of PikoBuy spreadsheet finds. Browse shoes, clothing, accessories and more, compare real product listings from FindSpreadsheet, and explore helpful guides before you order.</p><div class="actions"><a class="primary" href="/discover/" data-i="Explore finds">PikoBuy Spreadsheet <b>→</b></a><a class="secondary" href="https://www.pikobuy.com/register?invitedCode=KPNJVF&inviteUserId=1109716" data-i="Register">Register <b>→</b></a></div><div class="hero-chips">{categories.map(([slug,name])=><a href={`/categories/?category=${slug}`}><i>✦</i> <span data-i={`home-chip-${slug}`}>{name}</span></a>)}</div><div class="hero-note"><div><b>8,911</b><span data-i="home-count-finds"> catalogue finds</span></div><div><b>10</b><span data-i="home-count-categories"> categories</span></div><div><b>9</b><span data-i="home-count-languages"> languages</span></div></div></div></div></section>
<section class="home-boutique-banner" aria-label="Fashion boutique"><img src="/images/boutique-home-banner-v2.png" alt="Fashion boutique displaying clothing and handbags" loading="eager" decoding="async" /></section>
<details class="mobile-section" open><summary data-i="home-category-summary">Explore Spreadsheet Categories</summary><section class="container section"><div class="section-head centered"><div><div class="eyebrow" data-i="home-browse-eyebrow">BROWSE BY CATEGORY</div><h2 data-i="home-browse-title">Explore Spreadsheet Categories</h2><p data-i="home-category-intro">Discover product finds across shoes, clothing, accessories and more. Choose a category to explore matching items in our catalogue.</p></div></div><div class="category-grid" id="home-categories"></div><div class="center-action"><a href="/categories/" class="secondary" data-i="home-all-categories">View all categories →</a></div></section></details>
<details class="mobile-section" open><summary data-i="home-feature-summary">Your PikoBuy Spreadsheet Discovery Platform</summary><section class="feature-section"><div class="container section"><div class="feature-grid"><div><div class="eyebrow" data-i="home-why">WHY CHOOSE OUR SPREADSHEET</div><h2><span data-i="home-feature-line-0">Your PikoBuy</span><br/><span data-i="home-feature-line-1">Spreadsheet Discovery</span><br/><span data-i="home-feature-line-2">Platform</span></h2><p data-i="home-feature-intro">Go from an interesting find to a better-informed purchase with a catalogue, practical checks and clear guides in one place.</p><a class="primary" href="/discover/" data-i="article-finds">Explore finds →</a></div><div class="features"><article><b>◈</b><h3 data-i="home-feature-title-0">Discover more</h3><p data-i="home-feature-text-0">Explore categories and search product names or IDs from the FindSpreadsheet catalogue.</p></article><article><b>⌕</b><h3 data-i="home-feature-title-1">Compare listings</h3><p data-i="home-feature-text-1">Review source photos and listed prices, then check the live listing for current options.</p></article><article><b>◎</b><h3 data-i="home-feature-title-2">QC guidance</h3><p data-i="home-feature-text-2">Learn what to look for in warehouse photographs and what they cannot confirm.</p></article><article><b>↗</b><h3 data-i="home-feature-title-3">Shipping planning</h3><p data-i="home-feature-text-3">Understand how destination, parcel dimensions and route affect shipping costs.</p></article><article><b>◇</b><h3 data-i="home-feature-title-4">Clear categories</h3><p data-i="home-feature-text-4">Start with shoes, outerwear, accessories and more, then narrow down your search.</p></article><article><b>▤</b><h3 data-i="home-feature-title-5">Practical guides</h3><p data-i="home-feature-text-5">Get answers on ordering, warehouse inspection and preparing your parcel.</p></article></div></div></div></section></details>
<details class="mobile-section" open><summary data-i="home-find-summary">Explore Product Finds</summary><section class="container section"><div class="section-head"><div><div class="eyebrow" data-i="home-discover-eyebrow">DISCOVER</div><h2 data-i="home-find-title">Explore Product Finds</h2><p data-i="home-find-intro">Different categories, different ideas. Explore products from the FindSpreadsheet catalogue.</p></div><a href="/discover/" class="textlink" data-i="home-view-finds">View all finds →</a></div><div class="product-grid" id="featured"></div></section></details>
<details class="mobile-section" open><summary data-i="home-collection-summary">Explore Our Discovery Collections</summary><section class="collections"><div class="container section"><div class="section-head centered"><div><div class="eyebrow" data-i="home-collections-eyebrow">CURATED COLLECTIONS</div><h2 data-i="home-collection-title">Explore Our Discovery Collections</h2><p data-i="home-collection-intro">Browse the catalogue by product type and find ideas for your next order.</p></div></div><div class="collection-grid"><a href="/categories/?category=shoes"><img id="col-shoes" alt="Shoe collection"/><span><small>COLLECTION 01</small><b data-i="home-collection-0">Shoe finds</b><em data-i="home-explore">Explore →</em></span></a><a href="/categories/?category=hoodies-sweaters"><img id="col-hoodies" alt="Hoodie collection"/><span><small>COLLECTION 02</small><b data-i="home-collection-1">Hoodies &amp; sweaters</b><em data-i="home-explore">Explore →</em></span></a><a href="/categories/?category=jackets"><img id="col-jackets" alt="Outerwear collection"/><span><small>COLLECTION 03</small><b data-i="home-collection-2">Jackets &amp; outerwear</b><em data-i="home-explore">Explore →</em></span></a><a href="/categories/?category=accessories"><img id="col-accessories" alt="Accessories collection"/><span><small>COLLECTION 04</small><b data-i="home-collection-3">Accessories</b><em data-i="home-explore">Explore →</em></span></a></div></div></section></details>
<details class="mobile-section" open><summary data-i="home-about-summary">About this spreadsheet</summary><section class="container section"><div class="about-grid"><div class="about-images"><img id="about-a" alt="Pants collection"/><img id="about-b" alt="Outfit sets collection"/></div><div><div class="eyebrow" data-i="home-about-eyebrow">ABOUT THIS SPREADSHEET</div><h2><span data-i="home-about-line-0">A clearer way to discover</span><br/><span data-i="home-about-line-1">PikoBuy Spreadsheet finds</span></h2><p data-i="home-about-text-0">Our independent discovery site brings product listings and practical shopping information together. Start with a category or search the catalogue, open a product detail page, then check the latest seller information and options before ordering.</p><p data-i="home-about-text-1">PikoBuy describes a process in which you submit an item for purchase, review it after it reaches the warehouse, and choose a route for international shipping. Product prices and availability can change, so confirm the details at the time of purchase.</p><div class="actions"><a class="primary" href="/articles/" data-i="home-read-guide">Read the complete guide →</a><a class="secondary" href="/shipping/" data-i="home-shipping-guide">Shipping guide →</a></div></div></div></section></details>
<details class="mobile-section" open><summary data-i="home-resources-summary">Learn &amp; Discover</summary><section class="feature-section"><div class="container section"><div class="section-head centered"><div><div class="eyebrow" data-i="home-resource-eyebrow">RESOURCES</div><h2 data-i="home-resources-title">Learn &amp; Discover</h2><p data-i="home-resources-intro">Helpful guidance for choosing products, checking your order and planning your parcel.</p></div></div><div class="resource-grid"><article><div class="resource-icon">▤</div><h3 data-i="home-guide-buying">Buying Guides</h3><a href="/articles/" data-i="home-resource-0">→ How to use a PikoBuy spreadsheet</a><a href="/articles/" data-i="home-resource-1">→ Check a product link before ordering</a><a href="/articles/" data-i="home-resource-2">→ Read product listings and options</a><a href="/articles/" data-i="home-resource-3">→ Inspect warehouse photographs</a></article><article><div class="resource-icon">↗</div><h3 data-i="home-guide-shipping">Shipping &amp; QC</h3><a href="/shipping/" data-i="home-resource-4">→ Plan your international parcel</a><a href="/shipping/" data-i="home-resource-5">→ Understand weight and dimensions</a><a href="/shipping/" data-i="home-resource-6">→ Compare available shipping routes</a><a href="/articles/" data-i="home-resource-7">→ What QC photos can show</a></article><article><div class="resource-icon">?</div><h3 data-i="home-guide-faq">Frequently Asked</h3><a href="/faq/" data-i="home-resource-8">→ What is a PikoBuy spreadsheet?</a><a href="/faq/" data-i="home-resource-9">→ Are listed prices final?</a><a href="/faq/" data-i="home-resource-10">→ What can QC photos show?</a><a href="/faq/" data-i="home-resource-11">→ When is shipping paid?</a></article></div><div class="center-action"><a href="/articles/" class="secondary" data-i="home-all-resources">Browse all resources →</a></div></div></section></details>
<details class="mobile-section home-articles"><summary data-i="home-articles-summary">10 PikoBuy Guides &amp; Articles</summary><section class="container section"><div class="section-head centered"><div><div class="eyebrow" data-i="home-article-eyebrow">THE RESEARCH EDIT</div><h2 data-i="home-articles-title">10 PikoBuy Guides &amp; Articles</h2><p data-i="home-articles-intro">Practical articles for every stage of your order.</p></div></div><ArticleList home={true} /><div class="center-action"><a class="secondary" href="/articles/" data-i="home-articles-link">Visit the articles page →</a></div></section></details>
<details class="mobile-section" open><summary data-i="home-faq-summary">Frequently Asked Questions</summary><section class="container section"><div class="section-head centered"><div><div class="eyebrow" data-i="home-before-eyebrow">BEFORE YOU ORDER</div><h2 data-i="home-faq-title">Frequently Asked Questions</h2><p data-i="home-faq-intro">Detailed answers about finding products, ordering, QC, shipping and returns.</p></div></div><div class="home-faq">{faqs.map(([question, answer], index) => <details><summary data-faq-question={index}>{question}</summary><p data-faq-answer={index}>{answer}</p></details>)}</div><div class="center-action"><a class="secondary" href="/faq/" data-i="home-all-faq">View all FAQs →</a></div></section></details>
<section class="cta"><div class="container"><div><div class="eyebrow" data-i="home-start-eyebrow">START EXPLORING</div><h2><span data-i="home-cta-line-0">Ready to Discover</span><br/><span data-i="home-cta-line-1">Your Next Find?</span></h2><p data-i="home-cta-intro">Browse the catalogue, compare your options and make a plan for your next order.</p></div><div class="actions"><a class="primary" href="/discover/">PikoBuy Spreadsheet →</a><a class="secondary" href="/articles/" data-i="home-learn-more">Learn more →</a></div></div></section></Base>
