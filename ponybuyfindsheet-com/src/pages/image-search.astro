---
import Shell from '../layouts/Shell.astro';
import ProductCard from '../components/ProductCard.astro';
import { catalog } from '../lib/catalog.js';
import { catalogPhotoUrl, searchProducts } from '../lib/search-catalog.js';
import warehouse from '../data/qc.json';
import photoIndex from '../data/image-index.json';

const indexedCount = new Set(photoIndex.entries.map(([, url]) => url)).size;
const curatedIds = new Set(catalog.map(({ id }) => id));
const qcListings = searchProducts.filter(({ marketId }) => !curatedIds.has(marketId) && warehouse[marketId]?.length);

const example = catalog.find((item) => item.id === '7871821866');
---
<Shell title="PonyBuy Image Search | Find Similar Products" description="Search the Findspreadsheet catalog with a product image, screenshot or photo." active="/image-search/">
  <section class="wrap page-top">
    <h1>Search by image</h1>
    <p>Search {indexedCount.toLocaleString('en-US')} indexed product photos, including gallery, style and QC photos.</p>
    <form class="image-search-form" data-image-search novalidate>
      <label class="image-drop" for="product-image">
        <span class="upload-symbol" aria-hidden="true">↑</span>
        <strong>Upload a product image</strong>
        <span>Drop an image here, or choose a file</span>
        <small>JPG, PNG or WebP. Up to 15 MB.</small>
        <span class="button button-ghost">Choose an image</span>
        <input type="file" id="product-image" name="image" accept="image/*" class="visually-hidden" />
      </label>
      <div class="image-controls">
        <p class="muted">Your image stays in this browser.</p>
        {example && <a class="text-link" href={'/image-search/?item=' + example.id}>Try an example</a>}
      </div>
      <picture class="upload-preview" hidden>
        <img alt="" width="128" height="112" />
      </picture>
    </form>
  </section>
  <section class="wrap section" aria-labelledby="matches-title">
    <h2 id="matches-title">Similar products</h2>
    <p class="search-status" data-search-status role="status" aria-live="polite"></p>
    <div class="product-grid" data-image-results></div>
  </section>

  {catalog.map((item) => <template data-image-result={item.id}><ProductCard item={item} /></template>)}
  {qcListings.map((item) => <template data-image-result={item.marketId}>
    <ProductCard item={{ ...item, id: item.marketId, image: catalogPhotoUrl(item.photo), category: item.categoryLabel, categorySlug: item.category, source: 'weidian' }} priceCny={item.price} url={'/listing/?' + new URLSearchParams({ id: item.id })} />
  </template>)}
</Shell>
<script>
  import { setUiText } from '../lib/preferences';
  import { photoThumbnail } from '../lib/catalog-photos';
  import { searchByImage, searchByItem } from '../lib/visual-search';

  const form = document.querySelector<HTMLFormElement>('[data-image-search]')!;
  const input = document.querySelector<HTMLInputElement>('#product-image')!;
  const target = form.querySelector<HTMLElement>('.image-drop')!;
  const preview = form.querySelector<HTMLElement>('.upload-preview')!;
  const previewImage = preview.querySelector<HTMLImageElement>('img')!;
  const status = document.querySelector<HTMLElement>('[data-search-status]');
  const results = document.querySelector<HTMLElement>('[data-image-results]')!;
  const templates = new Map([...document.querySelectorAll<HTMLTemplateElement>('template[data-image-result]')].map((entry) => [entry.dataset.imageResult, entry]));
  let previewUrl: string | undefined;
  let attempt = 0;

  const errors = {
    'invalid-type': 'Please choose an image file.',
    'file-too-large': 'This image is larger than 15 MB.',
    'pixel-limit': 'This image could not be opened.',
    'decode-failed': 'This image could not be opened.',
    'item-unavailable': 'No close matches found.',
  };

  async function run(request: () => Promise<{ id: string; url: string }[]>) {
    const id = ++attempt;
    results.replaceChildren();
    setUiText(status, 'Searching…');
    try {
      const hits = await request();
      if (id !== attempt) return;
      for (const item of hits) {
        const entry = templates.get(item.id);
        if (!entry) continue;
        const card = entry.content.cloneNode(true) as DocumentFragment;
        const image = card.querySelector<HTMLImageElement>('.product-photo img');
        if (image) {
          const cover = image.src;
          image.src = photoThumbnail(item.url, 440);
          image.addEventListener('error', () => { image.src = cover; }, { once: true });
        }
        results.append(card);
      }
      const count = results.childElementCount;
      if (count) setUiText(status, count === 1 ? '{count} product' : '{count} products', { count });
      else setUiText(status, 'No close matches found.');
    } catch (error) {
      if (id !== attempt) return;
      const code = (error as { code?: keyof typeof errors })?.code;
      setUiText(status, (code && errors[code]) || 'The image search is unavailable right now.');
    }
  }

  function handleFile(file: File) {
    if (previewUrl) URL.revokeObjectURL(previewUrl);
    preview.hidden = true;
    if (file.type.startsWith('image/') && file.size <= 15 * 1024 * 1024) {
      previewUrl = URL.createObjectURL(file);
      previewImage.src = previewUrl;
      preview.hidden = false;
      previewImage.onerror = () => { preview.hidden = true; };
    }
    void run(() => searchByImage(file, { limit: 12 }));
  }

  input.addEventListener('change', () => {
    if (input.files?.[0]) handleFile(input.files[0]);
    input.value = '';
  });

  form.addEventListener('submit', (event) => event.preventDefault());
  target.addEventListener('dragover', (event) => { event.preventDefault(); target.classList.add('is-dragging'); });
  target.addEventListener('dragleave', () => target.classList.remove('is-dragging'));
  target.addEventListener('drop', (event) => {
    event.preventDefault();
    target.classList.remove('is-dragging');
    const file = event.dataTransfer?.files[0];
    if (file) handleFile(file);
  });

  function fetchProductPhoto(value: string) {
    const url = new URL(value, location.origin);
    const local = url.origin === location.origin && url.pathname.startsWith('/media/');
    const source = url.origin === 'https://findspreadsheet.com' && url.pathname.startsWith('/uploads/');
    const supplier = url.origin === 'https://si.geilicdn.com';
    if (!local && !source && !supplier) throw new Error('Unknown product photo');
    return fetch(url, { credentials: 'omit', redirect: 'error', signal: AbortSignal.timeout(8000) }).then((response) => {
      if (!response.ok) throw new Error('Product photo unavailable');
      return response.blob();
    });
  }

  const query = new URLSearchParams(location.search);
  const item = query.get('item');
  const listing = query.get('listing');
  const photo = query.get('photo') || '';
  if (item && templates.has(item)) {
    void run(() => searchByItem(item, { limit: 12, photo }));
  } else if (listing && photo) {
    void run(async () => {
      const { searchProducts, catalogPhotoUrl } = await import('../lib/search-catalog');
      const entry = searchProducts.find(({ id }) => id === listing);
      if (!entry) return [];
      let image;
      try {
        image = await fetchProductPhoto(photo);
      } catch {
        image = await fetchProductPhoto(catalogPhotoUrl(entry.photo));
      }
      return searchByImage(image, { limit: 12 });
    });
  }
</script>
