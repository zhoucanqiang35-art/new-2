---
import { join } from '../lib/shared.js';
import Preferences from '../components/Preferences.astro';
import '../style.css';

const { title, description, path = Astro.url.pathname, noindex = false, structured } = Astro.props;
const canonical = new URL(path, Astro.site);
const isProductionBuild = process.env.SITE_PREVIEW !== '1';
const nav = [['/spreadsheet/', 'Spreadsheet'], ['/image-search/', 'Image Search'], ['/qc-photos/', 'QC Photos'], ['/how-to-buy/', 'Buying Guide']];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  {isProductionBuild && path === '/' && <meta name="msvalidate.01" content="E34A6C20A8A058592D1DC4B20523F6CB" />}
  {isProductionBuild && (
    <script is:inline>
      if (location.hostname === 'rizzitgofindsheet.com') {
        const measurementId = 'G-CEBY0B5T0M';
        const pageLocation = new URL(location.pathname, location.origin);
        const query = new URLSearchParams(location.search);
        for (const key of ['utm_source', 'utm_medium', 'utm_campaign', 'utm_id', 'utm_term', 'utm_content', 'utm_source_platform']) {
          if (query.has(key)) pageLocation.searchParams.set(key, query.get(key));
        }
        const referrer = document.referrer ? new URL(document.referrer) : null;

        window.dataLayer = window.dataLayer || [];
        function gtag() { window.dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', measurementId, {
          page_location: pageLocation.href,
          page_referrer: referrer ? referrer.origin + referrer.pathname : '',
          allow_google_signals: false,
          allow_ad_personalization_signals: false,
        });

        const tag = document.createElement('script');
        tag.async = true;
        tag.src = 'https://www.googletagmanager.com/gtag/js?id=' + measurementId;
        document.head.append(tag);
      }
    </script>
  )}
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#cefa05" />
  {(noindex || !isProductionBuild) && <meta name="robots" content="noindex, follow" />}
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL('/brand/logo.png', Astro.site)} />
  {structured && <script type="application/ld+json" set:html={JSON.stringify(structured).replaceAll('<', '\\u003c')} />}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap bar">
      <a class="brand" href="/" aria-label="RizzitGo FindSheet home">
        <img src="/brand/header-logo.png" width="236" height="66" alt="RizzitGO" /><span data-catalog-copy>FINDSHEET</span>
      </a>
      <nav aria-label="Main navigation">
        {nav.map(([href, label]) => <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}</a>)}
      </nav>
      <div class="header-tools"><Preferences /><a class="button join" href={join} rel="sponsored noopener" target="_blank">Join RizzitGo <span aria-hidden="true">↗</span></a></div>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="footer"><div class="wrap">
    <strong>RizzitGo FindSheet</strong>
    <p>An independent Findspreadsheet guide. We may earn a referral reward when you join through our link.</p>
    <div><a href="/faq/">FAQ</a><a href="/sitemap.xml">Sitemap</a><a href="https://findspreadsheet.com/">Findspreadsheet.com</a></div>
  </div></footer>
</body>
</html>
