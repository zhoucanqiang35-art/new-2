---
import Base from '../layouts/Base.astro';
---
<Base title="RizzitGo Image Search | Find Similar Spreadsheet Products" description="Search the Findspreadsheet photo index for visually similar RizzitGo finds. Select, paste, or drop a picture to discover products.">
  <section class="wrap section" data-image-finder>
    <h1>RizzitGo image search</h1>
    <p class="intro">Find visually similar products across 37,359 indexed Findspreadsheet photos. Your image stays in your browser.</p>
    <label class="drop" id="image-drop" for="image-file">
      <span class="upload-symbol" aria-hidden="true">↑</span>
      <strong>Upload an image</strong><span>Choose, paste, or drag and drop a JPG, PNG, WebP, or GIF up to 20 MB.</span>
      <input class="sr-only" id="image-file" type="file" accept="image/jpeg,image/png,image/webp,image/gif" />
    </label>
    <div id="image-query" class="image-query" hidden>
      <img id="image-preview" alt="Your search image" width="104" height="104" hidden /><span id="image-name"></span>
      <button class="button outline" id="image-retry" type="button" hidden>Try again</button>
      <button class="button outline" id="image-reset" type="button">Remove</button>
    </div>
    <p id="image-status" role="status">Choose an image to see similar products.</p>
    <div class="cards" id="image-results"></div>
  </section>
</Base>
<script>
  import '../lib/image-finder.js';
</script>
