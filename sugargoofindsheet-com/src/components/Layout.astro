---
import '../styles/site.css';
import '../styles/browse-grid.css';
import '../styles/v5.css';
import '../styles/charcoal.css';
import '../styles/porcelain.css';
import Icon from './Icon.astro';
import LanguagePicker from './LanguagePicker.astro';
const { title = 'Sugargoo Spreadsheet | Sugargoo Finds List', description = 'Browse FindSpreadsheet product finds, check warehouse reference photos and open Weidian listings on Sugargoo.', catalogView = false } = Astro.props;
const home = Astro.url.pathname === '/';
const links = [['/', 'Home'], ['/browse/', 'Spreadsheet'], ['/qc/', 'QC Finder'], ['/image-search/', 'Image search'], ['/guide/', 'Buying guide'], ['/faq/', 'FAQ'], ['/seo/', 'SEO']];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#f5f6f8" />
  <link rel="icon" href="/brand/favicon.png" type="image/png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@500;600;700;800&family=DM+Sans:wght@400..750&display=swap" rel="stylesheet" />
  <title>{title}</title>
</head>
<body class:list={['site', home && 'home-page', catalogView && 'browse-catalog']}>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" data-i18n-ignore href="/" aria-label="Sugargoo home"><img src="/brand/logo.png" alt="Sugargoo" width="132" height="40" /></a>
      <nav class="main-nav" aria-label="Main navigation">{links.map(([href,label]) => <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}</a>)}</nav>
      <div class="header-actions"><LanguagePicker /><a class="join button" href="https://www.superbuy.com/en/page/login?partnercode=8dcUtX&type=register" target="_blank" rel="noopener sponsored" data-i18n-ignore>Join Superbuy</a>
        <details class="mobile-nav"><summary aria-label="Navigation menu"><Icon name="menu" /></summary><nav aria-label="Mobile navigation">{links.map(([href,label]) => <a href={href}>{label}</a>)}</nav></details>
      </div>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="site-footer"><div class="wrap footer-inner"><div><a class="footer-brand" data-i18n-ignore href="/">Sugargoo Finds List</a><p>Independent product directory by FindSpreadsheet.</p></div><nav class="footer-links" aria-label="Footer navigation">{links.map(([href,label]) => <a href={href}>{label}</a>)}</nav></div><p class="wrap affiliate-note">Reference prices exclude delivery and optional services. Some links are referral links.</p></footer>
</body>
</html>
<script>
  import '../lib/price-display';
</script>
