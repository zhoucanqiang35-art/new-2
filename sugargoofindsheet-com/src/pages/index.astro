---
import fs from 'node:fs';
import Layout from '../components/Layout.astro';
import Icon from '../components/Icon.astro';
import BuyingGuide from '../components/BuyingGuide.astro';
import Faq from '../components/Faq.astro';
import { categories, detailsUrl, buyUrl, signup, priceLabel, categoryLabel, type Product } from '../lib/catalog';
const products = JSON.parse(fs.readFileSync('public/data/catalog.json','utf8')) as Product[];
const featured = ['4502','8648','7357','8563','8477','7953','6297','7652'].map(id => products.find(product => product.id === id)!);
---
<Layout>
  <section class="hero-dark">
    <div class="wrap hero-dark-inner">
      <h1>Sugargoo Spreadsheet</h1>
      <p>Browse Weidian finds from FindSpreadsheet, compare available warehouse photos, and open the same listing with your preferred shopping agent.</p>
      <form class="search-bar dark-hero-search" action="/browse/" method="get" role="search"><Icon name="search" size={23} /><input type="search" name="q" aria-label="Search by product name or Weidian ID" placeholder="Product name or Weidian ID" /><a href="/image-search/" class="camera-search" aria-label="Search by photo"><Icon name="camera" size={23} /></a><button type="submit">Search</button></form>
      <nav class="hero-quick-links" aria-label="Featured categories"><a href="/browse/">All finds</a><a href="/browse/?category=shoes">Shoes</a><a href="/browse/?category=hoodies-sweaters">Hoodies & sweaters</a><a href="/browse/?category=jersey">Jerseys</a></nav>
      <div class="hero-process"><a href="/browse/"><strong>Find a product in the Sugargoo spreadsheet</strong><span>Product photos</span></a><a href="/qc/"><strong>Check available reference QC photos</strong><span>Warehouse QC photos</span></a><a href="/guide/"><strong>Submit a parcel and compare international routes</strong><span>Buying guide</span></a></div>
    </div>
  </section>
  <section class="wrap homepage-shortcuts" aria-label="Shopping tools"><a class="shortcut shortcut-black" href="/browse/"><Icon name="search" size={28} /><h2>Browse finds</h2><p>8,087 Weidian listings from FindSpreadsheet</p></a><a class="shortcut shortcut-blue" href="/image-search/"><Icon name="camera" size={28} /><h2>Search by photo</h2><p>Upload a reference photo</p></a><a class="shortcut shortcut-purple" href="/qc/"><Icon name="check" size={28} /><h2>QC Finder</h2><p>Check available reference QC photos</p></a><a class="shortcut shortcut-orange" href="/guide/"><Icon name="box" size={28} /><h2>Buying guide</h2><p>Follow the illustrated guide</p></a></section>
  <nav class="wrap home-category-links" aria-label="Product categories">{categories.map(([key,label]) => <a href={'/browse/?category='+encodeURIComponent(key)}>{label}</a>)}</nav>
  <section class="wrap section"><header class="section-heading"><h2>Featured finds</h2><a href="/browse/" class="text-link">Browse finds</a></header><p class="mobile-product-hint">Swipe to explore all 8 featured finds</p><div class="products featured" tabindex="0" aria-label="Featured products">{featured.map(product => <article class="product-card home-product-card"><a href={detailsUrl(product.weidianId)}><img src={'/editorial/'+product.id+'.webp'} alt={product.name} width="360" height="360" loading="lazy" /></a><div class="product-info"><span class="product-category">{categoryLabel(product.category)}</span><h3><a href={detailsUrl(product.weidianId)} data-product-name={product.weidianId}>{product.name}</a></h3><strong data-price-cny={product.price} data-i18n-ignore>{priceLabel(product.price)}</strong><div class="home-card-actions"><a class="button clear" href={detailsUrl(product.weidianId)}>View details</a><a class="button" href={buyUrl(product.weidianId)} target="_blank" rel="noopener sponsored">Buy on Sugargoo</a></div></div></article>)}</div></section>
  <BuyingGuide home />
  <section class="wrap section home-faq"><header class="section-heading"><h2>Sugargoo Spreadsheet FAQ</h2><a class="text-link" href="/faq/">FAQ</a></header><Faq home /></section>
  <section class="wrap section resource-banner"><div><h2>Sugargoo Spreadsheet and Shopping Guides</h2><p>Find Weidian products for Sugargoo and follow the steps from product search and quality checks to warehouse storage and international shipping.</p></div><a class="button dark" href="/seo/">SEO</a></section>
</Layout>
