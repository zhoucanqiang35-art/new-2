---
import Layout from '../components/Layout.astro';
import Icon from '../components/Icon.astro';
import ProductOverview from '../components/ProductOverview.astro';
---
<Layout title="Product Details | Sugargoo Spreadsheet">
  <section class="wrap tool-page product-page">
    <a class="text-link back-link" href="/browse/">Back to spreadsheet</a>
    <p id="product-status" role="status" class="status">Loading product…</p>
    <div id="product-detail" hidden>
      <div class="detail-grid">
        <div>
          <img id="product-photo" class="detail-photo" width="600" height="600" />
          <div id="thumbnails" class="thumbnails" aria-label="Listing photos"></div>
        </div>
        <div class="detail-info">
          <p class="product-category" id="product-category"></p>
          <h1 id="product-name"></h1>
          <p class="detail-price" id="product-price"></p>
          <p id="product-id"></p>
          <div class="detail-actions"><a class="button dark" id="buy-product" target="_blank" rel="noopener sponsored">Buy on Sugargoo</a><a class="button clear" href="#other-shopping-agents">Other shopping agents</a><a class="button clear" id="source-product" target="_blank" rel="noopener">View on Findspreadsheet</a></div>
          <p class="tool-help">Reference listing price. Check the current price and options on Sugargoo.</p>
          
        </div>
      </div>
      <section class="detail-qc" id="other-shopping-agents"><h2>Other shopping agents</h2><p>Open this exact Weidian item with the same shopping platforms available on FindSpreadsheet.</p><div id="other-agent-links" class="agent-purchase-grid"></div></section>
      <section class="detail-qc product-specific"><h2>About this product</h2><div id="product-description"></div><dl id="product-facts" class="product-facts"></dl></section>
      <ProductOverview />
      <section class="detail-qc"><h2>Warehouse QC photos</h2><p id="item-qc-status" role="status" class="status"></p><div id="item-qc-gallery" class="photo-grid"></div></section>
      <section class="detail-qc"><header class="section-heading"><h2>Related products</h2><a class="text-link" href="/browse/">Browse all products</a></header><div id="related-products" class="products"></div></section>
    </div>
  </section>
</Layout>
<script>
  import { buyUrl, categoryLabel, galleryPhotos, getData, priceLabel, sourceUrl, type Product } from '../lib/catalog';
  import { lookupQc } from '../lib/qc';
  import { otherAgentLinks } from '../lib/agents';
  import { productCard } from '../lib/product-card';
  import { describeProduct } from '../lib/product-description';
  const container = document.querySelector<HTMLElement>('#product-detail')!;
  const status = document.querySelector<HTMLElement>('#product-status')!;
  const id = new URLSearchParams(location.search).get('id');
  const photo = document.querySelector<HTMLImageElement>('#product-photo')!;
  const thumbs = document.querySelector<HTMLElement>('#thumbnails')!;

  function setupPhotos(product: Product, photos: string[]) {
    photo.src = photos[0];
    photo.alt = product.name;
    if (photos.length < 2) return;
    thumbs.replaceChildren(...photos.map((url, index) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.setAttribute('aria-label', 'Show listing photo ' + (index + 1));
      button.setAttribute('aria-pressed', String(index === 0));
      const thumb = new Image();
      thumb.src = url;
      thumb.alt = '';
      thumb.width = thumb.height = 72;
      thumb.loading = 'lazy';
      button.append(thumb);
      button.addEventListener('click', () => {
        photo.src = url;
        for (const sibling of thumbs.children) sibling.setAttribute('aria-pressed', String(sibling === button));
      });
      return button;
    }));
  }

  async function show() {
    if (!id || !/^\d{5,20}$/.test(id)) {
      status.textContent = 'Choose a product from the spreadsheet.';
      return;
    }
    const products = await getData<Product[]>('catalog.json');
    const product = products.find(item => item.weidianId === id);
    if (!product) {
      status.textContent = 'This product could not be found in the catalog.';
      return;
    }
    document.title = product.name + ' | Sugargoo Spreadsheet';
    document.querySelector('#product-name')!.textContent = product.name;
    document.querySelector<HTMLElement>('#product-name')!.dataset.productName = product.weidianId;
    document.querySelector('#product-category')!.textContent = categoryLabel(product.category);
    document.querySelector('#product-price')!.textContent = priceLabel(product.price);
    document.querySelector<HTMLElement>('#product-price')!.dataset.priceCny = product.price;
    document.querySelector('#product-price')!.setAttribute('data-i18n-ignore', '');
    describeProduct(product);
    document.querySelector('#product-id')!.textContent = 'Weidian item ' + product.weidianId;
    document.querySelector<HTMLAnchorElement>('#buy-product')!.href = buyUrl(id);
    document.querySelector<HTMLAnchorElement>('#source-product')!.href = sourceUrl(product);
    document.querySelector('#other-agent-links')!.replaceChildren(...otherAgentLinks(product).map(agent => {
      const link = document.createElement('a');
      link.href = agent.url;
      link.target = '_blank';
      link.rel = 'noopener sponsored';
      const logo = new Image(); logo.src = agent.logo; logo.alt = ''; logo.width = logo.height = 20; logo.loading = 'lazy';
      const label = document.createElement('span'); label.textContent = agent.label; link.append(logo, label); link.setAttribute('data-i18n-ignore', '');
      return link;
    }));
    document.querySelector('#related-products')!.replaceChildren(...products.filter(item => item.category === product.category && item.weidianId !== id).slice(0,4).map(item => productCard(item)));
    const buyButton = document.querySelector<HTMLAnchorElement>('#buy-product')!;
    buyButton.dataset.agentPurchaseId = product.weidianId; buyButton.dataset.sourceUrl = sourceUrl(product);
    document.dispatchEvent(new Event('catalog-agent-changed'));
    setupPhotos(product, [product.image]);
    status.hidden = true;
    container.hidden = false;
    galleryPhotos(product).then(photos => setupPhotos(product, photos)).catch(() => { /* Keep the catalogue cover available. */ });
    const qcStatus = document.querySelector<HTMLElement>('#item-qc-status')!;
    const qcGallery = document.querySelector<HTMLElement>('#item-qc-gallery')!;
    void lookupQc(id, qcStatus, qcGallery).then(async () => {
      if (qcGallery.children.length) return;
      const photos = await galleryPhotos(product).catch(() => [product.image]);
      qcStatus.textContent += ' Showing the listing gallery photos for reference.';
      qcGallery.replaceChildren(...photos.slice(0,6).map((url,index) => {
        const link = document.createElement('a'); link.href = url; link.target = '_blank'; link.rel = 'noopener';
        const image = new Image(); image.src = url; image.alt = 'Listing photo ' + (index + 1); image.width = image.height = 240; image.loading = 'lazy';
        link.append(image); return link;
      }));
    });
  }
  show().catch(() => { status.textContent = 'The product could not load. Refresh to try again.'; });
</script>
