---
import { readFileSync } from 'node:fs';
import ProductDetail from '../../components/ProductDetail.astro';
import type { Product } from '../../lib/catalog';
import indexedProductIds from '../../lib/indexed-products.json';

export function getStaticPaths() {
  const products = JSON.parse(readFileSync('public/data/catalog.json', 'utf8')) as Product[];
  return indexedProductIds.map(id => {
    const product = products.find(entry => entry.weidianId === id);
    if (!product) throw new Error('Indexed product missing from catalog: ' + id);
    return { params: { id }, props: { product } };
  });
}
---
<ProductDetail product={Astro.props.product} />
