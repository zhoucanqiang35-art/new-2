---
import allSteps from '../buying-steps.json';
const { compact = false } = Astro.props;
const steps=compact?[allSteps[0],allSteps[2],allSteps[5]]:allSteps;
---
{compact?<div class="guide-preview-grid">{steps.map(s=><a class="guide-preview-card" href="/guides/how-to-buy/"><div class="guide-preview-image"><img src={s.image} alt={s.alt} loading="lazy"/><span>{s.number}</span></div><div><h3>{s.title}</h3><p>{s.body}</p><span class="text-link">See the real steps →</span></div></a>)}</div>:<div class="buying-tutorial">{steps.map(s=><article class="buying-step" id={s.id}><div class="buying-step-copy"><span class="step-number">{s.number}</span><h2>{s.title}</h2><p>{s.body}</p><a class="button" href={s.url} target={s.url.startsWith('https')?'_blank':undefined} rel={s.url.startsWith('https')?'noopener':undefined}>{s.cta} →</a></div><figure><button type="button" class="tutorial-preview" data-preview-src={s.image} aria-label={'Enlarge screenshot for '+s.title}><img src={s.image} alt={s.alt} loading="lazy"/></button><figcaption>{s.caption} · Click to enlarge</figcaption></figure></article>)}</div>}
