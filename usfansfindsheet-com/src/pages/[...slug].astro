---
import Layout from '../layouts/Layout.astro';
import BuyingSteps from '../components/BuyingSteps.astro';
import usdRate from '../../data/usd-rate.json';
import catalog from '../all-categories.json';
import guides from '../category-guides.json';
import FaqItem from '../components/FaqItem.astro';
import faqGroups from '../faq-content.json';
export function getStaticPaths() {
 return ['spreadsheet','categories','seo','guides/how-to-buy','faq','about','search','image-search','qc','product',...catalog.map(c=>'categories/'+c.slug)].map(slug=>({params:{slug}}));
}
const slug=Astro.params.slug;
const category=catalog.find(c=>slug==='categories/'+c.slug);
const categoryGuide = guides.find(guide => guide.slug === category?.slug);
const pages={
 spreadsheet:['THE DISCOVERY DIRECTORY','USFans spreadsheet','Explore the category edit, learn the buying process, and find the right next step for your USFans research.'],
 categories:['THE CATEGORY GUIDEBOOK','USFans category guides.','Understand what to compare before you buy: fit, measurements, product options, inspection photos and parcel planning across all 11 categories.'],
 seo:['USFANS SPREADSHEET · FINDS · QC','Your USFans discovery guide.','Start with the USFans spreadsheet, explore product categories, and understand the path from finding an item to reviewing it on USFans.'],
 'guides/how-to-buy':['THE BEGINNER’S GUIDE','How to buy on USFans.','A practical starting point for turning a product find into an order. Confirm every detail on USFans before you pay.'],
 faq:['USFANS HELP & BUYING QUESTIONS','USFans FAQ: QC, shipping & buying.','Detailed answers about the USFans spreadsheet, QC photos, shipping costs, warehouse storage, payments and returns, with links to official platform guidance.'],
 about:['ABOUT USFANS FINDSHEET','Independent by design.','USFans Findsheet is an independent product-discovery website being built for usfansfindsheet.com.'],
 search:['PRODUCT SEARCH','Search the USFans spreadsheet.','Search all 8,911 products by name, category, product ID or image filename.'],
 'image-search':['VISUAL DISCOVERY','Find it with a photo.','Find visually similar product photos across the complete FindSpreadsheet catalog used by this subsite.'],
 qc:['QUALITY-CONTROL RESEARCH','USFans QC photos.','A dedicated starting point for researching QC photos matched to the exact product listing.']
};
pages.product=['PRODUCT DETAILS','Review your product find.','Check the source listing and continue to the matching product on USFans.'];
const [eyebrow,heading,description]=category?['THE CATEGORY EDIT','USFans '+category.name+' spreadsheet','Explore '+category.name.toLowerCase()+' finds and continue your product research in the source catalog.']:pages[slug];
const title=slug==='seo'?'USFans Spreadsheet, Finds & QC Guide | USFans Findsheet':heading.replace(/\.$/,'')+' | USFans Findsheet';
const cards=[['USFans spreadsheet','Explore the discovery directory and category edit.','/spreadsheet/'],['USFans finds by category','Browse sneakers, hoodies, T-shirts, and jackets.','/categories/'],['How to buy on USFans','Understand the steps before placing an order.','/guides/how-to-buy/']];
---
<Layout title={title} description={description}>
<main><section class:list={["page-intro", {"product-intro":slug==='product'}]}><div class="breadcrumb"><a href="/">Home</a> / {category?category.name:slug==='seo'?'SEO':heading.replace(/\.$/,'')}</div><div class="eyebrow">{eyebrow}</div><h1>{heading}</h1><p>{description}</p></section>
<section class="page-content">
{slug==='spreadsheet'&&<><div class="catalog-toolbar"><strong>All products</strong><span>11 categories · one shared main-site catalog</span></div><div class="all-category-grid">{catalog.map(c=><a class="category-tile" href={'/categories/'+c.slug+'/'}><span>{c.name}</span><small>{c.count.toLocaleString()} products in source catalog</small><b>Browse products →</b></a>)}</div><p class="source-note">All product cards show USD estimates. Official quotes are used where available; other catalog reference prices use the USFans conversion rate ({usdRate.cnyToUsd} USD per CNY, checked {usdRate.checkedAt.slice(0,10)}). Shipping is excluded. Choose a category to browse its products.</p></>}
{slug==='categories'&&<><div class="notice">Looking for products? Open <a href="/spreadsheet/">the spreadsheet →</a>. This page explains how to research each category before buying.</div><div class="guide-cards">{guides.map(g=><article class="guide-card"><h2>{g.name}</h2><p>{g.intro}</p><ul>{g.checks.map(check=><li>{check}</li>)}</ul><a href={'/categories/'+g.slug+'/'}>Browse {g.name.toLowerCase()} products →</a></article>)}</div><div class="preview-tools"><a class="register" href="/faq/">QC, shipping & returns FAQ →</a><a class="register" href="/guides/how-to-buy/">How to buy on USFans →</a></div></>}
{category&&<>{categoryGuide && <section class="notice" aria-label="Before you order"><h2>Before you order</h2><ul>{categoryGuide.checks.map(check => <li>{check}</li>)}</ul><a href="/qc/">Check warehouse photos</a></section>}<nav class="category-tabs" aria-label="Product categories"><a href="/spreadsheet/">All products</a>{catalog.map(c=><a aria-current={c.slug===category.slug?'page':undefined} href={'/categories/'+c.slug+'/'}>{c.name}</a>)}</nav><div set:html={'<!--CATALOG:'+category.slug+'-->'}/></>}
{slug==='product'&&<div set:html={'<!--PRODUCT-->'}/>}
{slug==='seo'&&<><div class="page-links">{cards.map(([name,copy,url])=><a class="page-link" href={url}><h3>{name}</h3><p>{copy}</p><span>Explore the guide →</span></a>)}</div><div class="reading"><h2>What is a USFans spreadsheet?</h2><p>A USFans spreadsheet helps you discover product listings and organize your shopping research. USFans Findsheet brings category browsing and practical buying guidance together, with dedicated pages that you can open and share directly.</p><h2>Explore USFans finds by category</h2><p>Start with the item type you want, then check the original listing for its exact details. A category page is a discovery starting point; final pricing, options, availability and order decisions belong on the purchase platform.</p><table class="keyword-table"><thead><tr><th>Looking for</th><th>Start here</th></tr></thead><tbody>{catalog.map(c=><tr><td>USFans {c.name.toLowerCase()} spreadsheet</td><td><a href={'/categories/'+c.slug+'/'}>{c.name} finds →</a></td></tr>)}</tbody></table><h2>USFans QC photos and image search</h2><p>QC research should match the exact source and product ID. The dedicated tools below explain their current availability. They will use the main FindSpreadsheet services once those interfaces are connected.</p><div class="preview-tools"><a class="register" href="/qc/">QC photo guide →</a><a class="register" href="/image-search/">Image search →</a><a class="register" href="/search/">Product search →</a></div><h2>How to start buying on USFans</h2><p>Discover a product, review its original listing, and open it on USFans. Confirm options, the current price and any additional charges before you order. Use the buying guide for a step-by-step starting point.</p><a class="button" href="/guides/how-to-buy/">Read the USFans buying guide →</a><div class="notice">This preview is excluded from search-engine indexing. USFans Findsheet is independent and is not the official USFans website.</div></div></>}
{slug==='guides/how-to-buy'&&<><div class="tutorial-intro"><strong>7 steps · real screens · from Findsheet to USFans</strong><p>Follow the sequence below. Screenshots combine our live Findsheet and USFans pages with images published in the official USFans beginner guide. Account-only payment, warehouse and shipping examples are attributed to the official tutorial.</p><a href="https://usfans.com/beginner-guide" target="_blank" rel="noopener">Official source: USFans Beginner’s Guide →</a></div><BuyingSteps/><div class="tutorial-ending"><h2>Ready to find your first item?</h2><div class="preview-tools"><a class="button" href="/spreadsheet/">Browse all 11 categories →</a><a class="register" href="/faq/">QC, payment & shipping FAQ →</a></div></div><script src="/product-ui.js?v=official-carousel-20261116" defer></script></>}
{slug==='faq'&&<><p class="faq-updated">Researched and reviewed: 16 November 2026 · Official rules can change; check the linked USFans page and your order before acting.</p><div class="faq-page"><nav class="faq-topic-nav" aria-label="FAQ topics">{faqGroups.map(g=><a href={'#'+g.id}>{g.name}</a>)}</nav><div>{faqGroups.map(g=><section class="faq-section" id={g.id}><h2>{g.name}</h2>{g.items.map(item => <FaqItem item={item} expanded />)}</section>)}<div class="preview-tools"><a class="button" href="/spreadsheet/">Browse the USFans spreadsheet →</a><a class="register" href="/categories/">Read category guides →</a></div></div></div></>}
{slug==='about'&&<div class="reading"><h2>A focused discovery experience</h2><p>The intended domain is usfansfindsheet.com. This public preview demonstrates the visual design, independent page navigation, categories and introductory guidance.</p><h2>Shared data, clearly stated availability</h2><p>Product data, search, image search, QC and sorting are planned to use the main FindSpreadsheet project. Category listings and pagination are read from its public catalog at request time. The remaining search and QC interfaces are pending; this preview does not create a second product database.</p><h2>Branding and external destinations</h2><p>The USFans icon and favicon are sourced from the official website. Their use does not imply an affiliation. Source catalog links and USFans account or purchase links are labeled external destinations.</p><a class="button" href="/spreadsheet/">Explore the spreadsheet →</a></div>}
{slug==='search'&&<div set:html={'<!--SEARCH-->'}/>}
{slug==='image-search'&&<><div class="upload-area" id="image-drop-zone"><div><div class="eyebrow">VISUAL SEARCH · FULL PRODUCT CATALOG</div><h2>Have a photo? Start here.</h2><p>Choose or drop an image to find visually similar product photos across every category. Your photo stays in this browser; it is not uploaded or saved on our server.</p><div class="upload-actions"><label class="button" for="catalog-image-file">Choose a photo →</label><input class="sr-only" id="catalog-image-file" type="file" accept="image/jpeg,image/png,image/webp,image/avif"/><button class="register" type="button" id="clear-image-search" hidden>Clear</button></div><p class="source-note">JPG, PNG, WebP or AVIF · up to 10 MB. A clear, cropped product photo works best.</p></div><div class="upload-preview" id="image-query-preview"><span>Your reference photo appears here</span></div></div><p id="image-search-status" role="status" aria-live="polite">Choose a photo to search the catalog.</p><div class="image-search-summary" id="image-search-coverage"></div><div id="image-search-results"></div><script src="/image-search.js?v=full-site-5" defer></script></>}
{slug==='qc'&&<div class="reading"><h2>Research the exact listing</h2><p>Product pages show public QC from USFans and the main FindSpreadsheet service in separate labeled sections when those sources have images. A seller product image is not a QC photo. Your own order’s warehouse images remain in your USFans account.</p><div class="preview-tools"><a class="button" href="/search/">Find a product →</a><a class="register" href="/image-search/">Search by photo →</a><a class="register" href="/faq/">QC and shipping FAQ →</a></div></div>}
</section></main>
</Layout>

<style>
  #image-search-coverage ul { margin: 0.5rem 0 0; padding-inline-start: 1.3rem; }
</style>
