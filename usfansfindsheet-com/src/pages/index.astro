---
import '../styles/home-mobile.css';
import Layout from '../layouts/Layout.astro';
import FaqItem from '../components/FaqItem.astro';
import faqGroups from '../faq-content.json';
import BuyingSteps from '../components/BuyingSteps.astro';
import snapshot from '../../data/catalog-snapshot.json';
import quotes from '../../data/usfans-purchase-images.json';
import rate from '../../data/usd-rate.json';
import {priceFor,dollarLabel} from '../lib/pricing.mjs';
import catalog from '../catalog.json';
const allProducts=Object.values(snapshot.pages).flatMap(v=>v.products);
const homeImages={"5985": "/images/home-edit-2/5985-b19d3bae8c.jpg", "363": "/images/home-edit-2/363-f01750f4fe.webp", "8324": "/images/home-edit-2/8324-48f5dad8bc.webp", "8338": "/images/home-edit-2/8338-640-4bf04bccdc.webp", "8330": "/images/home-edit-2/8330-1bbb09db2b.webp", "4370": "/images/home-unique/4370-522c1d53c9.jpg", "8274": "/images/home-unique/8274-fafb20386e.webp", "5977": "/images/home-unique/5977-356919a3e3.jpg", "8627": "/images/home-unique/8627-640-d5e94c52c9.webp", "7598": "/images/home-unique/7598-13c2e926f6.jpg", "8300": "/images/home-unique/8300-640-ccea070765.webp", "8659": "/images/home-unique/8659-640-4da65f8b99.webp"};
const heroTee=allProducts.find(p=>p.id==='8330');
const heroSlides=allProducts.find(p=>p.id==='5985');
const heroTeeImage=homeImages[heroTee.id];
const heroSlidesImage=homeImages[heroSlides.id];
const homeCategories=catalog.map((c,i)=>({...c,image:homeImages[['4370','363','8324','8338'][i]],title:allProducts.find(p=>p.id===['4370','363','8324','8338'][i]).title}));
const homeFaq = [
  ['getting-started', 0],
  ['getting-started', 1],
  ['qc-photos', 0],
  ['shipping', 1],
  ['payment-returns', 3],
  ['using-findsheet', 1],
].map(([group, index]) => faqGroups.find(topic => topic.id === group).items[index]);
const featured=["5977", "8627", "7598", "8300", "8659", "8706", "8941", "9014"].map(id=>allProducts.find(p=>p.id===id));
---
<Layout><main class="storefront">
<div class="shop-strip"><span>Independent USFans discovery</span><span>Find your style. Build your next haul.</span><a href="/guides/how-to-buy/">First time here? Read the guide →</a></div>
<section class="shop-hero"><div class="shop-hero-copy"><div class="eyebrow">THE USFANS FINDS EDIT</div><h1>Good finds.<br/><span class="hero-line-accent">One spreadsheet.</span></h1><p>Your shortcut to sneakers, streetwear and everyday essentials. Browse the edit, compare your options, and continue on USFans.</p><div class="hero-actions"><a class="button" href="/spreadsheet/">Explore the spreadsheet <span>→</span></a><a class="text-link" href="/guides/how-to-buy/">How it works →</a></div><div class="hero-categories"><a href="/categories/shoes/">Sneakers</a><a href="/categories/hoodies-sweaters/">Hoodies</a><a href="/categories/t-shirts/">T-shirts</a><a href="/categories/jackets/">Jackets</a></div></div><div class="hero-collage"><a href="/categories/jersey/" class="collage-main"><img src={heroTeeImage} alt="Football training set from the USFans product catalog" width="480" height="480" fetchpriority="high" decoding="async"/><span>THE TRAINING EDIT <b>Explore jerseys →</b></span></a><a href="/categories/shoes/" class="collage-small"><img src={heroSlidesImage} alt="Blue massage clogs from the USFans product catalog" width="480" height="480" decoding="async"/><span>OFF-DUTY FAVORITES <b>Discover footwear →</b></span></a><div class="collage-stamp">FIND<br/>YOUR<br/><em>NEXT.</em></div></div></section>
<section class="quick-links"><a href="/spreadsheet/"><span class="quick-icon">▦</span><div><b>Browse the spreadsheet</b><small>Start with the category edit</small></div><span>→</span></a><a href="/qc/"><span class="quick-icon">◎</span><div><b>QC photo guide</b><small>Know what to check before shipping</small></div><span>→</span></a><a href="/guides/how-to-buy/"><span class="quick-icon">→</span><div><b>Your first USFans order</b><small>A straightforward buying guide</small></div><span>→</span></a></section>
<section class="section category-section"><div class="section-head"><div><div class="eyebrow">BROWSE YOUR WAY</div><h2>What’s your next find?</h2></div><a class="text-link" href="/spreadsheet/">All categories →</a></div><div class="categories">{homeCategories.map((c,i)=><a class="category" href={'/categories/'+c.slug+'/'}><div class="category-image"><img src={c.image} alt={c.title} loading="lazy"/><span class="category-pill">{['THE ROTATION','THE LAYERS','THE ESSENTIALS','THE OUTERWEAR'][i]}</span><span class="round-arrow">→</span></div><div class="category-title"><h3>{c.name}</h3><span>Discover the edit →</span></div></a>)}</div><p class="source-note">Category imagery from the public FindSpreadsheet catalog. Browse all 11 categories in the spreadsheet.</p></section>
<section class="section home-products" aria-labelledby="home-products-heading"><div class="section-head"><div><div class="eyebrow">Product price estimates</div><h2 id="home-products-heading">Start with a few good finds.</h2></div><a class="text-link" href="/spreadsheet/">Browse every category →</a></div><div class="products-grid" role="region" aria-labelledby="home-products-heading">{featured.map(p=>{const price=priceFor(p,quotes,rate);return <article class="listing-card"><a href={'/product/?source='+encodeURIComponent(p.source)}><div class="listing-image"><img src={homeImages[p.id]||new URL(p.image,'https://findspreadsheet.com').href} alt={p.title} loading="lazy"/></div><h3 data-product-title data-original-title={p.title} data-product-category={p.source.split('/')[1]} data-product-id={p.id}>{p.title}</h3><div class="card-price"><span data-price-usd={price?.amount} data-price-from={String(!!price?.from)} data-price-cny={price?.origin==='Converted USD estimate'?Number(p.sourcePrice):undefined}>{dollarLabel(price)}</span></div><small class="card-price-note">{price.origin}</small><span class="listing-action">View product →</span></a></article>})}</div><p class="source-note">Prices exclude shipping. Final payment is confirmed on USFans.</p></section>
<section class="editorial"><div class="editorial-image"><img src={homeImages['8274']} alt="Pale yellow hooded zip jacket from the product catalog" loading="lazy"/><span>THE OUTERWEAR EDIT / 01</span></div><div class="editorial-copy"><div class="eyebrow">A NEW LAYER TO YOUR ROTATION</div><h2>Find something<br/>worth making<br/><em>room for.</em></h2><p>From everyday basics to your next statement layer, start with a category and make the edit your own.</p><a class="button" href="/categories/jackets/">Explore jackets →</a></div></section>
<section class="section"><div class="section-head"><div><div class="eyebrow">THE DISCOVERY TOOLKIT</div><h2>A clearer path to your next haul.</h2></div><span class="subtle-label">Search across the full catalog</span></div><div class="page-links toolkit">{[['01','Product search','Search all 8,911 listings by name, category or product ID.','search'],['02','Image search','Find visually similar catalog photos with your own image.','image-search'],['03','QC photos','Understand how to check the exact listing.','qc']].map(([num,title,copy,path])=><a class="page-link" href={'/'+path+'/'}><span class="tool-number">{num}</span><h3>{title}</h3><p>{copy}</p><div class="tool-bottom"><small>{path==='qc'?'Photo guide':'Full catalog'}</small><b>→</b></div></a>)}</div></section>
<section class="section home-buying-guide"><div class="section-head"><div><div class="eyebrow">HOW TO BUY ON USFANS</div><h2>Real screens. A clear next step.</h2></div><a class="text-link" href="/guides/how-to-buy/">See all 7 steps →</a></div><BuyingSteps compact/><div class="guide-preview-footer"><p>Start here, continue on USFans, then review your warehouse photos and shipping quote.</p><a class="button" href="/guides/how-to-buy/">Open the illustrated buying guide →</a></div></section>
<section class="section home-faq" id="faq" aria-labelledby="home-faq-heading">
  <div class="section-head">
    <h2 id="home-faq-heading">FAQ</h2>
    <a class="text-link" href="/faq/">Frequently asked questions →</a>
  </div>
  <div class="home-faq-items">
    {homeFaq.map((item, index) => <FaqItem item={item} expanded={index === 0} />)}
  </div>
</section>
<details class="section home-seo" open><summary><span class="eyebrow">USFANS SPREADSHEET</span><h2>Less time looking.<br/>More time discovering.</h2></summary><div><p>USFans Findsheet is an independent starting point for product discovery. Explore sneakers, hoodies, T-shirts and jackets, then review the original listing before continuing on USFans.</p><p>This preview introduces the experience. Category product listings and pagination use the main catalog, with a dated snapshot when live access is unavailable. Search spans the full catalog; upload a photo to find visually similar catalog images. Public QC sources are shown separately on product pages.</p><div class="preview-tools"><a class="text-link" href="/seo/">Explore the USFans guide →</a></div></div></details>
<script is:inline>
  if (matchMedia('(max-width: 600px) and (max-height: 760px)').matches) {
    document.querySelector('#faq .faq-item[open]')?.removeAttribute('open');
    document.querySelector('.home-seo')?.removeAttribute('open');
  }
</script>
</main></Layout>

<style>
  .home-faq-items { max-width: 860px; }
  .home-faq .section-head { flex-wrap: wrap; gap: 12px; }
</style>
