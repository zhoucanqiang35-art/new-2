---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProductCard from '../components/ProductCard.astro';
import { groups } from '../data/faq';
import { categories, count, items } from '../lib/site';

const collections = [
  { name: 'Shoes', slug: 'shoes', products: ['7857111044','7854144457','7854233843'] },
  { name: 'Hoodies & sweaters', slug: 'hoodies-sweaters', products: ['7869064925','7321418559','7403416956'] },
  { name: 'Accessories', slug: 'accessories', products: ['7869696051','7869686129','7872654808'] },
];
---
<Base title="VigorBuy Spreadsheet | Product Finds & QC Photos" description="Browse Weidian products in the VigorBuy spreadsheet. Search by item, photo, or category, and see available warehouse QC from Findspreadsheet." active="/">
  <section class="wrap showroom">
    <div class="showroom-heading">
      <h1>VigorBuy<span> Spreadsheet</span></h1>
      <p>Explore {count.toLocaleString('en-US')} Weidian finds. Compare photos and available QC before you order.</p>
    </div>

    <div class="shop-tools">
      <form class="search-home" action="/spreadsheet/">
        <label for="home-query" class="sr-only">Search the spreadsheet</label>
        <Icon name="search" />
        <input id="home-query" name="q" data-t-placeholder="searchHint" placeholder="Search a product, item ID, or link" />
        <button class="button primary" type="submit" data-t="search">Search</button>
      </form>
      <a class="quick-tool" href="/image-search/"><Icon name="image" /> <span data-t="image">Search by image</span></a>
    </div>
  </section>

  <section class="browse-band" aria-labelledby="browse-title">
    <div class="wrap browse-inner">
      <div class="section-head"><h2 id="browse-title" data-t="categories">Shop by category</h2><a class="text-link" href="/categories/" data-t="allCategories">All categories</a></div>
      <nav class="category-tiles" aria-label="Product categories">
        {categories.map(({ id, slug, name }) => (
          <a href={'/categories/' + slug + '/'}><Icon name={id} /><span data-t={'cat:' + id}>{name}</span></a>
        ))}
      </nav>
    </div>
  </section>

  <div class="wrap edit-feed">
    {collections.map(({ name, slug, products }) => (
      <section class="edit-collection" aria-labelledby={slug + '-title'}>
        <div class="edit-caption"><h2 id={slug + '-title'} data-t={'cat:' + slug}>{name}</h2><a class="button quiet" href={'/categories/' + slug + '/'}>View category</a></div>
        <div class="product-grid edit-products">{products.map((id) => <ProductCard item={items[id]} />)}</div>
      </section>
    ))}
  </div>

  <div class="wrap help-strip">
    <section aria-labelledby="home-guide-title">
      <h2 id="home-guide-title" data-t="guide">How to buy on VigorBuy</h2>
      <ol><li>Find a product and review its photos.</li><li>Open the item on VigorBuy to confirm the variant and price.</li><li>Review your warehouse inspection before arranging shipping.</li></ol>
      <a class="button quiet" href="/guides/how-to-buy/">Read the buying guide</a>
    </section>
    <section class="faq home-faq" id="faq" aria-labelledby="home-faq-title">
      <div class="section-head">
        <h2 id="home-faq-title" data-t="faq">FAQ</h2>
        <a class="text-link" href="/faq/">Full FAQ</a>
      </div>
      {groups.map((group, index) => (
        <details class="faq-topic" name="home-faq-topics" open={index === 0}>
          <summary>{group.title}</summary>
          <div class="faq-questions">
            {group.entries.map(([question, answer]) => (
              <details name={'home-faq-' + group.id}>
                <summary>{question}</summary>
                <p>{answer}</p>
              </details>
            ))}
          </div>
        </details>
      ))}
    </section>
  </div>
</Base>
