---
import Base from '../../layouts/Base.astro';
import ListingDetail from '../../components/ListingDetail.astro';
import { getListingItems } from '../../lib/catalog-build';
import { getListingPhotos } from '../../lib/listing-photos';
export function getStaticPaths() {
  return getListingItems().map((item) => ({ params: { id: item.id }, props: { item } }));
}
const { item } = Astro.props;
const photos = getListingPhotos(item);
---
<Base title={item.name + ' | VigorBuy Findsheets'} description={'View product photos and the VigorBuy purchase link for ' + item.name + '.'} active="/spreadsheet/">
  {photos.gallery[0] && <link slot="head" rel="preload" as="image" href={photos.gallery[0]} fetchpriority="high" />}
  <ListingDetail item={item} photos={photos} />
</Base>
